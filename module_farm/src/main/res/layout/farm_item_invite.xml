<?xml version="1.0" encoding="utf-8"?>
<!-- F07 邀请三行项：图标底块 → 手机号（打码）/ 角色 · 负责栏舍 / 邀请日期 · 有效期或处理情况 → 状态标签（+“重新邀请”） -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.Zmt.Card.ListItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/base_page_margin"
    android:layout_marginEnd="@dimen/base_page_margin">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="90dp"
        android:orientation="horizontal"
        android:paddingStart="@dimen/base_space_4"
        android:paddingTop="@dimen/base_space_3"
        android:paddingEnd="@dimen/base_space_4"
        android:paddingBottom="@dimen/base_space_3">

        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/farm_bg_rounded_12">

            <ImageView
                android:id="@+id/invite_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                app:tint="?attr/colorOnSurfaceVariant" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/base_space_4"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/invite_phone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:textAppearance="@style/TextAppearance.Zmt.TitleMedium.Number"
                android:textColor="?attr/colorOnSurface" />

            <TextView
                android:id="@+id/invite_line2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:textAppearance="@style/TextAppearance.Zmt.BodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <TextView
                android:id="@+id/invite_line3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:textAppearance="@style/TextAppearance.Zmt.BodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/base_space_3"
            android:gravity="end"
            android:orientation="vertical">

            <com.zhimu.slmp.base.widget.StatusTagView
                android:id="@+id/invite_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/invite_reinvite"
                style="@style/Widget.Zmt.Button.Tonal.Small"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/base_space_2"
                android:text="@string/farm_members_reinvite"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
