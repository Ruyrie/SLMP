<?xml version="1.0" encoding="utf-8"?>
<!-- F10 候选场长：72 dp，40 dp 头像 + 姓名 / “场长 · 手机号” + 右侧单选按钮，整项可点 -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Widget.Zmt.Card.ListItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/base_space_4"
        android:paddingEnd="@dimen/base_space_2">

        <com.zhimu.slmp.base.widget.AvatarView
            android:id="@+id/candidate_avatar"
            android:layout_width="40dp"
            android:layout_height="40dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/base_space_4"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/candidate_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Zmt.TitleMedium"
                android:textColor="?attr/colorOnSurface" />

            <TextView
                android:id="@+id/candidate_sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Zmt.BodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>

        <com.google.android.material.radiobutton.MaterialRadioButton
            android:id="@+id/candidate_radio"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:clickable="false"
            android:focusable="false"
            android:importantForAccessibility="no" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
