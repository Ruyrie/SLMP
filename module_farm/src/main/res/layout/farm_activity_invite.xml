<?xml version="1.0" encoding="utf-8"?>
<!-- F08 邀请成员（UI 文档 F08）：对方手机号（+86，3-4-4）、角色单选、负责栏舍多选 Chip（只在员工时显示）、有效期横幅、底部“发送邀请” -->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

        <variable
            name="vm"
            type="com.zhimu.slmp.farm.ui.invite.InviteMemberViewModel" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/colorSurface"
        android:orientation="vertical">

        <include
            android:id="@+id/top_bar"
            layout="@layout/base_include_top_app_bar" />

        <com.zhimu.slmp.base.widget.StateLayout
            android:id="@+id/state"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            app:stateErrorTitle="栏舍加载失败">

            <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <LinearLayout
                    android:id="@+id/content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:animateLayoutChanges="true"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/base_page_margin"
                    android:paddingTop="@dimen/base_space_2"
                    android:paddingEnd="@dimen/base_page_margin"
                    android:paddingBottom="@dimen/base_space_6">

                    <com.zhimu.slmp.base.widget.ZmtTextInputLayout
                        android:id="@+id/til_phone"
                        style="@style/Widget.Zmt.TextInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/farm_invite_phone"
                        app:helperText="@string/farm_invite_phone_helper"
                        app:helperTextEnabled="true"
                        app:prefixText="+86">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_phone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:enabled="@{!vm.submitting}"
                            android:inputType="phone"
                            android:maxLength="13"
                            android:singleLine="true"
                            android:text="@={vm.phone}" />
                    </com.zhimu.slmp.base.widget.ZmtTextInputLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/base_space_5"
                        android:text="@string/farm_invite_role"
                        android:textAppearance="@style/TextAppearance.Zmt.TitleMedium"
                        android:textColor="?attr/colorOnSurface" />

                    <include
                        android:id="@+id/roles"
                        layout="@layout/farm_view_role_options"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/base_space_3" />

                    <LinearLayout
                        android:id="@+id/pens_section"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/base_space_5"
                            android:text="@string/farm_invite_pens"
                            android:textAppearance="@style/TextAppearance.Zmt.TitleMedium"
                            android:textColor="?attr/colorOnSurface" />

                        <TextView
                            android:id="@+id/pen_hint"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/base_space_1"
                            android:text="@{vm.penHint}"
                            android:textAppearance="@style/TextAppearance.Zmt.BodySmall"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            app:visibleIf="@{!vm.noPens}" />

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/pen_chips"
                            style="@style/Widget.Zmt.ChipGroup"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/base_space_3" />

                        <TextView
                            android:id="@+id/no_pens"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/base_space_2"
                            android:textAppearance="@style/TextAppearance.Zmt.BodyMedium"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            app:visibleIf="@{vm.noPens}" />
                    </LinearLayout>

                    <com.zhimu.slmp.base.widget.NoticeView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/base_space_5"
                        app:noticeIcon="@drawable/ic_schedule"
                        app:noticeText="@string/farm_invite_expire_notice" />
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>
        </com.zhimu.slmp.base.widget.StateLayout>

        <com.zhimu.slmp.base.widget.BottomActionBar
            android:id="@+id/action_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:barPrimaryIcon="@drawable/ic_send"
            app:barPrimaryText="@string/farm_invite_send" />
    </LinearLayout>
</layout>
