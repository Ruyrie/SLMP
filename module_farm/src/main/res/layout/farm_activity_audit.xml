<?xml version="1.0" encoding="utf-8"?>
<!-- F03 审核结果（UI 文档 F03）：状态卡、驳回原因卡、功能受限横幅、注册信息分组、审核记录、底部“修改并重新提交” -->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/colorSurface"
        android:orientation="vertical">

        <include
            android:id="@+id/top_bar"
            layout="@layout/base_include_top_app_bar" />

        <com.zhimu.slmp.base.widget.StateLayout
            android:id="@+id/state"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            app:stateErrorTitle="审核结果加载失败"
            app:stateSkeletonLayout="@layout/base_skeleton_detail">

            <androidx.core.widget.NestedScrollView
                android:id="@+id/scroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/base_page_margin"
                    android:paddingTop="@dimen/base_space_1"
                    android:paddingEnd="@dimen/base_page_margin"
                    android:paddingBottom="@dimen/base_space_6">

                    <!-- 状态卡 -->
                    <com.google.android.material.card.MaterialCardView
                        style="@style/Widget.Zmt.Card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:minHeight="84dp"
                            android:orientation="horizontal"
                            android:padding="@dimen/base_space_4">

                            <FrameLayout
                                android:id="@+id/status_icon_block"
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:background="@drawable/farm_bg_rounded_16">

                                <ImageView
                                    android:id="@+id/status_icon"
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:layout_gravity="center"
                                    android:importantForAccessibility="no"
                                    android:src="@drawable/ic_domain" />
                            </FrameLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/base_space_4"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <TextView
                                        android:id="@+id/farm_name"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:ellipsize="end"
                                        android:singleLine="true"
                                        android:textAppearance="@style/TextAppearance.Zmt.TitleLarge"
                                        android:textColor="?attr/colorOnSurface" />

                                    <com.zhimu.slmp.base.widget.StatusTagView
                                        android:id="@+id/status_tag"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="@dimen/base_space_2" />
                                </LinearLayout>

                                <TextView
                                    android:id="@+id/time_line"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/base_space_1"
                                    android:textAppearance="@style/TextAppearance.Zmt.BodyMedium"
                                    android:textColor="?attr/colorOnSurfaceVariant" />
                            </LinearLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- 驳回原因卡 -->
                    <LinearLayout
                        android:id="@+id/reject_card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/base_space_3"
                        android:background="@drawable/farm_bg_rounded_16"
                        android:backgroundTint="?attr/colorErrorContainer"
                        android:orientation="horizontal"
                        android:padding="@dimen/base_space_4"
                        android:visibility="gone">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_rule"
                            app:tint="?attr/colorOnErrorContainer" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/base_space_4"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/farm_audit_reject_reason"
                                android:textAppearance="@style/TextAppearance.Zmt.TitleSmall"
                                android:textColor="?attr/colorOnErrorContainer" />

                            <TextView
                                android:id="@+id/reject_reason"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/base_space_1"
                                android:textAppearance="@style/TextAppearance.Zmt.BodyMedium"
                                android:textColor="?attr/colorOnErrorContainer" />
                        </LinearLayout>
                    </LinearLayout>

                    <com.zhimu.slmp.base.widget.NoticeView
                        android:id="@+id/restrict_notice"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/base_space_3"
                        android:visibility="gone"
                        app:noticeIcon="@drawable/ic_lock" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/base_space_5"
                        android:text="@string/farm_audit_registration"
                        android:textAppearance="@style/TextAppearance.Zmt.TitleSmall"
                        android:textColor="?attr/colorPrimary" />

                    <com.zhimu.slmp.base.widget.GroupedListLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/base_space_2">

                        <com.zhimu.slmp.base.widget.ListRowView
                            android:id="@+id/row_name"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:rowTitle="@string/farm_row_name" />

                        <com.zhimu.slmp.base.widget.ListRowView
                            android:id="@+id/row_address"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:rowTitle="@string/farm_row_address" />

                        <com.zhimu.slmp.base.widget.ListRowView
                            android:id="@+id/row_scale"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:rowTitle="@string/farm_row_scale" />

                        <com.zhimu.slmp.base.widget.ListRowView
                            android:id="@+id/row_category"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:rowTitle="@string/farm_row_category" />

                        <com.zhimu.slmp.base.widget.ListRowView
                            android:id="@+id/row_contact"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:rowTitle="@string/farm_row_contact" />

                        <com.zhimu.slmp.base.widget.ListRowView
                            android:id="@+id/row_qual"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:rowTitle="@string/farm_row_qual" />
                    </com.zhimu.slmp.base.widget.GroupedListLayout>

                    <TextView
                        android:id="@+id/records_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/base_space_5"
                        android:text="@string/farm_audit_records"
                        android:textAppearance="@style/TextAppearance.Zmt.TitleSmall"
                        android:textColor="?attr/colorPrimary" />

                    <com.zhimu.slmp.base.widget.GroupedListLayout
                        android:id="@+id/records"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/base_space_2" />
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>
        </com.zhimu.slmp.base.widget.StateLayout>

        <com.zhimu.slmp.base.widget.BottomActionBar
            android:id="@+id/action_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />
    </LinearLayout>
</layout>
