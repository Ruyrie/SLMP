<?xml version="1.0" encoding="utf-8"?>
<!-- F09 成员详情（UI 文档 F09）：头像区、手机号卡片（拨号）、角色与负责栏舍（修改角色 / 调整栏舍）、危险操作卡（移出 / 退出） -->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/colorSurface"
        android:orientation="vertical">

        <include
            android:id="@+id/top_bar"
            layout="@layout/base_include_top_app_bar" />

        <com.zhimu.slmp.base.widget.StateLayout
            android:id="@+id/state"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            app:stateErrorTitle="成员详情加载失败"
            app:stateSkeletonLayout="@layout/base_skeleton_detail">

            <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
                android:id="@+id/refresh"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <androidx.core.widget.NestedScrollView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="@dimen/base_page_margin"
                        android:paddingTop="@dimen/base_space_2"
                        android:paddingEnd="@dimen/base_page_margin"
                        android:paddingBottom="@dimen/base_space_6">

                        <com.zhimu.slmp.base.widget.AvatarView
                            android:id="@+id/avatar"
                            android:layout_width="72dp"
                            android:layout_height="72dp"
                            android:layout_gravity="center_horizontal" />

                        <TextView
                            android:id="@+id/name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginTop="@dimen/base_space_4"
                            android:textAppearance="@style/TextAppearance.Zmt.HeadlineSmall"
                            android:textColor="?attr/colorOnSurface" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginTop="@dimen/base_space_2"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <com.zhimu.slmp.base.widget.StatusTagView
                                android:id="@+id/role_tag"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />

                            <TextView
                                android:id="@+id/joined"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/base_space_2"
                                android:textAppearance="@style/TextAppearance.Zmt.BodyMedium"
                                android:textColor="?attr/colorOnSurfaceVariant" />
                        </LinearLayout>

                        <!-- 手机号卡片 -->
                        <com.google.android.material.card.MaterialCardView
                            style="@style/Widget.Zmt.Card"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/base_space_6">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="72dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingStart="@dimen/base_space_4"
                                android:paddingEnd="@dimen/base_space_2">

                                <FrameLayout
                                    android:layout_width="40dp"
                                    android:layout_height="40dp"
                                    android:background="@drawable/farm_bg_rounded_12">

                                    <ImageView
                                        android:layout_width="24dp"
                                        android:layout_height="24dp"
                                        android:layout_gravity="center"
                                        android:importantForAccessibility="no"
                                        android:src="@drawable/ic_smartphone"
                                        app:tint="?attr/colorOnSurfaceVariant" />
                                </FrameLayout>

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="@dimen/base_space_4"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <TextView
                                        android:id="@+id/phone"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:textAppearance="@style/TextAppearance.Zmt.TitleMedium.Number"
                                        android:textColor="?attr/colorOnSurface" />

                                    <TextView
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:text="@string/farm_member_phone"
                                        android:textAppearance="@style/TextAppearance.Zmt.BodyMedium"
                                        android:textColor="?attr/colorOnSurfaceVariant" />
                                </LinearLayout>

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/call"
                                    style="@style/Widget.Zmt.Button.Icon"
                                    android:layout_width="48dp"
                                    android:layout_height="48dp"
                                    android:contentDescription="@string/farm_member_cd_call"
                                    app:icon="@drawable/ic_call"
                                    app:iconTint="?attr/colorOnSurfaceVariant" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/base_space_5"
                            android:text="@string/farm_member_section"
                            android:textAppearance="@style/TextAppearance.Zmt.TitleSmall"
                            android:textColor="?attr/colorPrimary" />

                        <com.zhimu.slmp.base.widget.GroupedListLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/base_space_2">

                            <!-- 角色 -->
                            <com.google.android.material.card.MaterialCardView
                                style="@style/Widget.Zmt.Card.ListItem"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical"
                                    android:minHeight="72dp"
                                    android:orientation="horizontal"
                                    android:paddingStart="@dimen/base_space_4"
                                    android:paddingEnd="@dimen/base_space_2">

                                    <FrameLayout
                                        android:layout_width="40dp"
                                        android:layout_height="40dp"
                                        android:background="@drawable/farm_bg_rounded_12"
                                        android:backgroundTint="?attr/colorSecondaryContainer">

                                        <ImageView
                                            android:layout_width="24dp"
                                            android:layout_height="24dp"
                                            android:layout_gravity="center"
                                            android:importantForAccessibility="no"
                                            android:src="@drawable/ic_badge"
                                            app:tint="?attr/colorOnSecondaryContainer" />
                                    </FrameLayout>

                                    <LinearLayout
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="@dimen/base_space_4"
                                        android:layout_weight="1"
                                        android:orientation="vertical">

                                        <TextView
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:text="@string/farm_member_role"
                                            android:textAppearance="@style/TextAppearance.Zmt.TitleMedium"
                                            android:textColor="?attr/colorOnSurface" />

                                        <TextView
                                            android:id="@+id/role_text"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:textAppearance="@style/TextAppearance.Zmt.BodyMedium"
                                            android:textColor="?attr/colorOnSurfaceVariant" />
                                    </LinearLayout>

                                    <com.google.android.material.button.MaterialButton
                                        android:id="@+id/change_role"
                                        style="@style/Widget.Zmt.Button.Text"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/farm_member_change_role" />
                                </LinearLayout>
                            </com.google.android.material.card.MaterialCardView>

                            <!-- 负责栏舍 -->
                            <com.google.android.material.card.MaterialCardView
                                style="@style/Widget.Zmt.Card.ListItem"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical"
                                    android:minHeight="80dp"
                                    android:orientation="horizontal"
                                    android:paddingStart="@dimen/base_space_4"
                                    android:paddingTop="@dimen/base_space_3"
                                    android:paddingEnd="@dimen/base_space_2"
                                    android:paddingBottom="@dimen/base_space_3">

                                    <FrameLayout
                                        android:layout_width="40dp"
                                        android:layout_height="40dp"
                                        android:background="@drawable/farm_bg_rounded_12"
                                        android:backgroundTint="?attr/colorSecondaryContainer">

                                        <ImageView
                                            android:layout_width="24dp"
                                            android:layout_height="24dp"
                                            android:layout_gravity="center"
                                            android:importantForAccessibility="no"
                                            android:src="@drawable/ic_fence"
                                            app:tint="?attr/colorOnSecondaryContainer" />
                                    </FrameLayout>

                                    <LinearLayout
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="@dimen/base_space_4"
                                        android:layout_weight="1"
                                        android:orientation="vertical">

                                        <TextView
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:text="@string/farm_member_pens"
                                            android:textAppearance="@style/TextAppearance.Zmt.TitleMedium"
                                            android:textColor="?attr/colorOnSurface" />

                                        <TextView
                                            android:id="@+id/pens_all"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:text="@string/farm_members_all_pens"
                                            android:textAppearance="@style/TextAppearance.Zmt.BodyMedium"
                                            android:textColor="?attr/colorOnSurfaceVariant" />

                                        <com.google.android.material.chip.ChipGroup
                                            android:id="@+id/pen_tags"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:layout_marginTop="@dimen/base_space_1"
                                            app:chipSpacingHorizontal="@dimen/base_space_2"
                                            app:chipSpacingVertical="@dimen/base_space_1" />
                                    </LinearLayout>

                                    <com.google.android.material.button.MaterialButton
                                        android:id="@+id/adjust_pens"
                                        style="@style/Widget.Zmt.Button.Text"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/farm_member_adjust_pens" />
                                </LinearLayout>
                            </com.google.android.material.card.MaterialCardView>
                        </com.zhimu.slmp.base.widget.GroupedListLayout>

                        <!-- 危险操作卡：移出养殖场 / 退出养殖场 -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/danger_card"
                            style="@style/Widget.Zmt.Card"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/base_space_5">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="72dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingStart="@dimen/base_space_4"
                                android:paddingEnd="@dimen/base_space_4">

                                <FrameLayout
                                    android:layout_width="40dp"
                                    android:layout_height="40dp"
                                    android:background="@drawable/farm_bg_rounded_12"
                                    android:backgroundTint="?attr/colorErrorContainer">

                                    <ImageView
                                        android:id="@+id/danger_icon"
                                        android:layout_width="24dp"
                                        android:layout_height="24dp"
                                        android:layout_gravity="center"
                                        android:importantForAccessibility="no"
                                        android:src="@drawable/ic_person_remove"
                                        app:tint="?attr/colorOnErrorContainer" />
                                </FrameLayout>

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="@dimen/base_space_4"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <TextView
                                        android:id="@+id/danger_title"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:text="@string/farm_member_remove"
                                        android:textAppearance="@style/TextAppearance.Zmt.TitleMedium"
                                        android:textColor="?attr/colorError" />

                                    <TextView
                                        android:id="@+id/danger_note"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:text="@string/farm_member_remove_note"
                                        android:textAppearance="@style/TextAppearance.Zmt.BodyMedium"
                                        android:textColor="?attr/colorOnSurfaceVariant" />
                                </LinearLayout>
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>
                </androidx.core.widget.NestedScrollView>
            </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
        </com.zhimu.slmp.base.widget.StateLayout>
    </LinearLayout>
</layout>
