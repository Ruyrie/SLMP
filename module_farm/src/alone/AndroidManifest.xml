<?xml version="1.0" encoding="utf-8"?>
<!-- 单独运行（gradle.properties 中 runAlone.module_farm=true）时合并到 debug 清单 -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:name="com.zhimu.slmp.farm.alone.FarmAloneApp"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@android:mipmap/sym_def_app_icon"
        android:label="养殖场（单独运行）"
        android:networkSecurityConfig="@xml/common_core_network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Zmt">

        <activity
            android:name="com.zhimu.slmp.common.app.AloneLauncherActivity"
            android:exported="true"
            tools:replace="android:exported">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- F01 切换养殖场演示页（debug 源集，单独运行时本清单替换 debug 清单，需在此重复声明） -->
        <activity
            android:name="com.zhimu.slmp.farm.debug.FarmSwitcherDemoActivity"
            android:exported="false">
            <intent-filter>
                <action android:name="com.zhimu.slmp.farm.debug.SWITCHER" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>

</manifest>
