{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@zmt/shared": [
        "../../packages/shared/src/index.ts"
      ],
      "@zmt/shared/*": [
        "../../packages/shared/src/*"
      ]
    },
    "types": [
      "vite/client"
    ]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts",
    "src/**/*.vue",
    "../../packages/shared/src/**/*.ts",
    "../../packages/shared/src/**/*.vue"
  ]
}
