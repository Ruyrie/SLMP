<?xml version="1.0" encoding="utf-8"?>
<!-- L08 批次入栏：说明横幅、栏舍、品种（全宽）、用途 + 来源、入栏日期 + 入栏日龄、数量、超容量警示（含确认复选框）、
     入栏平均体重 + 引种单价（自繁时隐藏单价）；底部“提交”（编辑为“保存”） -->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

        <import type="android.view.View" />

        <variable
            name="vm"
            type="com.zhimu.slmp.herd.ui.entry.BatchEntryViewModel" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/colorSurface"
        android:orientation="vertical">

        <include
            android:id="@+id/herd_top_bar"
            layout="@layout/base_include_top_app_bar"
            app:title="@{vm.editMode ? @string/herd_entry_title_edit : @string/herd_entry_title}" />

        <com.zhimu.slmp.base.widget.StateLayout
            android:id="@+id/herd_state"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            app:stateErrorTitle="@string/herd_entry_error_title"
            app:stateSkeletonLayout="@layout/base_skeleton_detail">

            <androidx.core.widget.NestedScrollView
                android:id="@+id/herd_scroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/base_page_margin"
                    android:paddingTop="@dimen/base_space_5"
                    android:paddingEnd="@dimen/base_page_margin"
                    android:paddingBottom="@dimen/base_space_6">

                    <com.zhimu.slmp.base.widget.NoticeView
                        android:id="@+id/herd_notice"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:noticeIcon="@drawable/ic_qr_code_2" />

                    <com.zhimu.slmp.base.widget.NoticeView
                        android:id="@+id/herd_biz_banner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/base_space_3"
                        app:goneIfNull="@{vm.bizBanner}"
                        app:noticeLevel="error" />

                    <com.zhimu.slmp.base.widget.ZmtTextInputLayout
                        style="@style/Widget.Zmt.TextInputLayout.Dropdown"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/base_space_5"
                        android:hint="@string/herd_entry_pen"
                        app:helperText="@{vm.penHelper}"
                        app:helperTextEnabled="true"
                        app:herdError="@{vm.fieldErrors[`pen_id`]}">

                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/herd_pen_input"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="none" />
                    </com.zhimu.slmp.base.widget.ZmtTextInputLayout>

                    <com.zhimu.slmp.base.widget.ZmtTextInputLayout
                        style="@style/Widget.Zmt.TextInputLayout.Dropdown"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/base_space_3"
                        android:hint="@string/herd_entry_breed"
                        app:helperText="@{vm.categoryHelper}"
                        app:helperTextEnabled="true"
                        app:herdError="@{vm.fieldErrors[`breed_id`]}">

                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/herd_breed_input"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="none" />
                    </com.zhimu.slmp.base.widget.ZmtTextInputLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/base_space_3"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/Widget.Zmt.TextView.FieldLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/base_space_1"
                                android:text="@string/herd_entry_purpose" />

                            <com.zhimu.slmp.base.widget.ConnectedButtonGroup
                                android:id="@+id/herd_purpose_group"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/herd_purpose_commercial"
                                    style="@style/Widget.Zmt.Button.Connected"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:paddingLeft="8dp"
                                    android:paddingRight="8dp"
                                    android:text="@string/herd_entry_purpose_commercial" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/herd_purpose_breeding"
                                    style="@style/Widget.Zmt.Button.Connected"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:paddingLeft="8dp"
                                    android:paddingRight="8dp"
                                    android:text="@string/herd_entry_purpose_breeding" />
                            </com.zhimu.slmp.base.widget.ConnectedButtonGroup>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/base_space_3"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/Widget.Zmt.TextView.FieldLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/base_space_1"
                                android:text="@string/herd_entry_source" />

                            <com.zhimu.slmp.base.widget.ConnectedButtonGroup
                                android:id="@+id/herd_source_group"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/herd_source_purchased"
                                    style="@style/Widget.Zmt.Button.Connected"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:paddingLeft="8dp"
                                    android:paddingRight="8dp"
                                    android:text="@string/herd_entry_source_purchased" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/herd_source_self"
                                    style="@style/Widget.Zmt.Button.Connected"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:paddingLeft="8dp"
                                    android:paddingRight="8dp"
                                    android:text="@string/herd_entry_source_self" />
                            </com.zhimu.slmp.base.widget.ConnectedButtonGroup>
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/base_space_3"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <com.zhimu.slmp.base.widget.ZmtTextInputLayout
                            android:id="@+id/herd_date_layout"
                            style="@style/Widget.Zmt.TextInputLayout.Picker"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="@string/herd_entry_date"
                            app:herdError="@{vm.fieldErrors[`entry_date`]}">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/herd_date_input"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                app:dateText="@{vm.entryDate}"
                                app:dateWithWeek="@{false}" />
                        </com.zhimu.slmp.base.widget.ZmtTextInputLayout>

                        <com.zhimu.slmp.base.widget.ZmtTextInputLayout
                            style="@style/Widget.Zmt.TextInputLayout"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/base_space_3"
                            android:layout_weight="1"
                            android:hint="@string/herd_entry_age"
                            app:herdError="@{vm.fieldErrors[`entry_age_days`]}"
                            app:suffixText="@string/herd_unit_day">

                            <com.google.android.material.textfield.TextInputEditText
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="number"
                                android:maxLength="4"
                                android:text="@={vm.entryAgeText}"
                                android:textAppearance="@style/TextAppearance.Zmt.BodyLarge.Number" />
                        </com.zhimu.slmp.base.widget.ZmtTextInputLayout>
                    </LinearLayout>

                    <com.zhimu.slmp.base.widget.ZmtTextInputLayout
                        style="@style/Widget.Zmt.TextInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/base_space_3"
                        android:hint="@string/herd_entry_count"
                        app:herdError="@{vm.fieldErrors[`entry_count`]}"
                        app:suffixText="@{vm.unitText}">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/herd_count_input"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:maxLength="7"
                            android:text="@={vm.entryCountText}"
                            android:textAppearance="@style/TextAppearance.Zmt.BodyLarge.Number" />
                    </com.zhimu.slmp.base.widget.ZmtTextInputLayout>

                    <com.zhimu.slmp.base.widget.NoticeView
                        android:id="@+id/herd_capacity_banner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/base_space_3"
                        android:visibility="gone"
                        app:noticeCheckText="@string/herd_entry_capacity_check"
                        app:noticeLevel="warning"
                        app:noticeTitle="@string/herd_entry_capacity_title" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/base_space_3"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <com.zhimu.slmp.base.widget.ZmtTextInputLayout
                            style="@style/Widget.Zmt.TextInputLayout"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="@string/herd_entry_weight"
                            app:helperText="@string/herd_entry_weight_helper"
                            app:helperTextEnabled="true"
                            app:herdError="@{vm.fieldErrors[`entry_avg_weight`]}"
                            app:suffixText="@string/herd_entry_unit_kg">

                            <com.google.android.material.textfield.TextInputEditText
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="numberDecimal"
                                android:maxLength="8"
                                android:text="@={vm.avgWeightText}"
                                android:textAppearance="@style/TextAppearance.Zmt.BodyLarge.Number" />
                        </com.zhimu.slmp.base.widget.ZmtTextInputLayout>

                        <com.zhimu.slmp.base.widget.ZmtTextInputLayout
                            android:id="@+id/herd_price_layout"
                            style="@style/Widget.Zmt.TextInputLayout"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/base_space_3"
                            android:layout_weight="1"
                            android:hint="@string/herd_entry_price"
                            android:visibility="@{`PURCHASED`.equals(vm.source) ? View.VISIBLE : View.GONE}"
                            app:helperText="@string/herd_entry_price_helper"
                            app:helperTextEnabled="true"
                            app:herdError="@{vm.fieldErrors[`intro_unit_price`]}">

                            <com.google.android.material.textfield.TextInputEditText
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="numberDecimal"
                                android:maxLength="10"
                                android:text="@={vm.unitPriceText}"
                                android:textAppearance="@style/TextAppearance.Zmt.BodyLarge.Number" />
                        </com.zhimu.slmp.base.widget.ZmtTextInputLayout>
                    </LinearLayout>
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>
        </com.zhimu.slmp.base.widget.StateLayout>

        <com.zhimu.slmp.base.widget.BottomActionBar
            android:id="@+id/herd_action_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:barPrimaryText="@string/herd_action_submit" />
    </LinearLayout>
</layout>
