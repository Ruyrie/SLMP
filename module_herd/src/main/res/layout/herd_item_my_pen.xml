<?xml version="1.0" encoding="utf-8"?>
<!-- L02 负责栏舍卡：头部 → 批次子卡 → 指标行 → 分隔线 → 今日任务（第 1 个为完整样式，其余为紧凑样式） -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.Zmt.Card.Summary"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/base_space_3">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/herd_pen_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:minHeight="48dp"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/herd_bg_icon_box"
                android:importantForAccessibility="no"
                android:padding="8dp"
                android:src="@drawable/ic_fence"
                app:tint="?attr/colorOnSecondaryContainer" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/base_space_4"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/herd_pen_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.Zmt.TitleMedium"
                    android:textColor="?attr/colorOnSurface" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.zhimu.slmp.base.widget.StatusTagView
                        android:id="@+id/herd_pen_empty_tag"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/base_space_2"
                        android:text="@string/herd_tag_empty"
                        android:visibility="gone"
                        app:tagType="neutral" />

                    <TextView
                        android:id="@+id/herd_pen_subtitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textAppearance="@style/TextAppearance.Zmt.BodyMedium.Number"
                        android:textColor="?attr/colorOnSurfaceVariant" />
                </LinearLayout>
            </LinearLayout>

            <ImageView
                android:id="@+id/herd_pen_chevron"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_chevron_right"
                app:tint="?attr/colorOnSurfaceVariant" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/herd_pen_batches"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <LinearLayout
            android:id="@+id/herd_pen_metrics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/base_space_3"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <include
                android:id="@+id/herd_metric_stock"
                layout="@layout/herd_view_metric" />

            <include
                android:id="@+id/herd_metric_day_age"
                layout="@layout/herd_view_metric" />

            <include
                android:id="@+id/herd_metric_stage"
                layout="@layout/herd_view_metric" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/herd_pen_task_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.divider.MaterialDivider
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/base_space_3" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/base_space_3"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/herd_my_pens_today_tasks"
                    android:textAppearance="@style/TextAppearance.Zmt.TitleSmall"
                    android:textColor="?attr/colorOnSurface" />

                <TextView
                    android:id="@+id/herd_pen_task_progress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Zmt.BodyMedium.Number"
                    android:textColor="?attr/colorOnSurfaceVariant" />
            </LinearLayout>

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/herd_pen_task_bar"
                style="@style/Widget.Zmt.LinearProgressIndicator"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/base_space_3"
                android:max="100" />

            <LinearLayout
                android:id="@+id/herd_pen_tasks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/base_space_1"
                android:orientation="vertical" />

            <LinearLayout
                android:id="@+id/herd_pen_tasks_done"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_check_circle"
                    app:tint="?attr/colorOnSurfaceVariant" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/base_space_3"
                    android:text="@string/herd_my_pens_tasks_done"
                    android:textAppearance="@style/TextAppearance.Zmt.BodyMedium"
                    android:textColor="?attr/colorOnSurfaceVariant" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
