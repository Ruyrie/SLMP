<?xml version="1.0" encoding="utf-8"?>
<!-- L06 批次二维码面板：批次号 28 sp（等宽）、200 dp 二维码框、标签文字，底部“保存图片”“打印标签”（布局同 L09 批次号卡） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="@dimen/base_sheet_padding_horizontal"
    android:paddingEnd="@dimen/base_sheet_padding_horizontal"
    android:paddingBottom="@dimen/base_space_4">

    <TextView
        android:id="@+id/herd_qr_batch_no"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.Zmt.HeadlineMedium.Number"
        android:textColor="?attr/colorOnSurface" />

    <FrameLayout
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:layout_marginTop="@dimen/base_space_3"
        android:background="@drawable/herd_bg_qr_frame"
        android:padding="12dp">

        <ImageView
            android:id="@+id/herd_qr_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/herd_archive_qr" />
    </FrameLayout>

    <TextView
        android:id="@+id/herd_qr_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/base_space_3"
        android:gravity="center"
        android:textAppearance="@style/TextAppearance.Zmt.BodyMedium"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/base_space_5"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/herd_qr_save"
            style="@style/Widget.Zmt.Button.Outlined"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/herd_label_save"
            app:icon="@drawable/ic_download" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/herd_qr_print"
            style="@style/Widget.Zmt.Button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/base_space_3"
            android:layout_weight="1"
            android:text="@string/herd_label_print"
            app:icon="@drawable/herd_ic_print" />
    </LinearLayout>
</LinearLayout>
