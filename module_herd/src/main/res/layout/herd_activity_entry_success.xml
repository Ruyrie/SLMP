<?xml version="1.0" encoding="utf-8"?>
<!-- L09 入栏成功：close + 标题 + “查看档案”；结果区、批次号卡（二维码）、入栏摘要、说明横幅；底部“保存图片”“打印标签” -->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

        <variable
            name="vm"
            type="com.zhimu.slmp.herd.ui.entry.BatchEntrySuccessViewModel" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/colorSurface"
        android:orientation="vertical">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/herd_toolbar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/base_top_bar_height"
            app:navigationContentDescription="@string/base_cd_close"
            app:navigationIcon="@drawable/ic_close"
            app:title="@string/herd_success_title" />

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="@dimen/base_page_margin"
                android:paddingTop="@dimen/base_space_2"
                android:paddingEnd="@dimen/base_page_margin"
                android:paddingBottom="@dimen/base_space_6">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/herd_bg_result_icon"
                    android:importantForAccessibility="no"
                    android:padding="10dp"
                    android:src="@drawable/ic_check_circle_filled"
                    app:tint="?attr/colorOnSuccessContainer" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/base_space_3"
                    android:text="@string/herd_success_done"
                    android:textAppearance="@style/TextAppearance.Zmt.TitleLarge"
                    android:textColor="?attr/colorOnSurface" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/base_space_2"
                    android:gravity="center"
                    android:text="@{vm.summaryText}"
                    android:textAppearance="@style/TextAppearance.Zmt.BodyMedium"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Zmt.Card.Summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/base_space_4">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/herd_success_batch_no"
                            android:textAppearance="@style/TextAppearance.Zmt.BodySmall"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@{vm.result.batchNo}"
                            android:textAppearance="@style/TextAppearance.Zmt.HeadlineMedium.Number"
                            android:textColor="?attr/colorOnSurface" />

                        <FrameLayout
                            android:layout_width="200dp"
                            android:layout_height="200dp"
                            android:layout_marginTop="@dimen/base_space_3"
                            android:background="@drawable/herd_bg_qr_frame"
                            android:padding="12dp">

                            <ImageView
                                android:id="@+id/herd_qr_image"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:contentDescription="@string/herd_archive_qr" />
                        </FrameLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/base_space_3"
                            android:gravity="center"
                            android:text="@{vm.result.labelText}"
                            android:textAppearance="@style/TextAppearance.Zmt.BodyMedium"
                            android:textColor="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.zhimu.slmp.base.widget.GroupedListLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/base_space_3">

                    <com.zhimu.slmp.base.widget.KeyValueRowView
                        android:id="@+id/herd_kv_entry"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:kvKey="@string/herd_success_entry"
                        app:kvValueAlign="end" />

                    <com.zhimu.slmp.base.widget.ListRowView
                        android:id="@+id/herd_row_pen"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </com.zhimu.slmp.base.widget.GroupedListLayout>

                <com.zhimu.slmp.base.widget.NoticeView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/base_space_3"
                    app:noticeText="@string/herd_success_notice" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <com.zhimu.slmp.base.widget.BottomActionBar
            android:id="@+id/herd_action_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:barPrimaryIcon="@drawable/herd_ic_print"
            app:barPrimaryText="@string/herd_label_print"
            app:barSecondaryIcon="@drawable/ic_download"
            app:barSecondaryText="@string/herd_label_save" />
    </LinearLayout>
</layout>
