<?xml version="1.0" encoding="utf-8"?>
<!-- 生产提醒页（L01“生产提醒”卡进入）：顶部栏 + 提醒列表（下拉刷新）；没有提醒时显示空状态 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:orientation="vertical">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/herd_app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/herd_toolbar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/base_top_bar_height"
            app:navigationContentDescription="@string/base_cd_back"
            app:navigationIcon="@drawable/ic_arrow_back" />
    </com.google.android.material.appbar.AppBarLayout>

    <com.zhimu.slmp.base.widget.StateLayout
        android:id="@+id/herd_state"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        app:stateEmptyIcon="@drawable/ic_task_alt"
        app:stateEmptyMessage="@string/herd_reminder_empty_message"
        app:stateEmptyTitle="@string/herd_reminder_empty_title"
        app:stateErrorTitle="@string/herd_reminder_error_title"
        app:stateSkeletonLayout="@layout/base_skeleton_list">

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/herd_refresh"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/herd_reminders"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingStart="@dimen/base_page_margin"
                android:paddingTop="@dimen/base_space_2"
                android:paddingEnd="@dimen/base_page_margin"
                android:paddingBottom="@dimen/base_space_4" />
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
    </com.zhimu.slmp.base.widget.StateLayout>
</LinearLayout>
