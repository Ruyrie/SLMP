<?xml version="1.0" encoding="utf-8"?>
<!-- L01 生产页：一级页顶部栏 + 今日生产概况（存栏 / 在养批次 / 生产提醒，点生产提醒进入提醒页）+ 生产 / 防疫 / 物资入口 -->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

        <variable
            name="vm"
            type="com.zhimu.slmp.herd.ui.production.ProductionViewModel" />
    </data>

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/colorSurface">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <com.zhimu.slmp.common.widget.FirstLevelTopBar
                android:id="@+id/herd_top_bar"
                android:layout_width="match_parent"
                android:layout_height="@dimen/base_top_bar_height" />

            <com.zhimu.slmp.base.widget.StateLayout
                android:id="@+id/herd_state"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                app:stateErrorTitle="@string/herd_production_error_title">

                <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
                    android:id="@+id/herd_refresh"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <androidx.core.widget.NestedScrollView
                        android:id="@+id/herd_scroll"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingStart="@dimen/base_page_margin"
                            android:paddingEnd="@dimen/base_page_margin"
                            android:paddingBottom="@dimen/base_space_4">

                            <com.zhimu.slmp.base.widget.NoticeView
                                android:id="@+id/herd_audit_notice"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/base_space_2"
                                app:noticeLevel="warning"
                                app:noticeText="@string/herd_production_audit_notice"
                                app:noticeActionText="@string/herd_production_audit_action"
                                app:visibleIf="@{vm.showAuditNotice}" />

                            <LinearLayout
                                android:id="@+id/herd_overview_group"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                app:visibleIf="@{!vm.showAuditNotice}">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/base_space_2"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <TextView
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:text="@string/herd_production_overview_title"
                                        android:textAppearance="@style/TextAppearance.Zmt.TitleSmall"
                                        android:textColor="?attr/colorPrimary" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@{vm.dateText}"
                                        android:textAppearance="@style/TextAppearance.Zmt.BodyMedium.Number"
                                        android:textColor="?attr/colorOnSurfaceVariant" />
                                </LinearLayout>

                                <!-- 三张卡等高：在养批次卡多一行“栏舍占用 a/b”副标题时，另两张同步拉高 -->
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/base_space_3"
                                    android:orientation="horizontal">

                                    <com.zhimu.slmp.base.widget.StatCardView
                                        android:id="@+id/herd_card_stock"
                                        android:layout_width="0dp"
                                        android:layout_height="match_parent"
                                        android:layout_weight="143"
                                        app:statEmphasis="true"
                                        app:statIcon="@drawable/ic_fence"
                                        app:statLabel="@string/herd_production_stock" />

                                    <com.zhimu.slmp.base.widget.StatCardView
                                        android:id="@+id/herd_card_batch"
                                        android:layout_width="0dp"
                                        android:layout_height="match_parent"
                                        android:layout_marginStart="@dimen/base_space_2"
                                        android:layout_weight="111"
                                        app:statLabel="@string/herd_production_batch" />

                                    <com.zhimu.slmp.base.widget.StatCardView
                                        android:id="@+id/herd_card_reminder"
                                        android:layout_width="0dp"
                                        android:layout_height="match_parent"
                                        android:layout_marginStart="@dimen/base_space_2"
                                        android:layout_weight="110"
                                        app:statLabel="@string/herd_production_reminder" />
                                </LinearLayout>

                                <com.zhimu.slmp.base.widget.NoticeView
                                    android:id="@+id/herd_no_pen_notice"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/base_space_3"
                                    app:noticeText="@string/herd_production_no_pen_notice"
                                    app:noticeActionText="@string/herd_production_add_pen"
                                    app:visibleIf="@{vm.showNoPenNotice}" />

                                <LinearLayout
                                    android:id="@+id/herd_entry_groups"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical" />
                            </LinearLayout>
                        </LinearLayout>
                    </androidx.core.widget.NestedScrollView>
                </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
            </com.zhimu.slmp.base.widget.StateLayout>
        </LinearLayout>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</layout>
