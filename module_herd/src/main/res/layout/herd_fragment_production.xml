<?xml version="1.0" encoding="utf-8"?>
<!-- L01 生产页（所有者、场长）：一级页顶部栏 + 今日生产概况 + 生产提醒 + 生产 / 防疫 / 物资入口 + 扩展型 FAB“登记” -->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

        <variable
            name="vm"
            type="com.zhimu.slmp.herd.ui.production.ProductionViewModel" />
    </data>

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/colorSurface">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <com.zhimu.slmp.common.widget.FirstLevelTopBar
                android:id="@+id/herd_top_bar"
                android:layout_width="match_parent"
                android:layout_height="@dimen/base_top_bar_height" />

            <com.zhimu.slmp.base.widget.StateLayout
                android:id="@+id/herd_state"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                app:stateErrorTitle="@string/herd_production_error_title">

                <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
                    android:id="@+id/herd_refresh"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <androidx.core.widget.NestedScrollView
                        android:id="@+id/herd_scroll"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingStart="@dimen/base_page_margin"
                            android:paddingEnd="@dimen/base_page_margin"
                            android:paddingBottom="@dimen/base_fab_list_bottom_space">

                            <com.zhimu.slmp.base.widget.NoticeView
                                android:id="@+id/herd_audit_notice"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/base_space_2"
                                app:noticeLevel="warning"
                                app:noticeText="@string/herd_production_audit_notice"
                                app:noticeActionText="@string/herd_production_audit_action"
                                app:visibleIf="@{vm.showAuditNotice}" />

                            <LinearLayout
                                android:id="@+id/herd_overview_group"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                app:visibleIf="@{!vm.showAuditNotice}">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/base_space_2"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <TextView
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:text="@string/herd_production_overview_title"
                                        android:textAppearance="@style/TextAppearance.Zmt.TitleSmall"
                                        android:textColor="?attr/colorPrimary" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@{vm.dateText}"
                                        android:textAppearance="@style/TextAppearance.Zmt.BodyMedium.Number"
                                        android:textColor="?attr/colorOnSurfaceVariant" />
                                </LinearLayout>

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/base_space_3"
                                    android:orientation="horizontal">

                                    <com.zhimu.slmp.base.widget.StatCardView
                                        android:id="@+id/herd_card_stock"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="143"
                                        app:statEmphasis="true"
                                        app:statIcon="@drawable/ic_fence"
                                        app:statLabel="@string/herd_production_stock" />

                                    <com.zhimu.slmp.base.widget.StatCardView
                                        android:id="@+id/herd_card_todo"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="@dimen/base_space_2"
                                        android:layout_weight="111"
                                        app:statLabel="@string/herd_production_todo" />

                                    <com.zhimu.slmp.base.widget.StatCardView
                                        android:id="@+id/herd_card_warning"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="@dimen/base_space_2"
                                        android:layout_weight="110"
                                        app:statLabel="@string/herd_production_warning" />
                                </LinearLayout>

                                <com.zhimu.slmp.base.widget.NoticeView
                                    android:id="@+id/herd_no_pen_notice"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/base_space_3"
                                    app:noticeText="@string/herd_production_no_pen_notice"
                                    app:noticeActionText="@string/herd_production_add_pen"
                                    app:visibleIf="@{vm.showNoPenNotice}" />

                                <androidx.recyclerview.widget.RecyclerView
                                    android:id="@+id/herd_reminders"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/base_space_2"
                                    android:nestedScrollingEnabled="false"
                                    android:overScrollMode="never" />

                                <TextView
                                    android:id="@+id/herd_reminders_all"
                                    android:layout_width="match_parent"
                                    android:layout_height="48dp"
                                    android:background="?attr/selectableItemBackground"
                                    android:gravity="center_vertical"
                                    android:paddingStart="@dimen/base_space_4"
                                    android:textAppearance="@style/TextAppearance.Zmt.LabelLarge"
                                    android:textColor="?attr/colorPrimary"
                                    android:visibility="gone" />

                                <LinearLayout
                                    android:id="@+id/herd_entry_groups"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical" />
                            </LinearLayout>
                        </LinearLayout>
                    </androidx.core.widget.NestedScrollView>
                </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
            </com.zhimu.slmp.base.widget.StateLayout>
        </LinearLayout>

        <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
            android:id="@+id/herd_fab"
            style="@style/Widget.Zmt.ExtendedFloatingActionButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="@dimen/base_space_4"
            android:text="@string/herd_production_fab"
            app:icon="@drawable/ic_add" />
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</layout>
