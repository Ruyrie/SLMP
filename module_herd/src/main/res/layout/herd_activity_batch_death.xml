<?xml version="1.0" encoding="utf-8"?>
<!-- L11 死淘登记：批次（多栏舍时另选栏舍）、数量、原因 Chip、日期 + 实际执行人（员工不显示）、说明、照片网格；底部“保存” -->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

        <variable
            name="vm"
            type="com.zhimu.slmp.herd.ui.death.BatchDeathViewModel" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/colorSurface"
        android:orientation="vertical">

        <include
            android:id="@+id/herd_top_bar"
            layout="@layout/base_include_top_app_bar"
            app:title="@{vm.editMode ? @string/herd_death_title_edit : @string/herd_death_title}" />

        <com.zhimu.slmp.base.widget.StateLayout
            android:id="@+id/herd_state"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            app:stateErrorTitle="@string/herd_death_error_title"
            app:stateSkeletonLayout="@layout/base_skeleton_detail">

            <androidx.core.widget.NestedScrollView
                android:id="@+id/herd_scroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/base_page_margin"
                    android:paddingTop="@dimen/base_space_5"
                    android:paddingEnd="@dimen/base_page_margin"
                    android:paddingBottom="@dimen/base_space_6">

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Zmt.TextInputLayout.Dropdown"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/herd_death_batch"
                        app:helperText="@{vm.needPenSelect ? null : vm.penHelper}"
                        app:helperTextEnabled="true"
                        app:herdError="@{vm.fieldErrors[`batch_id`]}">

                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/herd_batch_input"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="none"
                            android:textAppearance="@style/TextAppearance.Zmt.BodyLarge.Number" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Zmt.TextInputLayout.Dropdown"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/base_space_3"
                        android:hint="@string/herd_death_pen"
                        app:helperText="@{vm.penHelper}"
                        app:helperTextEnabled="true"
                        app:herdError="@{vm.fieldErrors[`pen_id`]}"
                        app:visibleIf="@{vm.needPenSelect}">

                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/herd_pen_input"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="none" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/herd_quantity_layout"
                        style="@style/Widget.Zmt.TextInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/base_space_3"
                        android:hint="@string/herd_death_quantity"
                        app:herdError="@{vm.fieldErrors[`quantity`]}">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/herd_quantity_input"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:maxLength="7"
                            android:text="@={vm.quantityText}"
                            android:textAppearance="@style/TextAppearance.Zmt.BodyLarge.Number" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        style="@style/Widget.Zmt.TextView.FieldLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/base_space_1"
                        android:layout_marginTop="@dimen/base_space_4"
                        android:text="@string/herd_death_reason" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/herd_reason_chips"
                        style="@style/Widget.Zmt.ChipGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/base_space_1"
                        app:singleSelection="true" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/base_space_4"
                        android:text="@{vm.fieldErrors[`reason_code`]}"
                        android:textAppearance="@style/TextAppearance.Zmt.BodySmall"
                        android:textColor="?attr/colorError"
                        app:goneIfNull="@{vm.fieldErrors[`reason_code`]}" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/base_space_4"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/herd_date_layout"
                            style="@style/Widget.Zmt.TextInputLayout.Picker"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="@string/herd_death_date"
                            app:herdError="@{vm.fieldErrors[`event_date`]}">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/herd_date_input"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                app:dateText="@{vm.eventDate}"
                                app:dateWithWeek="@{false}" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.Zmt.TextInputLayout.Dropdown"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/base_space_3"
                            android:layout_weight="1"
                            android:hint="@string/herd_death_executor"
                            app:helperText="@string/herd_death_executor_helper"
                            app:helperTextEnabled="true"
                            app:visibleIf="@{vm.showExecutor}">

                            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                                android:id="@+id/herd_executor_input"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="none" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Zmt.TextInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/base_space_3"
                        android:hint="@string/herd_death_remark"
                        app:counterEnabled="true"
                        app:counterMaxLength="200"
                        app:helperText="@{vm.remarkRequired ? @string/herd_death_remark_required : null}"
                        app:helperTextEnabled="true"
                        app:herdError="@{vm.fieldErrors[`remark`]}"
                        app:placeholderText="@string/herd_death_remark_hint">

                        <com.google.android.material.textfield.TextInputEditText
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textMultiLine"
                            android:maxLength="200"
                            android:text="@={vm.remark}" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/base_space_6"
                        android:text="@string/herd_death_photos"
                        android:textAppearance="@style/TextAppearance.Zmt.TitleMedium"
                        android:textColor="?attr/colorOnSurface" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/base_space_1"
                        android:text="@string/herd_death_photos_hint"
                        android:textAppearance="@style/TextAppearance.Zmt.BodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <com.zhimu.slmp.media.picker.MediaPickerView
                        android:id="@+id/herd_photos"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/base_space_3"
                        app:mediaCameraTitle="@string/herd_death_title" />
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>
        </com.zhimu.slmp.base.widget.StateLayout>

        <com.zhimu.slmp.base.widget.BottomActionBar
            android:id="@+id/herd_action_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:barPrimaryText="@string/herd_action_save" />
    </LinearLayout>
</layout>
