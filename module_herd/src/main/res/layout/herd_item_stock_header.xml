<?xml version="1.0" encoding="utf-8"?>
<!-- L03 列表头：总存栏汇总卡 + 列表标题（栏舍 · 7 个）+ 排序按钮 + 空状态 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <com.zhimu.slmp.base.widget.StatCardView
        android:id="@+id/herd_summary_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:statEmphasis="true"
        app:statLabel="@string/herd_stock_total"
        app:statSize="large" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="@dimen/base_space_2"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/herd_list_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textAppearance="@style/TextAppearance.Zmt.TitleSmall"
            android:textColor="?attr/colorPrimary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/herd_sort"
            style="@style/Widget.Zmt.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:icon="@drawable/ic_sort" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/herd_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="@dimen/base_space_8"
        android:paddingBottom="@dimen/base_space_8"
        android:visibility="gone">

        <ImageView
            android:id="@+id/herd_empty_icon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_fence"
            app:tint="?attr/colorOnSurfaceVariant" />

        <TextView
            android:id="@+id/herd_empty_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/base_space_4"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.Zmt.TitleMedium"
            android:textColor="?attr/colorOnSurface" />

        <TextView
            android:id="@+id/herd_empty_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/base_space_2"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.Zmt.BodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/herd_empty_action"
            style="@style/Widget.Zmt.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/base_space_4"
            android:text="@string/herd_production_add_pen"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
