<?xml version="1.0" encoding="utf-8"?>
<!-- L06 时间线记录：日期列（52 dp，右对齐两行）+ 32 dp 节点与 2 dp 竖线 + 标题 / 次行 / 展开详情 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:minHeight="64dp"
    android:orientation="horizontal"
    android:paddingStart="@dimen/base_page_margin"
    android:paddingEnd="@dimen/base_page_margin">

    <LinearLayout
        android:layout_width="52dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="end"
        android:orientation="vertical">

        <TextView
            android:id="@+id/herd_tl_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Zmt.BodySmall"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <TextView
            android:id="@+id/herd_tl_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Zmt.BodySmall"
            android:textColor="?attr/colorOnSurfaceVariant" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="32dp"
        android:layout_height="match_parent"
        android:layout_marginStart="@dimen/base_space_3">

        <View
            android:id="@+id/herd_tl_line"
            android:layout_width="2dp"
            android:layout_height="match_parent"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="32dp"
            android:background="?attr/colorOutlineVariant" />

        <ImageView
            android:id="@+id/herd_tl_node"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/herd_bg_timeline_node"
            android:importantForAccessibility="no"
            android:padding="7dp" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/base_space_3"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingBottom="@dimen/base_space_4">

        <TextView
            android:id="@+id/herd_tl_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Zmt.TitleMedium"
            android:textColor="?attr/colorOnSurface" />

        <TextView
            android:id="@+id/herd_tl_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="@style/TextAppearance.Zmt.BodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <LinearLayout
            android:id="@+id/herd_tl_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/base_space_2"
            android:orientation="vertical"
            android:visibility="gone" />

        <TextView
            android:id="@+id/herd_tl_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/base_space_1"
            android:textAppearance="@style/TextAppearance.Zmt.BodySmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
