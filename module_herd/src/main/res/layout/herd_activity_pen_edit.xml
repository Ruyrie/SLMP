<?xml version="1.0" encoding="utf-8"?>
<!-- L05 新增 / 编辑栏舍：编号（编辑只读）、名称、类型 Chip、适用品类下拉、容量；负责员工说明；底部“保存” -->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

        <variable
            name="vm"
            type="com.zhimu.slmp.herd.ui.penedit.PenEditViewModel" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/colorSurface"
        android:orientation="vertical">

        <include
            android:id="@+id/herd_top_bar"
            layout="@layout/base_include_top_app_bar"
            app:title="@{vm.editMode ? @string/herd_pen_edit_title_edit : @string/herd_pen_edit_title_new}" />

        <com.zhimu.slmp.base.widget.StateLayout
            android:id="@+id/herd_state"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            app:stateErrorTitle="@string/herd_pen_edit_error_title"
            app:stateSkeletonLayout="@layout/base_skeleton_detail">

            <androidx.core.widget.NestedScrollView
                android:id="@+id/herd_scroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/base_page_margin"
                    android:paddingTop="@dimen/base_space_5"
                    android:paddingEnd="@dimen/base_page_margin"
                    android:paddingBottom="@dimen/base_space_6">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/herd_code_layout"
                        style="@style/Widget.Zmt.TextInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/herd_pen_edit_code"
                        app:helperText="@{vm.editMode ? @string/herd_pen_edit_code_readonly : @string/herd_pen_edit_code_helper}"
                        app:helperTextEnabled="true"
                        app:herdError="@{vm.fieldErrors[`pen_code`]}">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/herd_code_input"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textCapCharacters|textNoSuggestions"
                            android:maxLength="10"
                            android:text="@={vm.penCode}"
                            android:textAppearance="@style/TextAppearance.Zmt.BodyLarge.Number" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Zmt.TextInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/base_space_3"
                        android:hint="@string/herd_pen_edit_name"
                        app:helperText="@string/herd_pen_edit_name_helper"
                        app:helperTextEnabled="true"
                        app:herdError="@{vm.fieldErrors[`pen_name`]}">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/herd_name_input"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text"
                            android:maxLength="40"
                            android:text="@={vm.penName}" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        style="@style/Widget.Zmt.TextView.FieldLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/base_space_1"
                        android:layout_marginTop="@dimen/base_space_4"
                        android:text="@string/herd_pen_edit_type" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/herd_type_chips"
                        style="@style/Widget.Zmt.ChipGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/base_space_1"
                        app:singleSelection="true" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/base_space_4"
                        android:text="@{vm.fieldErrors[`pen_type`]}"
                        android:textAppearance="@style/TextAppearance.Zmt.BodySmall"
                        android:textColor="?attr/colorError"
                        app:goneIfNull="@{vm.fieldErrors[`pen_type`]}" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Zmt.TextInputLayout.Dropdown"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/base_space_4"
                        android:hint="@string/herd_pen_edit_category"
                        app:helperText="@string/herd_pen_edit_category_helper"
                        app:helperTextEnabled="true"
                        app:herdError="@{vm.fieldErrors[`category_id`]}">

                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/herd_category_input"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="none" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/herd_capacity_layout"
                        style="@style/Widget.Zmt.TextInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/base_space_3"
                        android:hint="@string/herd_pen_edit_capacity"
                        app:helperTextEnabled="true"
                        app:herdError="@{vm.fieldErrors[`capacity`]}"
                        app:suffixText="@{vm.unitText}">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/herd_capacity_input"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:maxLength="7"
                            android:text="@={vm.capacityText}"
                            android:textAppearance="@style/TextAppearance.Zmt.BodyLarge.Number" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.zhimu.slmp.base.widget.NoticeView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/base_space_4"
                        app:noticeIcon="@drawable/ic_badge"
                        app:noticeText="@string/herd_pen_edit_staff_notice" />
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>
        </com.zhimu.slmp.base.widget.StateLayout>

        <com.zhimu.slmp.base.widget.BottomActionBar
            android:id="@+id/herd_action_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:barPrimaryText="@string/herd_action_save" />
    </LinearLayout>
</layout>
