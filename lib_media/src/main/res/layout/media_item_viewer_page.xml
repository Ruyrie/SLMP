<?xml version="1.0" encoding="utf-8"?>
<!-- I09 的一页：可缩放图片；视频项为封面 + 中央播放按钮，点播放后由页面的 ExoPlayer 挂到 PlayerView 播放 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.zhimu.slmp.media.widget.ZoomableImageView
        android:id="@+id/media_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no" />

    <androidx.media3.ui.PlayerView
        android:id="@+id/media_player"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        app:resize_mode="fit"
        app:shutter_background_color="@android:color/transparent"
        app:surface_type="texture_view"
        app:use_controller="false" />

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/media_loading"
        style="@style/Widget.Zmt.CircularProgressIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:indeterminate="true"
        app:indicatorColor="?attr/colorOnMedia"
        app:indicatorSize="48dp" />

    <ImageView
        android:id="@+id/media_video_play"
        android:layout_width="@dimen/media_viewer_play"
        android:layout_height="@dimen/media_viewer_play"
        android:layout_gravity="center"
        android:background="@drawable/media_bg_scrim_circle"
        android:contentDescription="@string/media_viewer_play"
        android:padding="12dp"
        android:src="@drawable/ic_play_arrow_filled"
        android:visibility="gone"
        app:tint="?attr/colorOnMedia" />

    <!-- 视频加载失败 -->
    <LinearLayout
        android:id="@+id/media_video_error"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/media_viewer_video_failed"
            android:textAppearance="@style/TextAppearance.Zmt.BodyMedium"
            android:textColor="?attr/colorOnMedia" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/media_video_reload"
            style="@style/Widget.Zmt.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/base_space_2"
            android:text="@string/media_viewer_reload"
            android:textColor="@color/zm_inverse_primary" />
    </LinearLayout>

    <TextView
        android:id="@+id/media_error"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:drawablePadding="@dimen/base_space_2"
        android:gravity="center"
        android:text="@string/media_viewer_load_failed"
        android:textAppearance="@style/TextAppearance.Zmt.BodyMedium"
        android:textColor="@color/media_color_on_media_variant"
        android:visibility="gone"
        app:drawableTint="@color/media_color_on_media_variant"
        app:drawableTopCompat="@drawable/ic_error" />
</FrameLayout>
