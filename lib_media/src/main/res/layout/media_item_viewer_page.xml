<?xml version="1.0" encoding="utf-8"?>
<!-- I09 的一页：可缩放图片；视频项显示封面、播放按钮与“视频播放将在后续版本支持” -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.zhimu.slmp.media.widget.ZoomableImageView
        android:id="@+id/media_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no" />

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/media_loading"
        style="@style/Widget.Zmt.CircularProgressIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:indeterminate="true"
        app:indicatorColor="?attr/colorOnMedia" />

    <LinearLayout
        android:id="@+id/media_video_overlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:visibility="gone">

        <ImageView
            android:id="@+id/media_video_play"
            android:layout_width="@dimen/media_viewer_play"
            android:layout_height="@dimen/media_viewer_play"
            android:background="@drawable/media_bg_scrim_circle"
            android:contentDescription="@string/media_viewer_video_unsupported"
            android:padding="12dp"
            android:src="@drawable/ic_play_arrow_filled"
            app:tint="?attr/colorOnMedia" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/base_space_3"
            android:text="@string/media_viewer_video_unsupported"
            android:textAppearance="@style/TextAppearance.Zmt.BodyMedium"
            android:textColor="?attr/colorOnMedia" />
    </LinearLayout>

    <TextView
        android:id="@+id/media_error"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:drawablePadding="@dimen/base_space_2"
        android:gravity="center"
        android:text="@string/media_viewer_load_failed"
        android:textAppearance="@style/TextAppearance.Zmt.BodyMedium"
        android:textColor="@color/media_color_on_media_variant"
        android:visibility="gone"
        app:drawableTint="@color/media_color_on_media_variant"
        app:drawableTopCompat="@drawable/ic_error" />
</FrameLayout>
