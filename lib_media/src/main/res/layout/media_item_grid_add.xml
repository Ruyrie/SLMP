<?xml version="1.0" encoding="utf-8"?>
<!-- 照片网格“添加”格：surface-container-high，add_a_photo 24 dp + body-s“添加”（可带计数“2/9”） -->
<com.zhimu.slmp.media.widget.SquareFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/media_add"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/media_bg_cell_add"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/media_add_icon"
            android:layout_width="@dimen/base_icon_size"
            android:layout_height="@dimen/base_icon_size"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_add_a_photo"
            app:tint="?attr/colorOnSurfaceVariant" />

        <TextView
            android:id="@+id/media_add_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/base_space_2"
            android:text="@string/media_picker_add"
            android:textAppearance="@style/TextAppearance.Zmt.BodySmall"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <TextView
            android:id="@+id/media_add_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="@style/TextAppearance.Zmt.BodySmall.Number"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:visibility="gone"
            tools:text="2/9"
            tools:visibility="visible" />
    </LinearLayout>
</com.zhimu.slmp.media.widget.SquareFrameLayout>
