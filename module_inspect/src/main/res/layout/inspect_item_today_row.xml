<?xml version="1.0" encoding="utf-8"?>
<!-- I01 / I04 的列表项：前置 40 dp 图标块、主文字、副文字（最多 2 行）、尾部状态标签或色调按钮“补录”；
     员工版卡片底部右对齐操作区（修改巡检 / 转上报 / 查看诊断 / 登记巡检） -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/inspect_row_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="?attr/colorSurfaceContainerLowest"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/base_space_4"
        android:paddingTop="@dimen/base_space_3"
        android:paddingEnd="@dimen/base_space_4"
        android:paddingBottom="@dimen/base_space_3">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="42dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/inspect_row_leading"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/inspect_bg_leading_secondary"
                android:importantForAccessibility="no"
                android:padding="8dp"
                android:src="@drawable/ic_fact_check"
                app:tint="?attr/colorOnSecondaryContainer" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/base_space_4"
                android:layout_marginEnd="@dimen/base_space_2"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/inspect_row_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.Zmt.TitleMedium"
                    android:textColor="?attr/colorOnSurface"
                    tools:text="3 号育肥舍" />

                <!-- I04：标签行（异常、现场、超时、补录、非现场、待审核）+ 摘要 -->
                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/inspect_row_tags"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:visibility="gone"
                    app:chipSpacingHorizontal="@dimen/base_space_2"
                    app:chipSpacingVertical="4dp" />

                <TextView
                    android:id="@+id/inspect_row_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textAppearance="@style/TextAppearance.Zmt.BodyMedium"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    tools:text="粪便 水样 · 李明 09:12 · 未上报" />
            </LinearLayout>

            <com.zhimu.slmp.base.widget.StatusTagView
                android:id="@+id/inspect_row_tag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"
                tools:text="异常"
                tools:visibility="visible" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/inspect_row_button"
                style="@style/Widget.Zmt.Button.Tonal.Small"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/inspect_action_backfill"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/inspect_row_more"
                android:layout_width="@dimen/base_touch_target"
                android:layout_height="@dimen/base_touch_target"
                android:layout_marginEnd="-12dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/inspect_action_more"
                android:src="@drawable/ic_more_vert"
                android:visibility="gone"
                app:tint="?attr/colorOnSurfaceVariant" />
        </LinearLayout>

        <!-- 员工版操作区 -->
        <LinearLayout
            android:id="@+id/inspect_row_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/base_space_1"
            android:gravity="end|center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/inspect_row_action_text"
                style="@style/Widget.Zmt.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"
                tools:text="修改巡检" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/inspect_row_action_tonal"
                style="@style/Widget.Zmt.Button.Tonal.Small"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/base_space_2"
                android:text="@string/inspect_action_report"
                android:visibility="gone"
                app:icon="@drawable/ic_report" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/inspect_row_action_filled"
                style="@style/Widget.Zmt.Button.Small"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/base_space_2"
                android:text="@string/inspect_action_register"
                android:visibility="gone"
                app:icon="@drawable/ic_fact_check" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
