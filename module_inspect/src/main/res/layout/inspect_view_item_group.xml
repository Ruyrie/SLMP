<?xml version="1.0" encoding="utf-8"?>
<!-- 巡检项目一行：项目名（宽 84 dp）+ 异常 / 漏选标记；右侧单选 Chip 组 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="60dp"
    android:orientation="horizontal"
    android:paddingStart="@dimen/base_space_4"
    android:paddingTop="@dimen/base_space_2"
    android:paddingEnd="@dimen/base_space_4"
    android:paddingBottom="@dimen/base_space_2">

    <LinearLayout
        android:layout_width="84dp"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/inspect_item_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Zmt.TitleMedium"
            android:textColor="?attr/colorOnSurface"
            tools:text="精神状态" />

        <TextView
            android:id="@+id/inspect_item_mark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawablePadding="2dp"
            android:gravity="center_vertical"
            android:textAppearance="@style/TextAppearance.Zmt.BodySmall"
            android:textColor="?attr/colorError"
            android:visibility="gone"
            app:drawableTint="?attr/colorError"
            tools:text="异常"
            tools:visibility="visible" />
    </LinearLayout>

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/inspect_item_chips"
        style="@style/Widget.Zmt.ChipGroup"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        app:chipSpacingHorizontal="@dimen/base_space_2"
        app:chipSpacingVertical="0dp"
        app:selectionRequired="true"
        app:singleSelection="true" />
</LinearLayout>
