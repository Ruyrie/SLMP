<?xml version="1.0" encoding="utf-8"?>
<!-- I01 巡检截止时间面板内容：说明、截止时间输入框（点击展开时分滚轮）、快捷时间 Chip、提醒规则两行、取消 / 保存 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/base_sheet_padding_horizontal"
    android:paddingEnd="@dimen/base_sheet_padding_horizontal"
    android:paddingBottom="@dimen/base_space_4">

    <com.zhimu.slmp.base.widget.ZmtTextInputLayout
        android:id="@+id/inspect_deadline_layout"
        style="@style/Widget.Zmt.TextInputLayout.Picker"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/base_space_2"
        android:hint="@string/inspect_deadline_input"
        app:boxBackgroundColor="?attr/colorSurfaceContainerLow"
        app:endIconDrawable="@drawable/ic_schedule"
        app:endIconContentDescription="@string/base_cd_pick_time"
        app:helperTextEnabled="true">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/inspect_deadline_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Zmt.TitleLarge.Number"
            tools:text="18:00" />
    </com.zhimu.slmp.base.widget.ZmtTextInputLayout>

    <!-- 时、分两列滚轮（24 小时制），点输入框展开或收起 -->
    <LinearLayout
        android:id="@+id/inspect_deadline_wheel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:visibility="gone">

        <NumberPicker
            android:id="@+id/inspect_deadline_hour"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/base_space_3"
            android:layout_marginEnd="@dimen/base_space_3"
            android:text=":"
            android:textAppearance="@style/TextAppearance.Zmt.TitleLarge"
            tools:ignore="HardcodedText" />

        <NumberPicker
            android:id="@+id/inspect_deadline_minute"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/inspect_deadline_chips"
        style="@style/Widget.Zmt.ChipGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/base_space_3"
        app:singleLine="true"
        app:singleSelection="true" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/base_space_5"
        android:text="@string/inspect_deadline_rules"
        android:textAppearance="@style/TextAppearance.Zmt.TitleSmall"
        android:textColor="?attr/colorPrimary" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/base_space_3"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:importantForAccessibility="no"
            android:src="@drawable/inspect_ic_notifications_active"
            app:tint="?attr/colorOnSurfaceVariant" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/base_space_4"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/inspect_rule_remind"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Zmt.BodyLarge"
                android:textColor="?attr/colorOnSurface"
                tools:text="17:00 提醒负责员工" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="截止前 1 小时；栏舍没有负责员工时，改为提醒所有者和场长"
                android:textAppearance="@style/TextAppearance.Zmt.BodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:ignore="HardcodedText" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/base_space_4"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:importantForAccessibility="no"
            android:src="@drawable/inspect_ic_notification_important"
            app:tint="?attr/colorOnSurfaceVariant" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/base_space_4"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/inspect_rule_deadline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Zmt.BodyLarge"
                android:textColor="?attr/colorOnSurface"
                tools:text="18:00 提醒所有者和场长" />

            <TextView
                android:id="@+id/inspect_rule_names"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Zmt.BodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="到点仍有栏舍未巡检时发送给王建国、刘芳" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/base_space_6"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/inspect_deadline_cancel"
            style="@style/Widget.Zmt.Button.Outlined"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/base_space_3"
            android:layout_weight="1"
            android:text="@string/inspect_action_cancel" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/inspect_deadline_save"
            style="@style/Widget.Zmt.Button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/inspect_action_save" />
    </LinearLayout>
</LinearLayout>
