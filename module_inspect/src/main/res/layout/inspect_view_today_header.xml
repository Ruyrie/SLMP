<?xml version="1.0" encoding="utf-8"?>
<!-- I01 头部：上下文行、统计卡（应巡 / 已巡 / 未巡 / 异常、完成进度、截止时间与“修改”）、筛选 Chip（养殖户版）、“今天”分组标题（员工版） -->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="vm"
            type="com.zhimu.slmp.inspect.ui.today.InspectTodayViewModel" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="@dimen/base_space_1"
        android:paddingBottom="@dimen/base_space_3">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@{vm.scopeText}"
            android:textAppearance="@style/TextAppearance.Zmt.BodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            tools:text="东山猪场 · 10月19日 周一 · 有在栏批次的栏舍" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Zmt.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/base_space_3"
            app:cardBackgroundColor="?attr/colorSurfaceContainerLowest"
            app:cardCornerRadius="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/base_space_4">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@{safeUnbox(vm.isManagerView) ? @string/inspect_today_should_all : @string/inspect_today_should}"
                            android:textAppearance="@style/TextAppearance.Zmt.BodySmall"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                        <TextView
                            android:id="@+id/inspect_stat_should"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textAppearance="@style/TextAppearance.Zmt.HeadlineMedium.Number"
                            android:textColor="?attr/colorOnSurface"
                            tools:text="4个" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/inspect_today_done"
                            android:textAppearance="@style/TextAppearance.Zmt.BodySmall"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                        <TextView
                            android:id="@+id/inspect_stat_done"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textAppearance="@style/TextAppearance.Zmt.HeadlineMedium.Number"
                            android:textColor="?attr/colorOnSurface"
                            tools:text="2个" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/inspect_today_pending"
                            android:textAppearance="@style/TextAppearance.Zmt.BodySmall"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                        <TextView
                            android:id="@+id/inspect_stat_pending"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textAppearance="@style/TextAppearance.Zmt.HeadlineMedium.Number"
                            android:textColor="?attr/colorOnSurface"
                            tools:text="2个" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/inspect_today_abnormal"
                            android:textAppearance="@style/TextAppearance.Zmt.BodySmall"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                        <TextView
                            android:id="@+id/inspect_stat_abnormal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textAppearance="@style/TextAppearance.Zmt.HeadlineMedium.Number"
                            android:textColor="?attr/colorError"
                            tools:text="1个" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/base_space_3"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/inspect_progress"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:max="1000"
                        app:indicatorColor="?attr/colorPrimary"
                        app:trackColor="?attr/colorSurfaceContainerHighest"
                        app:trackCornerRadius="2dp"
                        app:trackThickness="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/base_space_3"
                        android:text="@{vm.progressText}"
                        android:textAppearance="@style/TextAppearance.Zmt.BodySmall.Number"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        tools:text="完成 50.0%" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/base_space_2"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/base_touch_target"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_schedule"
                        app:tint="?attr/colorOnSurfaceVariant" />

                    <TextView
                        android:id="@+id/inspect_deadline_text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/base_space_2"
                        android:layout_weight="1"
                        android:textAppearance="@style/TextAppearance.Zmt.BodyMedium"
                        android:textColor="?attr/colorOnSurface"
                        tools:text="截止 18:00 · 17:00 提醒负责员工" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/inspect_deadline_edit"
                        style="@style/Widget.Zmt.Button.Text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:onClick="@{() -> vm.openDeadlinePanel()}"
                        android:text="@string/inspect_today_edit_deadline"
                        app:visibleIf="@{safeUnbox(vm.isManagerView) &amp;&amp; vm.summary.canEditDeadline}" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/inspect_today_all_done"
                    android:textAppearance="@style/TextAppearance.Zmt.BodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    app:visibleIf="@{vm.summary.allDone}" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/inspect_filters"
            style="@style/Widget.Zmt.ChipGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/base_space_3"
            app:selectionRequired="true"
            app:singleLine="true"
            app:singleSelection="true"
            app:visibleIf="@{vm.isManagerView}">

            <com.google.android.material.chip.Chip
                android:id="@+id/inspect_filter_all"
                style="@style/Widget.Zmt.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/inspect_filter_all" />

            <com.google.android.material.chip.Chip
                android:id="@+id/inspect_filter_pending"
                style="@style/Widget.Zmt.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/inspect_filter_pending" />

            <com.google.android.material.chip.Chip
                android:id="@+id/inspect_filter_abnormal"
                style="@style/Widget.Zmt.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/inspect_filter_abnormal" />

            <com.google.android.material.chip.Chip
                android:id="@+id/inspect_filter_done"
                style="@style/Widget.Zmt.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/inspect_filter_done" />
        </com.google.android.material.chip.ChipGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/base_space_4"
            android:text="@string/inspect_today_group_today"
            android:textAppearance="@style/TextAppearance.Zmt.TitleSmall"
            android:textColor="?attr/colorPrimary"
            app:visibleIf="@{!safeUnbox(vm.isManagerView)}" />
    </LinearLayout>
</layout>
