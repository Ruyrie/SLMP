<?xml version="1.0" encoding="utf-8"?>
<!-- 列表内空状态（清单为空、筛选无结果）：说明文字 + 可选色调按钮 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingTop="@dimen/base_space_8"
    android:paddingBottom="@dimen/base_space_8">

    <TextView
        android:id="@+id/inspect_empty_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingStart="@dimen/base_space_6"
        android:paddingEnd="@dimen/base_space_6"
        android:textAppearance="@style/TextAppearance.Zmt.BodyMedium"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/inspect_empty_action"
        style="@style/Widget.Zmt.Button.Tonal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/base_space_4"
        android:visibility="gone" />
</LinearLayout>
