<?xml version="1.0" encoding="utf-8"?>
<!-- I04 巡检历史：顶部栏 + calendar_month；列表头部为栏舍标题、概况、7 天格、筛选 Chip、规则横幅 -->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/colorSurface"
        android:orientation="vertical">

        <include
            android:id="@+id/inspect_top_bar"
            layout="@layout/base_include_top_app_bar" />

        <com.zhimu.slmp.base.widget.StateLayout
            android:id="@+id/inspect_state"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            app:stateErrorTitle="@string/inspect_history_error"
            app:stateSkeletonLayout="@layout/base_skeleton_list">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/inspect_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingStart="@dimen/base_page_margin"
                android:paddingEnd="@dimen/base_page_margin"
                android:paddingBottom="@dimen/base_space_6" />
        </com.zhimu.slmp.base.widget.StateLayout>
    </LinearLayout>
</layout>
