<?xml version="1.0" encoding="utf-8"?>
<!-- 一条修改记录：修改人与时间、修改前后 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="@dimen/base_space_3"
    android:paddingBottom="@dimen/base_space_3">

    <TextView
        android:id="@+id/inspect_log_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.Zmt.TitleSmall"
        android:textColor="?attr/colorOnSurface" />

    <TextView
        android:id="@+id/inspect_log_changes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/base_space_1"
        android:textAppearance="@style/TextAppearance.Zmt.BodyMedium"
        android:textColor="?attr/colorOnSurfaceVariant" />
</LinearLayout>
