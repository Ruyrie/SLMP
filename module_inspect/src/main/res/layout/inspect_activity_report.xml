<?xml version="1.0" encoding="utf-8"?>
<!-- I05 异常上报：栏舍 / 批次下拉、来源说明（转上报）、发病数量、症状多选、描述、照片和视频；底部“提交并诊断” -->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="vm"
            type="com.zhimu.slmp.inspect.ui.report.AbnormalReportViewModel" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/colorSurface"
        android:orientation="vertical">

        <include
            android:id="@+id/inspect_top_bar"
            layout="@layout/base_include_top_app_bar"
            app:title="@{@string/inspect_report_title}" />

        <com.zhimu.slmp.base.widget.StateLayout
            android:id="@+id/inspect_state"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            app:stateErrorTitle="@string/inspect_report_error"
            app:stateSkeletonLayout="@layout/base_skeleton_detail">

            <androidx.core.widget.NestedScrollView
                android:id="@+id/inspect_scroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/base_page_margin"
                    android:paddingTop="@dimen/base_space_3"
                    android:paddingEnd="@dimen/base_page_margin"
                    android:paddingBottom="@dimen/base_space_6">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <com.zhimu.slmp.base.widget.ZmtTextInputLayout
                            android:id="@+id/inspect_pen_layout"
                            style="@style/Widget.Zmt.TextInputLayout.Dropdown"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/base_space_3"
                            android:layout_weight="1"
                            android:hint="@string/inspect_report_pen"
                            app:inspectError="@{vm.fieldErrors[`pen_id`]}">

                            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                                android:id="@+id/inspect_pen_input"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="none" />
                        </com.zhimu.slmp.base.widget.ZmtTextInputLayout>

                        <com.zhimu.slmp.base.widget.ZmtTextInputLayout
                            android:id="@+id/inspect_batch_layout"
                            style="@style/Widget.Zmt.TextInputLayout.Dropdown"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="@string/inspect_report_batch"
                            app:inspectError="@{vm.fieldErrors[`batch_id`]}">

                            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                                android:id="@+id/inspect_batch_input"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="none"
                                android:textAppearance="@style/TextAppearance.Zmt.BodyLarge.Number" />
                        </com.zhimu.slmp.base.widget.ZmtTextInputLayout>
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/base_space_1"
                        android:drawablePadding="@dimen/base_space_1"
                        android:gravity="center_vertical"
                        android:text="@{vm.sourceText}"
                        android:textAppearance="@style/TextAppearance.Zmt.BodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        app:drawableStartCompat="@drawable/inspect_ic_link_16"
                        app:drawableTint="?attr/colorOnSurfaceVariant"
                        app:goneIfNull="@{vm.sourceText}"
                        tools:text="已从今天 09:12 的巡检带入栏舍、批次和照片" />

                    <com.zhimu.slmp.base.widget.ZmtTextInputLayout
                        android:id="@+id/inspect_sick_layout"
                        style="@style/Widget.Zmt.TextInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/base_space_3"
                        android:hint="@string/inspect_report_sick"
                        app:helperText="@{vm.sickHelper}"
                        app:helperTextEnabled="true"
                        app:inspectError="@{vm.fieldErrors[`sick_count`]}"
                        app:suffixText="@{vm.sickUnit}">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/inspect_sick_input"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:digits="0123456789"
                            android:inputType="number"
                            android:maxLength="6"
                            android:text="@={vm.sickCount}"
                            android:textAppearance="@style/TextAppearance.Zmt.BodyLarge.Number" />
                    </com.zhimu.slmp.base.widget.ZmtTextInputLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/base_space_4"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/inspect_report_symptoms"
                            android:textAppearance="@style/TextAppearance.Zmt.TitleMedium"
                            android:textColor="?attr/colorOnSurface" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@{vm.symptomCountText}"
                            android:textAppearance="@style/TextAppearance.Zmt.BodySmall"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            tools:text="可多选 · 已选 3 项" />
                    </LinearLayout>

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/inspect_symptoms"
                        style="@style/Widget.Zmt.ChipGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/base_space_2"
                        app:chipSpacingHorizontal="@dimen/base_space_2"
                        app:chipSpacingVertical="@dimen/base_space_2" />

                    <com.zhimu.slmp.base.widget.ZmtTextInputLayout
                        android:id="@+id/inspect_description_layout"
                        style="@style/Widget.Zmt.TextInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/base_space_4"
                        android:hint="@string/inspect_report_description"
                        app:counterEnabled="true"
                        app:counterMaxLength="500"
                        app:helperText="@string/inspect_report_description_helper"
                        app:helperTextEnabled="true"
                        app:inspectError="@{vm.fieldErrors[`description`]}">

                        <com.google.android.material.textfield.TextInputEditText
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textMultiLine"
                            android:maxLength="500"
                            android:minLines="2"
                            android:text="@={vm.description}" />
                    </com.zhimu.slmp.base.widget.ZmtTextInputLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/base_space_4"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/inspect_form_media"
                            android:textAppearance="@style/TextAppearance.Zmt.TitleMedium"
                            android:textColor="?attr/colorOnSurface" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@{vm.mediaCountText}"
                            android:textAppearance="@style/TextAppearance.Zmt.BodySmall.Number"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            tools:text="6 / 6" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@{vm.mediaHint}"
                        android:textAppearance="@style/TextAppearance.Zmt.BodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        tools:text="最多 6 个，其中视频 1 段，不超过 30 秒 · 前 3 个来自巡检" />

                    <com.zhimu.slmp.media.picker.MediaPickerView
                        android:id="@+id/inspect_media"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/base_space_3"
                        app:mediaDeletedText="@string/inspect_form_deleted_photo" />
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>
        </com.zhimu.slmp.base.widget.StateLayout>

        <com.zhimu.slmp.base.widget.BottomActionBar
            android:id="@+id/inspect_action_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:barPrimaryText="@string/inspect_report_submit" />
    </LinearLayout>
</layout>
