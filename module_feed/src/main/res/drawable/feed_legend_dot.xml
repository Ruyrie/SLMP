<?xml version="1.0" encoding="utf-8"?>
<!-- G06 图例对比批次：16 dp 长的 2 dp outline 点线 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="line">
    <size
        android:width="16dp"
        android:height="4dp" />
    <stroke
        android:width="2dp"
        android:color="@color/zm_outline"
        android:dashWidth="1.5dp"
        android:dashGap="2.5dp" />
</shape>
