<?xml version="1.0" encoding="utf-8"?>
<!-- 下拉菜单选项：主文字 16 sp + 次文字 14 sp（结存）+ 行尾“库存不足”标签 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:paddingStart="@dimen/base_space_4"
    android:paddingTop="@dimen/base_space_2"
    android:paddingEnd="@dimen/base_space_4"
    android:paddingBottom="@dimen/base_space_2">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/feed_dropdown_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textAppearance="@style/TextAppearance.Zmt.BodyLarge"
            android:textColor="?attr/colorOnSurface" />

        <TextView
            android:id="@+id/feed_dropdown_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Zmt.BodyMedium.Number"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:visibility="gone" />
    </LinearLayout>

    <com.zhimu.slmp.base.widget.StatusTagView
        android:id="@+id/feed_dropdown_tag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/base_space_3"
        android:visibility="gone" />
</LinearLayout>
