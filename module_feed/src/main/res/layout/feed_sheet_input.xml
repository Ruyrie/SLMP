<?xml version="1.0" encoding="utf-8"?>
<!-- 单个数字输入的底部面板内容（G03 投喂异常判定、G05 称重周期）：描边输入框 + 辅助文字 + 可选文字按钮 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/base_sheet_padding_horizontal"
    android:paddingTop="@dimen/base_space_2"
    android:paddingEnd="@dimen/base_sheet_padding_horizontal">

    <com.zhimu.slmp.base.widget.ZmtTextInputLayout
        android:id="@+id/feed_sheet_layout"
        style="@style/Widget.Zmt.TextInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:errorIconDrawable="@null"
        app:helperTextEnabled="true">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/feed_sheet_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:digits="0123456789."
            android:inputType="numberDecimal"
            android:maxLength="5"
            android:textAppearance="@style/TextAppearance.Zmt.BodyLarge.Number" />
    </com.zhimu.slmp.base.widget.ZmtTextInputLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/feed_sheet_text_action"
        style="@style/Widget.Zmt.Button.Text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/base_space_1" />
</LinearLayout>
