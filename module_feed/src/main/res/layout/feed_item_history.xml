<?xml version="1.0" encoding="utf-8"?>
<!-- G03 修改记录一行：修改内容 14 sp on-surface + “修改人 · 日期 时间”12 sp on-surface-variant -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="56dp"
    android:orientation="vertical"
    android:paddingStart="@dimen/base_sheet_padding_horizontal"
    android:paddingTop="@dimen/base_space_2"
    android:paddingEnd="@dimen/base_sheet_padding_horizontal"
    android:paddingBottom="@dimen/base_space_2">

    <TextView
        android:id="@+id/feed_history_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.Zmt.BodyMedium.Number"
        android:textColor="?attr/colorOnSurface" />

    <TextView
        android:id="@+id/feed_history_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textAppearance="@style/TextAppearance.Zmt.BodySmall.Number"
        android:textColor="?attr/colorOnSurfaceVariant" />
</LinearLayout>
