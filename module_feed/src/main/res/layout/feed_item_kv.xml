<?xml version="1.0" encoding="utf-8"?>
<!-- 只读“标签—值”行：标签 14 sp on-surface-variant，值 14 sp on-surface 右对齐，行高 36 dp -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="36dp"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/feed_kv_key"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.Zmt.BodyMedium"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <TextView
        android:id="@+id/feed_kv_value"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/base_space_4"
        android:layout_weight="1"
        android:gravity="end"
        android:textAppearance="@style/TextAppearance.Zmt.BodyMedium.Number"
        android:textColor="?attr/colorOnSurface" />
</LinearLayout>
