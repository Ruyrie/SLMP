<?xml version="1.0" encoding="utf-8"?>
<!--
    G02 登记投喂：任务信息卡 → 饲料（库存不足标签 + 结存）→ 计划量 / 实际投喂量 → 计划量来源与偏差 → 投喂异常横幅 →
    实际执行人（只对所有者、场长显示）→ 备注 → 出库说明（超结存时为错误横幅）；底部“确认投喂”。
    修改模式标题“修改投喂”、按钮“保存修改”；只读状态为“标签—值”卡片，养殖户非当天记录底部“提交修改申请 需审核”。
-->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

        <variable
            name="vm"
            type="com.zhimu.slmp.feed.ui.register.FeedRegisterViewModel" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/colorSurface"
        android:orientation="vertical">

        <include
            android:id="@+id/feed_top_bar"
            layout="@layout/base_include_top_app_bar" />

        <com.zhimu.slmp.base.widget.StateLayout
            android:id="@+id/feed_state"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            app:stateErrorTitle="@string/feed_register_error_title"
            app:stateNoPermissionTitle="@string/feed_no_pen_permission_title"
            app:stateSkeletonLayout="@layout/base_skeleton_detail">

            <androidx.core.widget.NestedScrollView
                android:id="@+id/feed_scroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <LinearLayout
                    android:id="@+id/feed_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:animateLayoutChanges="true"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/base_page_margin"
                    android:paddingTop="@dimen/base_space_5"
                    android:paddingEnd="@dimen/base_page_margin"
                    android:paddingBottom="@dimen/base_space_6">

                    <com.zhimu.slmp.base.widget.ListRowView
                        android:id="@+id/feed_reg_task_card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="98dp"
                        app:leadingTone="secondary"
                        app:rowLeadingIcon="@drawable/ic_rice_bowl" />

                    <com.zhimu.slmp.base.widget.NoticeView
                        android:id="@+id/feed_reg_block"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/base_space_5"
                        android:visibility="gone"
                        app:noticeLevel="error" />

                    <com.zhimu.slmp.base.widget.NoticeView
                        android:id="@+id/feed_reg_readonly_notice"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/base_space_4"
                        android:visibility="gone"
                        app:noticeLevel="normal" />

                    <!-- 新增 / 修改表单 -->
                    <LinearLayout
                        android:id="@+id/feed_reg_form"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:animateLayoutChanges="true"
                        android:orientation="vertical">

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/base_space_5">

                            <com.zhimu.slmp.base.widget.ZmtTextInputLayout
                                android:id="@+id/feed_reg_feed_layout"
                                style="@style/Widget.Zmt.TextInputLayout.Dropdown"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="@string/feed_field_feed"
                                app:feedError="@{vm.fieldErrors[`feed_id`]}"
                                app:helperText="@{vm.stockHint}"
                                app:helperTextEnabled="true">

                                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                                    android:id="@+id/feed_reg_feed_input"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:inputType="none"
                                    android:paddingEnd="96dp" />
                            </com.zhimu.slmp.base.widget.ZmtTextInputLayout>

                            <com.zhimu.slmp.base.widget.StatusTagView
                                android:id="@+id/feed_reg_low_stock"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="top|end"
                                android:layout_marginTop="21dp"
                                android:layout_marginEnd="48dp"
                                android:text="@string/feed_tag_low_stock"
                                android:visibility="gone"
                                app:tagType="warning" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/base_space_5"
                            android:baselineAligned="false"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:id="@+id/feed_reg_plan_box"
                                android:layout_width="0dp"
                                android:layout_height="56dp"
                                android:layout_marginTop="5dp"
                                android:layout_weight="200"
                                android:background="@drawable/feed_bg_readonly_field"
                                android:gravity="center_vertical"
                                android:orientation="vertical"
                                android:paddingStart="@dimen/base_space_4"
                                android:paddingEnd="@dimen/base_space_4">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/feed_field_plan_qty"
                                    android:textAppearance="@style/TextAppearance.Zmt.BodySmall"
                                    android:textColor="?attr/colorOnSurfaceVariant" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@{vm.planText}"
                                    android:textAppearance="@style/TextAppearance.Zmt.BodyLarge.Number"
                                    android:textColor="?attr/colorOnSurface" />
                            </LinearLayout>

                            <com.zhimu.slmp.base.widget.ZmtTextInputLayout
                                android:id="@+id/feed_reg_actual_layout"
                                style="@style/Widget.Zmt.TextInputLayout"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/base_space_3"
                                android:layout_weight="168"
                                android:hint="@string/feed_field_actual_qty"
                                app:errorIconDrawable="@null"
                                app:feedError="@{vm.stockError != null ? vm.stockError : vm.fieldErrors[`actual_qty`]}"
                                app:suffixText="@string/feed_unit_kg">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/feed_reg_actual_input"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:digits="0123456789."
                                    android:imeOptions="actionNext"
                                    android:inputType="numberDecimal"
                                    android:maxLength="7"
                                    android:text="@={vm.actualQty}"
                                    android:textAppearance="@style/TextAppearance.Zmt.BodyLarge.Number" />
                            </com.zhimu.slmp.base.widget.ZmtTextInputLayout>
                        </LinearLayout>

                        <TextView
                            android:id="@+id/feed_reg_plan_source"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/base_space_4"
                            android:layout_marginTop="@dimen/base_space_1"
                            android:text="@{vm.planSourceText}"
                            android:textAppearance="@style/TextAppearance.Zmt.BodySmall.Number"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                        <com.zhimu.slmp.base.widget.NoticeView
                            android:id="@+id/feed_reg_abnormal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/base_space_5"
                            app:goneIfNull="@{vm.abnormalText}"
                            app:noticeIcon="@drawable/ic_warning"
                            app:noticeLevel="warning"
                            app:noticeText="@{vm.abnormalText}"
                            app:noticeTitle="@{@string/feed_register_abnormal_title}" />

                        <com.zhimu.slmp.base.widget.ZmtTextInputLayout
                            android:id="@+id/feed_reg_executor_layout"
                            style="@style/Widget.Zmt.TextInputLayout.Dropdown"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/base_space_5"
                            android:hint="@string/feed_field_executor"
                            app:feedError="@{vm.fieldErrors[`executor_id`]}"
                            app:helperText="@{vm.proxyHint}"
                            app:helperTextEnabled="true"
                            app:visibleIf="@{vm.executorVisible}">

                            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                                android:id="@+id/feed_reg_executor_input"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="none" />
                        </com.zhimu.slmp.base.widget.ZmtTextInputLayout>

                        <com.zhimu.slmp.base.widget.ZmtTextInputLayout
                            android:id="@+id/feed_reg_remark_layout"
                            style="@style/Widget.Zmt.TextInputLayout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/base_space_5"
                            android:hint="@string/feed_field_remark"
                            app:counterEnabled="false"
                            app:counterMaxLength="100"
                            app:feedError="@{vm.fieldErrors[`remark`]}">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/feed_reg_remark_input"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="textMultiLine"
                                android:maxLength="100"
                                android:maxLines="3"
                                android:text="@={vm.remark}" />
                        </com.zhimu.slmp.base.widget.ZmtTextInputLayout>

                        <TextView
                            android:id="@+id/feed_reg_recorder"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/base_space_4"
                            android:layout_marginTop="@dimen/base_space_1"
                            android:text="@{vm.proxyHint}"
                            android:textAppearance="@style/TextAppearance.Zmt.BodySmall"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            app:visibleIf="@{!safeUnbox(vm.executorVisible)}" />

                        <com.zhimu.slmp.base.widget.NoticeView
                            android:id="@+id/feed_reg_outbound"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/base_space_5"
                            android:text="@{vm.outboundText}"
                            app:noticeIcon="@drawable/ic_inventory_2"
                            app:noticeLevel="normal"
                            app:visibleIf="@{vm.outboundError == null}" />

                        <com.zhimu.slmp.base.widget.NoticeView
                            android:id="@+id/feed_reg_outbound_error"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/base_space_5"
                            app:goneIfNull="@{vm.outboundError}"
                            app:noticeLevel="error"
                            app:noticeText="@{vm.outboundError}"
                            app:noticeTitle="@{@string/feed_register_stock_error_title}" />
                    </LinearLayout>

                    <!-- 只读：标签—值卡片 -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/feed_reg_readonly_card"
                        style="@style/Widget.Zmt.Card.Summary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/base_space_4"
                        android:visibility="gone">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <LinearLayout
                                android:id="@+id/feed_reg_readonly_head"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="end"
                                android:orientation="horizontal">

                                <com.zhimu.slmp.base.widget.StatusTagView
                                    android:id="@+id/feed_reg_readonly_tag"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/feed_tag_abnormal"
                                    android:visibility="gone"
                                    app:tagType="warning" />
                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/feed_reg_readonly_rows"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>
        </com.zhimu.slmp.base.widget.StateLayout>

        <com.zhimu.slmp.base.widget.BottomActionBar
            android:id="@+id/feed_action_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>
</layout>
