<?xml version="1.0" encoding="utf-8"?>
<!-- G01 餐次分组标题“早餐 · 07:00”：14 sp Medium primary，上方 16 dp、下方 12 dp -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/base_page_margin"
    android:paddingTop="@dimen/base_space_4"
    android:paddingEnd="@dimen/base_page_margin"
    android:paddingBottom="@dimen/base_space_3">

    <TextView
        android:id="@+id/feed_meal_header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:accessibilityHeading="true"
        android:textAppearance="@style/TextAppearance.Zmt.TitleSmall"
        android:textColor="?attr/colorPrimary" />
</FrameLayout>
