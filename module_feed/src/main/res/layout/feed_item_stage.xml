<?xml version="1.0" encoding="utf-8"?>
<!--
    G03 阶段卡（白底、圆角 20、内边距 16）：标题行（阶段名 + 日龄范围 + “当前阶段”/“已结束”标签或 chevron）。
    收起：摘要“育肥全价料 · 每头 2.8 千克 · 3 餐”+“10月24日进入，次日起自动换用”；
    展开：饲料下拉（库存不足标签）→ 每头日投喂量（品种标准参考）与餐次 → 投喂时间 Chip → 分隔线 → 汇总行。
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/feed_stage_card"
    style="@style/Widget.Zmt.Card.Summary"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/base_space_2">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="24dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/feed_stage_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Zmt.TitleMedium"
                android:textColor="?attr/colorOnSurface" />

            <TextView
                android:id="@+id/feed_stage_range"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/base_space_2"
                android:layout_weight="1"
                android:textAppearance="@style/TextAppearance.Zmt.BodyMedium.Number"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <com.zhimu.slmp.base.widget.StatusTagView
                android:id="@+id/feed_stage_tag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/feed_stage_chevron"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_chevron_right"
                android:visibility="gone"
                app:tint="?attr/colorOnSurface" />
        </LinearLayout>

        <TextView
            android:id="@+id/feed_stage_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/base_space_1"
            android:textAppearance="@style/TextAppearance.Zmt.BodyMedium.Number"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:visibility="gone" />

        <TextView
            android:id="@+id/feed_stage_enter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Zmt.BodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/feed_stage_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/base_space_4">

                <com.zhimu.slmp.base.widget.ZmtTextInputLayout
                    android:id="@+id/feed_stage_feed_layout"
                    style="@style/Widget.Zmt.TextInputLayout.Dropdown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/feed_field_feed">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/feed_stage_feed_input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none"
                        android:paddingEnd="96dp" />
                </com.zhimu.slmp.base.widget.ZmtTextInputLayout>

                <com.zhimu.slmp.base.widget.StatusTagView
                    android:id="@+id/feed_stage_low_stock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="21dp"
                    android:layout_marginEnd="48dp"
                    android:text="@string/feed_tag_low_stock"
                    android:visibility="gone"
                    app:tagType="warning" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/base_space_4"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.zhimu.slmp.base.widget.ZmtTextInputLayout
                    android:id="@+id/feed_stage_qty_layout"
                    style="@style/Widget.Zmt.TextInputLayout"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="@string/feed_plan_field_daily_qty"
                    app:errorIconDrawable="@null"
                    app:helperTextEnabled="true"
                    app:suffixText="@string/feed_unit_kg">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/feed_stage_qty_input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:digits="0123456789."
                        android:inputType="numberDecimal"
                        android:maxLength="6"
                        android:textAppearance="@style/TextAppearance.Zmt.BodyLarge.Number" />
                </com.zhimu.slmp.base.widget.ZmtTextInputLayout>

                <com.zhimu.slmp.base.widget.ZmtTextInputLayout
                    android:id="@+id/feed_stage_meals_layout"
                    style="@style/Widget.Zmt.TextInputLayout.Dropdown"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/base_space_3"
                    android:layout_weight="1"
                    android:hint="@string/feed_plan_field_meals">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/feed_stage_meals_input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none" />
                </com.zhimu.slmp.base.widget.ZmtTextInputLayout>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/base_space_4"
                android:text="@string/feed_plan_meal_times"
                android:textAppearance="@style/TextAppearance.Zmt.BodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/feed_stage_times"
                style="@style/Widget.Zmt.ChipGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/base_space_2" />

            <TextView
                android:id="@+id/feed_stage_time_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/base_space_1"
                android:textAppearance="@style/TextAppearance.Zmt.BodySmall"
                android:textColor="?attr/colorError"
                android:visibility="gone" />

            <com.google.android.material.divider.MaterialDivider
                style="@style/Widget.Zmt.Divider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/base_space_4" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/base_space_4"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/feed_stage_sum_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textAppearance="@style/TextAppearance.Zmt.BodyMedium.Number"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <TextView
                    android:id="@+id/feed_stage_sum_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/base_space_3"
                    android:gravity="end"
                    android:textAppearance="@style/TextAppearance.Zmt.BodyMedium.Number"
                    android:textColor="?attr/colorOnSurface" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
