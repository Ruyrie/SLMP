<?xml version="1.0" encoding="utf-8"?>
<!-- G05 逐头录入一行（56 dp）：“第 1 头”（宽 64 dp）+ 体重输入框（单位“千克”）+ close 20 dp（48 dp 点击区）删除这一行 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/base_space_2"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/feed_weigh_row_label"
        android:layout_width="64dp"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.Zmt.BodyMedium.Number"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <com.zhimu.slmp.base.widget.ZmtTextInputLayout
        android:id="@+id/feed_weigh_row_layout"
        style="@style/Widget.Zmt.TextInputLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        app:errorIconDrawable="@null"
        app:hintEnabled="false"
        app:suffixText="@string/feed_unit_kg">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/feed_weigh_row_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:digits="0123456789."
            android:imeOptions="actionNext"
            android:inputType="numberDecimal"
            android:maxLength="6"
            android:textAppearance="@style/TextAppearance.Zmt.BodyLarge.Number" />
    </com.zhimu.slmp.base.widget.ZmtTextInputLayout>

    <ImageButton
        android:id="@+id/feed_weigh_row_delete"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/feed_weigh_item_delete"
        android:src="@drawable/ic_close"
        app:tint="?attr/colorOnSurfaceVariant" />
</LinearLayout>
