# 复制为 local.properties 后按本机情况填写（local.properties 不提交到代码仓库）
sdk.dir=D\:\androidsdk

# 服务端地址（Nginx 的 HTTPS 域名，末尾带 /）
zmt.baseUrl=https://api.zhimutong.example.com/
# true：debug 版由 MockInterceptor 返回 assets/mock 下的示例数据；服务端就绪后改为 false
zmt.useMock=true
# Mock 模式下的“今天”（与示例数据一致，只在 debug 包生效）；留空则用真实日期
zmt.mockToday=2026-10-19
# 高德 Android Key（绑定包名与签名 SHA1）：amap.key 用于 com.zhimu.slmp.debug，amap.releaseKey 用于 com.zhimu.slmp
# 两种构建分别读取各自的 Key，未配置时地图不可用
amap.key=
amap.releaseKey=
# 极光 AppKey（绑定包名）：jpush.appKey 用于 debug 包 com.zhimu.slmp.debug，jpush.releaseAppKey 用于 release 包 com.zhimu.slmp；为空时不初始化推送
jpush.appKey=
jpush.releaseAppKey=

# 测试直连（只进 debug 包，release 为空；为空时走 Mock 或服务端）
# 百炼（千问）Key、对话模型、语音识别模型（为空用代码默认值）
ai.dashscopeKey=
ai.dashscopeModel=qwen3.8-max
ai.dashscopeAsrModel=
# DeepSeek 备用
ai.deepseekKey=
ai.deepseekModel=deepseek-flash
# 阿里云号码认证短信（Dypnsapi）
aliyun.accessKeyId=
aliyun.accessKeySecret=
aliyun.smsSignName=

# 正式签名（只在负责发布的组员电脑上填写）
# release.storeFile=
# release.storePassword=
# release.keyAlias=
# release.keyPassword=
