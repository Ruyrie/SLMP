<?xml version="1.0" encoding="utf-8"?>
<!-- 修改记录面板骨架屏：与列表同结构的 3 项（无前置图标，主文字条 + 两条辅助文字条），左右 24 dp -->
<com.zhimu.slmp.base.widget.GroupedListLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:importantForAccessibility="noHideDescendants"
    android:paddingStart="@dimen/base_sheet_padding_horizontal"
    android:paddingEnd="@dimen/base_sheet_padding_horizontal"
    android:paddingBottom="@dimen/base_space_6">

    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.Zmt.Card.ListItem"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/base_list_item_two_line_min_height"
            android:orientation="vertical"
            android:padding="@dimen/base_space_4">

            <com.zhimu.slmp.base.widget.SkeletonView
                android:layout_width="160dp"
                android:layout_height="20dp" />

            <com.zhimu.slmp.base.widget.SkeletonView
                android:layout_width="220dp"
                android:layout_height="16dp"
                android:layout_marginTop="@dimen/base_space_2" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.Zmt.Card.ListItem"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/base_list_item_two_line_min_height"
            android:orientation="vertical"
            android:padding="@dimen/base_space_4">

            <com.zhimu.slmp.base.widget.SkeletonView
                android:layout_width="140dp"
                android:layout_height="20dp" />

            <com.zhimu.slmp.base.widget.SkeletonView
                android:layout_width="200dp"
                android:layout_height="16dp"
                android:layout_marginTop="@dimen/base_space_2" />

            <com.zhimu.slmp.base.widget.SkeletonView
                android:layout_width="120dp"
                android:layout_height="16dp"
                android:layout_marginTop="@dimen/base_space_2" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.Zmt.Card.ListItem"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/base_list_item_two_line_min_height"
            android:orientation="vertical"
            android:padding="@dimen/base_space_4">

            <com.zhimu.slmp.base.widget.SkeletonView
                android:layout_width="160dp"
                android:layout_height="20dp" />

            <com.zhimu.slmp.base.widget.SkeletonView
                android:layout_width="180dp"
                android:layout_height="16dp"
                android:layout_marginTop="@dimen/base_space_2" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</com.zhimu.slmp.base.widget.GroupedListLayout>
