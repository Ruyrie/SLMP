<?xml version="1.0" encoding="utf-8"?>
<!-- 网络安全配置（03 号文档 6.1 节）：禁止明文 HTTP；debug 版额外信任用户安装的证书以便抓包 -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <debug-overrides>
        <trust-anchors>
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
