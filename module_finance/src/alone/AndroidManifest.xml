<?xml version="1.0" encoding="utf-8"?>
<!-- 单独运行（gradle.properties 中 runAlone.module_finance=true）时合并到 debug 清单 -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:name="com.zhimu.slmp.finance.alone.FinanceAloneApp"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@android:mipmap/sym_def_app_icon"
        android:label="收支、出栏、行情与报表（单独运行）"
        android:networkSecurityConfig="@xml/common_core_network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Zmt">

        <activity
            android:name="com.zhimu.slmp.common.app.AloneLauncherActivity"
            android:exported="true"
            tools:replace="android:exported">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 单独运行时承载 E01 经营页（壳工程中为 MainActivity 的“经营”标签） -->
        <activity
            android:name="com.zhimu.slmp.finance.alone.FinanceHostActivity"
            android:exported="false">
            <intent-filter>
                <action android:name="com.zhimu.slmp.page.E01" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>

</manifest>
