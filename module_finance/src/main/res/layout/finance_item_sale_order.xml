<?xml version="1.0" encoding="utf-8"?>
<!-- 出栏单卡片（E09 图 10-13、E14 补充设计）：E14 每月第一张前显示月份分组标题；卡片 5 行：批次号与标签、栏舍 · 收购商、
     约定收款 / 出栏信息、收款进度条、金额（E09 带“登记收款”） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/base_page_margin"
    android:paddingEnd="@dimen/base_page_margin"
    android:paddingBottom="@dimen/base_space_3">

    <LinearLayout
        android:id="@+id/finance_order_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="@dimen/base_space_2"
        android:paddingBottom="@dimen/base_space_2"
        android:visibility="gone">

        <TextView
            android:id="@+id/finance_order_header_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Zmt.TitleSmall"
            android:textColor="?attr/colorPrimary" />

        <TextView
            android:id="@+id/finance_order_header_amount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:textAppearance="@style/TextAppearance.Zmt.BodySmall"
            android:textColor="?attr/colorOnSurfaceVariant" />
    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/finance_order_card"
        style="@style/Widget.Zmt.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/base_space_4">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/finance_order_batch"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.Zmt.BodyLarge.Number"
                    android:textColor="?attr/colorOnSurface" />

                <com.zhimu.slmp.base.widget.StatusTagView
                    android:id="@+id/finance_order_pending"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/base_space_2"
                    android:contentDescription="@string/finance_cd_pending"
                    android:text="@string/finance_card_pending"
                    android:visibility="gone"
                    app:tagIcon="@drawable/ic_edit_note"
                    app:tagType="warning" />

                <com.zhimu.slmp.base.widget.StatusTagView
                    android:id="@+id/finance_order_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <TextView
                android:id="@+id/finance_order_pen"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.Zmt.BodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/base_space_2"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/finance_order_line"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.Zmt.BodyMedium"
                    android:textColor="?attr/colorOnSurface" />

                <TextView
                    android:id="@+id/finance_order_overdue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawablePadding="2dp"
                    android:gravity="center_vertical"
                    android:textAppearance="@style/TextAppearance.Zmt.LabelMedium"
                    android:textColor="?attr/colorError"
                    android:visibility="gone"
                    app:drawableStartCompat="@drawable/ic_schedule"
                    app:drawableTint="?attr/colorError" />
            </LinearLayout>

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/finance_order_progress"
                style="@style/Widget.Zmt.LinearProgressIndicator"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/base_space_3"
                android:max="1000" />

            <LinearLayout
                android:id="@+id/finance_order_amounts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/base_space_3"
                android:baselineAligned="false"
                android:gravity="bottom"
                android:orientation="horizontal" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
