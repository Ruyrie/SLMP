<?xml version="1.0" encoding="utf-8"?>
<!-- E07 出栏单详情（图 10-10、10-11）：摘要卡（批次号、状态、销售金额、进度、约定收款）、收款记录、修改规则 / 待审核横幅、
     出栏信息；底部“查看批次核算”“登记收款” -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:orientation="vertical">

    <include
        android:id="@+id/finance_top_bar"
        layout="@layout/base_include_top_app_bar" />

    <com.zhimu.slmp.base.widget.StateLayout
        android:id="@+id/finance_state"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        app:stateErrorTitle="@string/finance_error_title"
        app:stateNoPermissionTitle="@string/finance_no_permission_title"
        app:stateSkeletonLayout="@layout/base_skeleton_detail">

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/finance_refresh"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.core.widget.NestedScrollView
                android:id="@+id/finance_scroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/base_page_margin"
                    android:paddingTop="@dimen/base_space_2"
                    android:paddingEnd="@dimen/base_page_margin"
                    android:paddingBottom="@dimen/base_space_4">

                    <com.google.android.material.card.MaterialCardView
                        style="@style/Widget.Zmt.Card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="@dimen/base_space_4">

                            <TextView
                                android:id="@+id/finance_batch_no"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textAppearance="@style/TextAppearance.Zmt.TitleLarge.Number"
                                android:textColor="?attr/colorOnSurface" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/base_space_2"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <com.zhimu.slmp.base.widget.StatusTagView
                                    android:id="@+id/finance_pay_tag"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content" />

                                <TextView
                                    android:id="@+id/finance_pen_date"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="@dimen/base_space_2"
                                    android:layout_weight="1"
                                    android:maxLines="1"
                                    android:textAppearance="@style/TextAppearance.Zmt.BodyMedium"
                                    android:textColor="?attr/colorOnSurfaceVariant" />
                            </LinearLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/base_space_4"
                                android:text="@string/finance_e07_sale_amount"
                                android:textAppearance="@style/TextAppearance.Zmt.BodyMedium"
                                android:textColor="?attr/colorOnSurfaceVariant" />

                            <TextView
                                android:id="@+id/finance_sale_amount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textAppearance="@style/TextAppearance.Zmt.DisplaySmall.Number"
                                android:textColor="?attr/colorOnSurface" />

                            <TextView
                                android:id="@+id/finance_amount_note"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textAppearance="@style/TextAppearance.Zmt.BodyMedium"
                                android:textColor="?attr/colorOnSurfaceVariant" />

                            <com.google.android.material.progressindicator.LinearProgressIndicator
                                android:id="@+id/finance_progress"
                                style="@style/Widget.Zmt.LinearProgressIndicator"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/base_space_4"
                                android:max="1000" />

                            <LinearLayout
                                android:id="@+id/finance_paid_row"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/base_space_2"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/finance_received"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:textAppearance="@style/TextAppearance.Zmt.BodyMedium.Number"
                                    android:textColor="?attr/colorOnSurface" />

                                <TextView
                                    android:id="@+id/finance_unpaid"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textAppearance="@style/TextAppearance.Zmt.BodyMedium.Number"
                                    android:textColor="?attr/colorOnSurface" />
                            </LinearLayout>

                            <com.google.android.material.divider.MaterialDivider
                                android:id="@+id/finance_due_divider"
                                style="@style/Widget.Zmt.Divider"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/base_space_3"
                                android:layout_marginBottom="@dimen/base_space_3" />

                            <LinearLayout
                                android:id="@+id/finance_due_row"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/finance_due"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:drawablePadding="8dp"
                                    android:gravity="center_vertical"
                                    android:textAppearance="@style/TextAppearance.Zmt.BodyMedium"
                                    android:textColor="?attr/colorOnSurface"
                                    app:drawableStartCompat="@drawable/finance_ic_event"
                                    app:drawableTint="?attr/colorOnSurfaceVariant" />

                                <com.zhimu.slmp.base.widget.StatusTagView
                                    android:id="@+id/finance_due_tag"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:visibility="gone" />
                            </LinearLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.zhimu.slmp.base.widget.SectionHeaderView
                        android:id="@+id/finance_receipts_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/base_section_gap" />

                    <com.zhimu.slmp.base.widget.GroupedListLayout
                        android:id="@+id/finance_receipts"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:id="@+id/finance_receipts_empty"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/finance_e07_receipts_empty"
                        android:textAppearance="@style/TextAppearance.Zmt.BodyMedium"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:visibility="gone" />

                    <com.zhimu.slmp.base.widget.NoticeView
                        android:id="@+id/finance_change_notice"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/base_space_4"
                        android:visibility="gone"
                        app:noticeIcon="@drawable/ic_info" />

                    <com.zhimu.slmp.base.widget.SectionHeaderView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/base_section_gap"
                        app:sectionTitle="@string/finance_e07_info" />

                    <com.zhimu.slmp.base.widget.GroupedListLayout
                        android:id="@+id/finance_info"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
    </com.zhimu.slmp.base.widget.StateLayout>

    <com.zhimu.slmp.base.widget.BottomActionBar
        android:id="@+id/finance_bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:tag="snackbar_anchor"
        app:barPrimaryIcon="@drawable/ic_add"
        app:barPrimaryText="@string/finance_e07_receive"
        app:barSecondaryText="@string/finance_e07_settlement" />
</LinearLayout>
