<?xml version="1.0" encoding="utf-8"?>
<!-- 分页列表底部：24 dp 圆形进度、“没有更多记录了”或“加载失败，点按重试” -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="56dp"
    android:paddingTop="@dimen/base_space_3"
    android:paddingBottom="@dimen/base_space_6">

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/finance_footer_progress"
        style="@style/Widget.Zmt.CircularProgressIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:indeterminate="true"
        app:indicatorSize="24dp" />

    <TextView
        android:id="@+id/finance_footer_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="@string/finance_list_end"
        android:textAppearance="@style/TextAppearance.Zmt.BodySmall"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:visibility="gone" />
</FrameLayout>
