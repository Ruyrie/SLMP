<?xml version="1.0" encoding="utf-8"?>
<!-- AI 卡内的键值（键固定 36 dp 宽、值可换行；E12 理由、E13 摘要三段）或带前置图标的风险行 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingTop="6dp">

    <TextView
        android:id="@+id/finance_kv_key"
        android:layout_width="36dp"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.Zmt.BodyMedium"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <TextView
        android:id="@+id/finance_kv_value"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/base_space_2"
        android:layout_weight="1"
        android:lineSpacingExtra="2dp"
        android:textAppearance="@style/TextAppearance.Zmt.BodyMedium"
        android:textColor="?attr/colorOnSurface" />
</LinearLayout>
