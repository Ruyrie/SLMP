<?xml version="1.0" encoding="utf-8"?>
<!-- E02 收支记账（图 10-2、10-3）：视角切换、月份行、结余重点卡、收入 / 支出卡、分类占比卡（当前养殖场）或按养殖场拆分（合计）、
     收支流水入口、扩展 FAB“记一笔” -->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <include
            android:id="@+id/finance_top_bar"
            layout="@layout/base_include_top_app_bar" />

        <com.zhimu.slmp.base.widget.StateLayout
            android:id="@+id/finance_state"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            app:stateErrorTitle="@string/finance_error_title"
            app:stateNoPermissionTitle="@string/finance_no_permission_title"
            app:stateSkeletonLayout="@layout/base_skeleton_detail">

            <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
                android:id="@+id/finance_refresh"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <androidx.core.widget.NestedScrollView
                    android:id="@+id/finance_scroll"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="@dimen/base_page_margin"
                        android:paddingTop="@dimen/base_space_1"
                        android:paddingEnd="@dimen/base_page_margin"
                        android:paddingBottom="@dimen/base_fab_list_bottom_space">

                        <com.zhimu.slmp.base.widget.ConnectedButtonGroup
                            android:id="@+id/finance_scope_group"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:visibility="gone"
                            app:checkedButton="@id/finance_scope_farm"
                            app:selectionRequired="true"
                            app:singleSelection="true">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/finance_scope_farm"
                                style="@style/Widget.Zmt.Button.Connected"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/finance_scope_all"
                                style="@style/Widget.Zmt.Button.Connected"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/finance_e02_all_farms" />
                        </com.zhimu.slmp.base.widget.ConnectedButtonGroup>

                        <com.zhimu.slmp.base.widget.NoticeView
                            android:id="@+id/finance_all_notice"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/base_space_3"
                            android:visibility="gone"
                            app:noticeIcon="@drawable/ic_info" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="@dimen/base_space_1"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageButton
                                android:id="@+id/finance_month_prev"
                                style="@style/Widget.Zmt.Button.Icon"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:contentDescription="@string/finance_cd_prev_month"
                                android:src="@drawable/ic_chevron_left" />

                            <TextView
                                android:id="@+id/finance_month"
                                android:layout_width="wrap_content"
                                android:layout_height="40dp"
                                android:background="?attr/selectableItemBackground"
                                android:gravity="center"
                                android:paddingStart="@dimen/base_space_1"
                                android:paddingEnd="@dimen/base_space_1"
                                android:textAppearance="@style/TextAppearance.Zmt.BodyLarge"
                                android:textColor="?attr/colorOnSurface" />

                            <ImageButton
                                android:id="@+id/finance_month_next"
                                style="@style/Widget.Zmt.Button.Icon"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:contentDescription="@string/finance_cd_next_month"
                                android:src="@drawable/ic_chevron_right" />

                            <TextView
                                android:id="@+id/finance_period_note"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="end"
                                android:maxLines="1"
                                android:textAppearance="@style/TextAppearance.Zmt.BodySmall"
                                android:textColor="?attr/colorOnSurfaceVariant" />
                        </LinearLayout>

                        <com.zhimu.slmp.base.widget.StatCardView
                            android:id="@+id/finance_card_balance"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:statEmphasis="true"
                            app:statIcon="@drawable/finance_ic_savings"
                            app:statLabel="@string/finance_e02_balance"
                            app:statSize="large"
                            app:statUnit="@string/finance_unit_yuan" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/base_space_2"
                            android:baselineAligned="false"
                            android:orientation="horizontal">

                            <com.zhimu.slmp.base.widget.StatCardView
                                android:id="@+id/finance_card_income"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                app:statIcon="@drawable/finance_ic_south_west"
                                app:statLabel="@string/finance_e02_income"
                                app:statUnit="@string/finance_unit_yuan" />

                            <com.zhimu.slmp.base.widget.StatCardView
                                android:id="@+id/finance_card_expense"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/base_space_2"
                                android:layout_weight="1"
                                app:statIcon="@drawable/finance_ic_north_east"
                                app:statLabel="@string/finance_e02_expense"
                                app:statUnit="@string/finance_unit_yuan" />
                        </LinearLayout>

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/finance_share_card"
                            style="@style/Widget.Zmt.Card"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/base_space_2">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="@dimen/base_space_4">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/finance_e02_share"
                                        android:textAppearance="@style/TextAppearance.Zmt.TitleMedium"
                                        android:textColor="?attr/colorOnSurface" />

                                    <TextView
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="@dimen/base_space_2"
                                        android:layout_weight="1"
                                        android:text="@string/finance_e02_share_unit"
                                        android:textAppearance="@style/TextAppearance.Zmt.BodySmall"
                                        android:textColor="?attr/colorOnSurfaceVariant" />

                                    <com.google.android.material.chip.ChipGroup
                                        android:id="@+id/finance_share_direction"
                                        style="@style/Widget.Zmt.ChipGroup"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        app:selectionRequired="true"
                                        app:singleLine="true"
                                        app:singleSelection="true" />
                                </LinearLayout>

                                <LinearLayout
                                    android:id="@+id/finance_share_content"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/base_space_4"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <com.zhimu.slmp.finance.widget.CategoryDonutView
                                        android:id="@+id/finance_donut"
                                        android:layout_width="120dp"
                                        android:layout_height="120dp"
                                        android:layout_marginStart="@dimen/base_space_2" />

                                    <LinearLayout
                                        android:id="@+id/finance_legend"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="@dimen/base_space_6"
                                        android:layout_weight="1"
                                        android:orientation="vertical" />
                                </LinearLayout>

                                <TextView
                                    android:id="@+id/finance_share_empty"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/base_space_4"
                                    android:gravity="center"
                                    android:paddingBottom="@dimen/base_space_4"
                                    android:textAppearance="@style/TextAppearance.Zmt.BodyMedium"
                                    android:textColor="?attr/colorOnSurfaceVariant"
                                    android:visibility="gone" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <LinearLayout
                            android:id="@+id/finance_farms_header"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/base_section_gap"
                            android:layout_marginBottom="@dimen/base_section_title_gap"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:visibility="gone">

                            <TextView
                                android:id="@+id/finance_farms_title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textAppearance="@style/TextAppearance.Zmt.TitleSmall"
                                android:textColor="?attr/colorPrimary" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="end"
                                android:text="@string/finance_e02_by_farm_note"
                                android:textAppearance="@style/TextAppearance.Zmt.BodySmall"
                                android:textColor="?attr/colorOnSurfaceVariant" />
                        </LinearLayout>

                        <com.zhimu.slmp.base.widget.GroupedListLayout
                            android:id="@+id/finance_farms"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:visibility="gone" />

                        <com.zhimu.slmp.base.widget.ListRowView
                            android:id="@+id/finance_records_entry"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/base_space_2"
                            app:leadingTone="neutral"
                            app:rowLeadingIcon="@drawable/ic_receipt_long"
                            app:rowShowChevron="true"
                            app:rowTitle="@string/finance_e02_records" />
                    </LinearLayout>
                </androidx.core.widget.NestedScrollView>
            </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
        </com.zhimu.slmp.base.widget.StateLayout>
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/finance_fab"
        style="@style/Widget.Zmt.ExtendedFloatingActionButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="@dimen/base_page_margin"
        android:text="@string/finance_e02_fab"
        app:icon="@drawable/ic_add" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>
