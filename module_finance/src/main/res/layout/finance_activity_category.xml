<?xml version="1.0" encoding="utf-8"?>
<!-- E05 支出分类（图 10-7）：规则横幅 + “一级分类 · 7 个” + 可展开的一级分类与子类（改名、删除、新增） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:orientation="vertical">

    <include
        android:id="@+id/finance_top_bar"
        layout="@layout/base_include_top_app_bar" />

    <com.zhimu.slmp.base.widget.StateLayout
        android:id="@+id/finance_state"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        app:stateErrorTitle="@string/finance_error_title"
        app:stateNoPermissionTitle="@string/finance_no_permission_title"
        app:stateSkeletonLayout="@layout/base_skeleton_list">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/finance_scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/base_page_margin"
                android:paddingTop="@dimen/base_space_1"
                android:paddingEnd="@dimen/base_page_margin"
                android:paddingBottom="@dimen/base_space_4">

                <com.zhimu.slmp.base.widget.NoticeView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:noticeIcon="@drawable/ic_info"
                    app:noticeText="@string/finance_e05_notice" />

                <com.zhimu.slmp.base.widget.SectionHeaderView
                    android:id="@+id/finance_group_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/base_section_gap" />

                <com.zhimu.slmp.base.widget.GroupedListLayout
                    android:id="@+id/finance_categories"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </com.zhimu.slmp.base.widget.StateLayout>
</LinearLayout>
