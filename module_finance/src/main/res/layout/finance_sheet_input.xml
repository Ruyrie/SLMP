<?xml version="1.0" encoding="utf-8"?>
<!-- 子类名称面板：一个输入框（标签由代码设置） -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/base_sheet_padding_horizontal"
    android:paddingEnd="@dimen/base_sheet_padding_horizontal"
    android:paddingBottom="@dimen/base_space_2">

    <com.zhimu.slmp.base.widget.ZmtTextInputLayout
        android:id="@+id/finance_input_layout"
        style="@style/Widget.Zmt.TextInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:counterEnabled="true"
        app:counterMaxLength="10">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/finance_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionDone"
            android:inputType="text"
            android:maxLines="1" />
    </com.zhimu.slmp.base.widget.ZmtTextInputLayout>
</FrameLayout>
