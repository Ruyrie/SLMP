<?xml version="1.0" encoding="utf-8"?>
<!-- E11 列表头部（图 10-15）：地区 / 品类 / 品种下拉 Chip、默认说明或“恢复默认”、出栏价 / 种苗价、价格卡（标题、最新价、涨跌、
     区间切换、折线图、区间统计）、“每日价格”分组标题 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/base_page_margin"
    android:paddingTop="@dimen/base_space_1"
    android:paddingEnd="@dimen/base_page_margin">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.google.android.material.chip.Chip
            android:id="@+id/finance_chip_province"
            style="@style/Widget.Zmt.Chip.Dropdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:chipIcon="@drawable/ic_location_on"
            app:chipIconVisible="true" />

        <com.google.android.material.chip.Chip
            android:id="@+id/finance_chip_category"
            style="@style/Widget.Zmt.Chip.Dropdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/base_space_2" />

        <com.google.android.material.chip.Chip
            android:id="@+id/finance_chip_breed"
            style="@style/Widget.Zmt.Chip.Dropdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/base_space_2" />
    </LinearLayout>

    <TextView
        android:id="@+id/finance_default_desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/base_space_1"
        android:textAppearance="@style/TextAppearance.Zmt.BodySmall"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/finance_reset"
        style="@style/Widget.Zmt.Button.Text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/finance_e11_reset"
        android:visibility="gone" />

    <com.zhimu.slmp.base.widget.ConnectedButtonGroup
        android:id="@+id/finance_type_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/base_space_3"
        app:checkedButton="@id/finance_type_slaughter"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/finance_type_slaughter"
            style="@style/Widget.Zmt.Button.Connected"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/finance_e11_slaughter" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/finance_type_seedling"
            style="@style/Widget.Zmt.Button.Connected"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/finance_e11_seedling" />
    </com.zhimu.slmp.base.widget.ConnectedButtonGroup>

    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.Zmt.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/base_space_3">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/base_space_4">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/finance_card_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.Zmt.BodyMedium"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <TextView
                    android:id="@+id/finance_updated"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Zmt.BodyMedium"
                    android:textColor="?attr/colorOnSurfaceVariant" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/finance_price_box"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/finance_latest"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/base_space_2"
                    android:textAppearance="@style/TextAppearance.Zmt.DisplaySmall.Number"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="45sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/finance_change"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.Zmt.BodyMedium" />

                    <TextView
                        android:id="@+id/finance_compare"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/base_space_2"
                        android:textAppearance="@style/TextAppearance.Zmt.BodyMedium"
                        android:textColor="?attr/colorOnSurfaceVariant" />
                </LinearLayout>

                <com.zhimu.slmp.base.widget.ConnectedButtonGroup
                    android:id="@+id/finance_range_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/base_space_3"
                    app:checkedButton="@id/finance_range_30"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/finance_range_7"
                        style="@style/Widget.Zmt.Button.Connected"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/finance_e11_range_7" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/finance_range_30"
                        style="@style/Widget.Zmt.Button.Connected"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/finance_e11_range_30" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/finance_range_90"
                        style="@style/Widget.Zmt.Button.Connected"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/finance_e11_range_90" />
                </com.zhimu.slmp.base.widget.ConnectedButtonGroup>

                <com.zhimu.slmp.finance.widget.PriceTrendChartView
                    android:id="@+id/finance_chart"
                    android:layout_width="match_parent"
                    android:layout_height="148dp"
                    android:layout_marginTop="@dimen/base_space_3" />

                <com.google.android.material.divider.MaterialDivider
                    style="@style/Widget.Zmt.Divider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/base_space_2" />

                <LinearLayout
                    android:id="@+id/finance_stats"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/base_space_3"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <include
                        android:id="@+id/finance_stat_max"
                        layout="@layout/finance_view_column" />

                    <include
                        android:id="@+id/finance_stat_min"
                        layout="@layout/finance_view_column" />

                    <include
                        android:id="@+id/finance_stat_avg"
                        layout="@layout/finance_view_column" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/finance_price_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingTop="@dimen/base_space_8"
                android:paddingBottom="@dimen/base_space_8"
                android:textAppearance="@style/TextAppearance.Zmt.BodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:visibility="gone" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.zhimu.slmp.base.widget.SectionHeaderView
        android:id="@+id/finance_daily_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/base_section_gap" />
</LinearLayout>
