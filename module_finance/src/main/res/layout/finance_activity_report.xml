<?xml version="1.0" encoding="utf-8"?>
<!-- E13 经营报表（图 10-17、10-18）：数据待核对横幅、报表类型、养殖场 / 范围 / 统计期、合计说明、AI 分析摘要、四项指标与趋势图、
     批次盈亏对比；顶部栏“导出表格”“导出文档”与分享 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:orientation="vertical">

    <include
        android:id="@+id/finance_top_bar"
        layout="@layout/base_include_top_app_bar" />

    <com.zhimu.slmp.base.widget.StateLayout
        android:id="@+id/finance_state"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        app:stateErrorTitle="@string/finance_error_title"
        app:stateNoPermissionTitle="@string/finance_no_permission_title"
        app:stateSkeletonLayout="@layout/base_skeleton_detail">

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/finance_refresh"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.core.widget.NestedScrollView
                android:id="@+id/finance_scroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/base_page_margin"
                    android:paddingTop="@dimen/base_space_1"
                    android:paddingEnd="@dimen/base_page_margin"
                    android:paddingBottom="@dimen/base_space_4">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/finance_check_card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/base_space_3"
                        android:visibility="gone"
                        app:cardBackgroundColor="?attr/colorWarningContainer"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="@dimen/base_space_4">

                            <TextView
                                android:id="@+id/finance_check_text"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:drawablePadding="12dp"
                                android:textAppearance="@style/TextAppearance.Zmt.BodyMedium"
                                android:textColor="?attr/colorOnWarningContainer"
                                app:drawableStartCompat="@drawable/ic_rule"
                                app:drawableTint="?attr/colorOnWarningContainer" />

                            <com.zhimu.slmp.base.widget.GroupedListLayout
                                android:id="@+id/finance_check_items"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="32dp"
                                android:layout_marginTop="@dimen/base_space_2" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/finance_check_action"
                                style="@style/Widget.Zmt.Button.Text"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="24dp"
                                android:text="@string/finance_e13_check_action"
                                android:textColor="?attr/colorOnWarningContainer" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.zhimu.slmp.base.widget.ConnectedButtonGroup
                        android:id="@+id/finance_type_group"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:checkedButton="@id/finance_type_to_date"
                        app:selectionRequired="true"
                        app:singleSelection="true">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/finance_type_weekly"
                            style="@style/Widget.Zmt.Button.Connected"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/finance_e13_weekly" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/finance_type_monthly"
                            style="@style/Widget.Zmt.Button.Connected"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/finance_e13_monthly" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/finance_type_to_date"
                            style="@style/Widget.Zmt.Button.Connected"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/finance_e13_to_date" />
                    </com.zhimu.slmp.base.widget.ConnectedButtonGroup>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/base_space_3"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/finance_chip_farm"
                            style="@style/Widget.Zmt.Chip.Dropdown"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:chipIcon="@drawable/ic_domain"
                            app:chipIconVisible="true" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/finance_chip_range"
                            style="@style/Widget.Zmt.Chip.Dropdown"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/base_space_2" />

                        <Space
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/finance_chip_period"
                            style="@style/Widget.Zmt.Chip.Dropdown"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/finance_period_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.Zmt.BodySmall"
                            android:textColor="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>

                    <com.zhimu.slmp.base.widget.NoticeView
                        android:id="@+id/finance_scope_notice"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/base_space_3"
                        android:visibility="gone"
                        app:noticeIcon="@drawable/ic_info" />

                    <com.zhimu.slmp.base.widget.NoticeView
                        android:id="@+id/finance_tip_notice"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/base_space_3"
                        android:visibility="gone"
                        app:noticeIcon="@drawable/ic_schedule" />

                    <TextView
                        android:id="@+id/finance_report_empty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:paddingTop="@dimen/base_space_12"
                        android:paddingBottom="@dimen/base_space_12"
                        android:text="@string/finance_e13_empty"
                        android:textAppearance="@style/TextAppearance.Zmt.BodyMedium"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:visibility="gone" />

                    <LinearLayout
                        android:id="@+id/finance_report_content"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/finance_ai_card"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/base_space_3"
                            app:cardBackgroundColor="?attr/colorTertiaryContainer"
                            app:cardCornerRadius="28dp"
                            app:cardElevation="0dp"
                            app:strokeWidth="0dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="@dimen/base_space_4">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <ImageView
                                        android:layout_width="20dp"
                                        android:layout_height="20dp"
                                        android:importantForAccessibility="no"
                                        android:src="@drawable/ic_auto_awesome"
                                        app:tint="?attr/colorOnTertiaryContainer" />

                                    <TextView
                                        android:id="@+id/finance_ai_title"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="@dimen/base_space_2"
                                        android:layout_weight="1"
                                        android:textAppearance="@style/TextAppearance.Zmt.LabelLarge"
                                        android:textColor="?attr/colorOnTertiaryContainer" />

                                    <com.google.android.material.button.MaterialButton
                                        android:id="@+id/finance_ai_regenerate"
                                        style="@style/Widget.Zmt.Button.Text"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/finance_regenerate"
                                        android:textColor="?attr/colorOnTertiaryContainer"
                                        app:icon="@drawable/ic_refresh"
                                        app:iconTint="?attr/colorOnTertiaryContainer" />
                                </LinearLayout>

                                <LinearLayout
                                    android:id="@+id/finance_ai_skeleton"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/base_space_2"
                                    android:orientation="vertical"
                                    android:visibility="gone">

                                    <com.zhimu.slmp.base.widget.SkeletonView
                                        android:layout_width="match_parent"
                                        android:layout_height="96dp"
                                        app:skeletonCornerRadius="16dp" />
                                </LinearLayout>

                                <TextView
                                    android:id="@+id/finance_ai_failed"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/base_space_2"
                                    android:text="@string/finance_e13_ai_failed"
                                    android:textAppearance="@style/TextAppearance.Zmt.BodyMedium"
                                    android:textColor="?attr/colorOnTertiaryContainer"
                                    android:visibility="gone" />

                                <LinearLayout
                                    android:id="@+id/finance_ai_rows"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/base_space_2"
                                    android:background="@drawable/finance_bg_inner_card"
                                    android:orientation="vertical"
                                    android:paddingStart="@dimen/base_space_3"
                                    android:paddingEnd="@dimen/base_space_3"
                                    android:paddingBottom="@dimen/base_space_3" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/base_space_3"
                                    android:drawablePadding="4dp"
                                    android:gravity="center_vertical"
                                    android:text="@string/finance_e13_ai_disclaimer"
                                    android:textAppearance="@style/TextAppearance.Zmt.BodySmall"
                                    android:textColor="?attr/colorOnTertiaryContainer"
                                    app:drawableStartCompat="@drawable/ic_info"
                                    app:drawableTint="?attr/colorOnTertiaryContainer" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <com.google.android.material.card.MaterialCardView
                            style="@style/Widget.Zmt.Card"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/base_space_3">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="@dimen/base_space_4">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal">

                                    <include
                                        android:id="@+id/finance_metric_stock"
                                        layout="@layout/finance_view_metric" />

                                    <Space
                                        android:layout_width="4dp"
                                        android:layout_height="1dp" />

                                    <include
                                        android:id="@+id/finance_metric_mortality"
                                        layout="@layout/finance_view_metric" />
                                </LinearLayout>

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:orientation="horizontal">

                                    <include
                                        android:id="@+id/finance_metric_feed"
                                        layout="@layout/finance_view_metric" />

                                    <Space
                                        android:layout_width="4dp"
                                        android:layout_height="1dp" />

                                    <include
                                        android:id="@+id/finance_metric_balance"
                                        layout="@layout/finance_view_metric" />
                                </LinearLayout>

                                <com.zhimu.slmp.finance.widget.ReportTrendChartView
                                    android:id="@+id/finance_trend"
                                    android:layout_width="match_parent"
                                    android:layout_height="148dp"
                                    android:layout_marginTop="@dimen/base_space_3" />

                                <TextView
                                    android:id="@+id/finance_equation"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/base_space_2"
                                    android:textAppearance="@style/TextAppearance.Zmt.BodySmall"
                                    android:textColor="?attr/colorOnSurfaceVariant" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <com.google.android.material.card.MaterialCardView
                            style="@style/Widget.Zmt.Card"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/base_space_3">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="@dimen/base_space_4">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal">

                                    <TextView
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:text="@string/finance_e13_profits"
                                        android:textAppearance="@style/TextAppearance.Zmt.TitleMedium"
                                        android:textColor="?attr/colorOnSurface" />

                                    <TextView
                                        android:id="@+id/finance_profit_total"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:textAppearance="@style/TextAppearance.Zmt.BodyMedium" />
                                </LinearLayout>

                                <com.zhimu.slmp.finance.widget.ProfitBarsView
                                    android:id="@+id/finance_profit_bars"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/base_space_3" />

                                <TextView
                                    android:id="@+id/finance_profit_empty"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/base_space_3"
                                    android:text="@string/finance_e13_profits_empty"
                                    android:textAppearance="@style/TextAppearance.Zmt.BodyMedium"
                                    android:textColor="?attr/colorOnSurfaceVariant"
                                    android:visibility="gone" />

                                <TextView
                                    android:id="@+id/finance_running_note"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/base_space_3"
                                    android:textAppearance="@style/TextAppearance.Zmt.BodySmall"
                                    android:textColor="?attr/colorOnSurfaceVariant" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
    </com.zhimu.slmp.base.widget.StateLayout>
</LinearLayout>
