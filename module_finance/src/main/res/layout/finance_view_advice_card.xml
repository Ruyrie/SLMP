<?xml version="1.0" encoding="utf-8"?>
<!-- E12 AI 建议卡（图 10-16，历史建议面板复用、只读）：标题行（auto_awesome + 生成时间、重新生成）、结论 + 休药标签、建议时间段、
     依据不足、内嵌白卡（理由四项、风险）、登记出栏单、固定声明；生成中骨架、失败提示 -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="?attr/colorTertiaryContainer"
    app:cardCornerRadius="28dp"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/base_space_4">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_auto_awesome"
                app:tint="?attr/colorOnTertiaryContainer" />

            <TextView
                android:id="@+id/finance_ai_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/base_space_2"
                android:layout_weight="1"
                android:textAppearance="@style/TextAppearance.Zmt.LabelLarge"
                android:textColor="?attr/colorOnTertiaryContainer" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/finance_ai_regenerate"
                style="@style/Widget.Zmt.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/finance_regenerate"
                android:textColor="?attr/colorOnTertiaryContainer"
                app:icon="@drawable/ic_refresh"
                app:iconTint="?attr/colorOnTertiaryContainer" />
        </LinearLayout>

        <TextView
            android:id="@+id/finance_ai_source"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Zmt.BodySmall"
            android:textColor="?attr/colorOnTertiaryContainer"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/finance_ai_skeleton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/base_space_3"
            android:orientation="vertical"
            android:visibility="gone">

            <com.zhimu.slmp.base.widget.SkeletonView
                android:layout_width="160dp"
                android:layout_height="24dp" />

            <com.zhimu.slmp.base.widget.SkeletonView
                android:layout_width="match_parent"
                android:layout_height="16dp"
                android:layout_marginTop="@dimen/base_space_3" />

            <com.zhimu.slmp.base.widget.SkeletonView
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_marginTop="@dimen/base_space_3"
                app:skeletonCornerRadius="16dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/finance_ai_failed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/base_space_3"
            android:text="@string/finance_e12_failed"
            android:textAppearance="@style/TextAppearance.Zmt.BodyMedium"
            android:textColor="?attr/colorOnTertiaryContainer"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/finance_ai_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/base_space_2"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/finance_ai_conclusion"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textAppearance="@style/TextAppearance.Zmt.TitleLarge"
                    android:textColor="?attr/colorOnTertiaryContainer" />

                <com.zhimu.slmp.base.widget.StatusTagView
                    android:id="@+id/finance_ai_tag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    app:tagType="warning" />
            </LinearLayout>

            <TextView
                android:id="@+id/finance_ai_window"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/base_space_1"
                android:textAppearance="@style/TextAppearance.Zmt.BodyMedium"
                android:textColor="?attr/colorOnTertiaryContainer" />

            <TextView
                android:id="@+id/finance_ai_basis"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/base_space_1"
                android:drawablePadding="4dp"
                android:textAppearance="@style/TextAppearance.Zmt.BodySmall"
                android:textColor="?attr/colorOnTertiaryContainer"
                android:visibility="gone"
                app:drawableStartCompat="@drawable/ic_warning"
                app:drawableTint="?attr/colorOnTertiaryContainer" />

            <LinearLayout
                android:id="@+id/finance_ai_inner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/base_space_3"
                android:background="@drawable/finance_bg_inner_card"
                android:orientation="vertical"
                android:padding="@dimen/base_space_3">

                <TextView
                    android:id="@+id/finance_ai_inner_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/finance_e12_reasons"
                    android:textAppearance="@style/TextAppearance.Zmt.LabelLarge"
                    android:textColor="?attr/colorOnSurface" />

                <LinearLayout
                    android:id="@+id/finance_ai_rows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <com.google.android.material.divider.MaterialDivider
                    android:id="@+id/finance_ai_divider"
                    style="@style/Widget.Zmt.Divider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/base_space_3"
                    android:layout_marginBottom="@dimen/base_space_3" />

                <TextView
                    android:id="@+id/finance_ai_risks_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/finance_e12_risks"
                    android:textAppearance="@style/TextAppearance.Zmt.LabelLarge"
                    android:textColor="?attr/colorOnSurface" />

                <LinearLayout
                    android:id="@+id/finance_ai_risks"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/finance_ai_register"
                style="@style/Widget.Zmt.Button.Tonal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/base_space_3"
                android:text="@string/finance_e12_register"
                android:visibility="gone"
                app:backgroundTint="?attr/colorSurfaceContainerLowest" />
        </LinearLayout>

        <TextView
            android:id="@+id/finance_ai_disclaimer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/base_space_3"
            android:drawablePadding="4dp"
            android:gravity="center_vertical"
            android:text="@string/finance_e12_disclaimer"
            android:textAppearance="@style/TextAppearance.Zmt.BodySmall"
            android:textColor="?attr/colorOnTertiaryContainer"
            app:drawableStartCompat="@drawable/ic_info"
            app:drawableTint="?attr/colorOnTertiaryContainer" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
