<?xml version="1.0" encoding="utf-8"?>
<!-- E06 登记出栏单（图 10-8 休药期拦截、10-9 正常填写）：休药期横幅、批次、出栏日期、数量 + 总重、多栏舍分配、计价方式、单价、
     收购商、约定收款日期、规则横幅；底部销售金额 + “提交” -->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

        <variable
            name="vm"
            type="com.zhimu.slmp.finance.ui.saleedit.SaleOrderEditViewModel" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/colorSurface"
        android:orientation="vertical">

        <include
            android:id="@+id/finance_top_bar"
            layout="@layout/base_include_top_app_bar" />

        <com.zhimu.slmp.base.widget.StateLayout
            android:id="@+id/finance_state"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            app:stateErrorTitle="@string/finance_error_title"
            app:stateNoPermissionTitle="@string/finance_no_permission_title"
            app:stateSkeletonLayout="@layout/base_skeleton_detail">

            <androidx.core.widget.NestedScrollView
                android:id="@+id/finance_scroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/base_page_margin"
                    android:paddingTop="@dimen/base_space_2"
                    android:paddingEnd="@dimen/base_page_margin"
                    android:paddingBottom="@dimen/base_space_6">

                    <com.zhimu.slmp.base.widget.NoticeView
                        android:id="@+id/finance_withdrawal_notice"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/base_space_2"
                        android:visibility="gone"
                        app:noticeIcon="@drawable/ic_block"
                        app:noticeLevel="warning" />

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/base_space_2">

                        <com.zhimu.slmp.base.widget.ZmtTextInputLayout
                            android:id="@+id/finance_batch_layout"
                            style="@style/Widget.Zmt.TextInputLayout.Picker"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/finance_e06_batch"
                            app:endIconDrawable="@drawable/ic_arrow_drop_down"
                            app:endIconMode="custom"
                            app:helperTextEnabled="true">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/finance_batch"
                                style="@style/Widget.Zmt.TextInputEditText.Picker"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="@string/finance_e06_batch_hint" />
                        </com.zhimu.slmp.base.widget.ZmtTextInputLayout>

                        <com.zhimu.slmp.base.widget.StatusTagView
                            android:id="@+id/finance_batch_tag"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="end|top"
                            android:layout_marginTop="20dp"
                            android:layout_marginEnd="52dp"
                            android:visibility="gone" />
                    </FrameLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/finance_go_entry"
                        style="@style/Widget.Zmt.Button.Text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:text="@string/finance_e06_go_entry"
                        android:visibility="gone" />

                    <com.zhimu.slmp.base.widget.ZmtTextInputLayout
                        android:id="@+id/finance_sale_date_layout"
                        style="@style/Widget.Zmt.TextInputLayout.Picker"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/base_space_3"
                        android:hint="@string/finance_e06_sale_date"
                        app:endIconDrawable="@drawable/finance_ic_event"
                        app:endIconMode="custom">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/finance_sale_date"
                            style="@style/Widget.Zmt.TextInputEditText.Picker"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />
                    </com.zhimu.slmp.base.widget.ZmtTextInputLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/base_space_3"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <com.zhimu.slmp.base.widget.ZmtTextInputLayout
                            android:id="@+id/finance_quantity_layout"
                            style="@style/Widget.Zmt.TextInputLayout"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="@string/finance_e06_quantity"
                            app:helperTextEnabled="true"
                            app:placeholderText="@string/finance_e06_quantity_hint">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/finance_quantity"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="number"
                                android:maxLength="7"
                                android:text="@={vm.quantityText}" />
                        </com.zhimu.slmp.base.widget.ZmtTextInputLayout>

                        <com.zhimu.slmp.base.widget.ZmtTextInputLayout
                            android:id="@+id/finance_weight_layout"
                            style="@style/Widget.Zmt.TextInputLayout"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/base_space_3"
                            android:layout_weight="1"
                            android:hint="@string/finance_e06_weight"
                            app:helperTextEnabled="true"
                            app:placeholderText="@string/finance_e06_weight_hint"
                            app:suffixText="@string/finance_kg">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/finance_weight"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="numberDecimal"
                                android:maxLength="11"
                                android:text="@={vm.totalWeightText}" />
                        </com.zhimu.slmp.base.widget.ZmtTextInputLayout>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/finance_pens_title"
                        style="@style/Widget.Zmt.TextView.FieldLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/base_space_3"
                        android:text="@string/finance_e06_pens"
                        android:visibility="gone" />

                    <LinearLayout
                        android:id="@+id/finance_pens"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <TextView
                        android:id="@+id/finance_pens_error"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.Zmt.BodySmall"
                        android:textColor="?attr/colorError"
                        android:visibility="gone" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/base_space_1"
                        android:layout_marginTop="@dimen/base_space_3"
                        android:text="@string/finance_e06_pricing"
                        android:textAppearance="@style/TextAppearance.Zmt.BodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <com.zhimu.slmp.base.widget.ConnectedButtonGroup
                        android:id="@+id/finance_pricing_group"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/base_space_1"
                        app:checkedButton="@id/finance_by_weight"
                        app:selectionRequired="true"
                        app:singleSelection="true">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/finance_by_weight"
                            style="@style/Widget.Zmt.Button.Connected"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/finance_e06_by_weight" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/finance_by_head"
                            style="@style/Widget.Zmt.Button.Connected"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/finance_e06_by_head" />
                    </com.zhimu.slmp.base.widget.ConnectedButtonGroup>

                    <com.zhimu.slmp.base.widget.ZmtTextInputLayout
                        android:id="@+id/finance_price_layout"
                        style="@style/Widget.Zmt.TextInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/base_space_3"
                        android:hint="@string/finance_e06_price"
                        app:helperTextEnabled="true"
                        app:placeholderText="@string/finance_e06_price_hint">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/finance_price"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="numberDecimal"
                            android:maxLength="9"
                            android:text="@={vm.unitPriceText}" />
                    </com.zhimu.slmp.base.widget.ZmtTextInputLayout>

                    <com.zhimu.slmp.base.widget.ZmtTextInputLayout
                        android:id="@+id/finance_buyer_layout"
                        style="@style/Widget.Zmt.TextInputLayout.Dropdown"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/base_space_3"
                        android:hint="@string/finance_e06_buyer">

                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/finance_buyer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:completionThreshold="0"
                            android:inputType="text"
                            android:maxLength="30"
                            android:text="@={vm.buyerName}" />
                    </com.zhimu.slmp.base.widget.ZmtTextInputLayout>

                    <com.zhimu.slmp.base.widget.ZmtTextInputLayout
                        android:id="@+id/finance_due_layout"
                        style="@style/Widget.Zmt.TextInputLayout.Picker"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/base_space_3"
                        android:hint="@string/finance_e06_due"
                        app:endIconDrawable="@drawable/finance_ic_event"
                        app:endIconMode="custom"
                        app:helperTextEnabled="true">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/finance_due"
                            style="@style/Widget.Zmt.TextInputEditText.Picker"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/finance_e06_due_hint" />
                    </com.zhimu.slmp.base.widget.ZmtTextInputLayout>

                    <com.zhimu.slmp.base.widget.NoticeView
                        android:id="@+id/finance_rule_notice"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/base_space_4"
                        android:visibility="gone"
                        app:noticeIcon="@drawable/ic_info" />
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>
        </com.zhimu.slmp.base.widget.StateLayout>

        <LinearLayout
            android:id="@+id/finance_bottom"
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:background="@drawable/base_bg_bottom_action_bar"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/base_page_margin"
            android:paddingEnd="@dimen/base_page_margin"
            android:tag="snackbar_anchor">

            <LinearLayout
                android:id="@+id/finance_amount_box"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/finance_e06_amount_label"
                    android:textAppearance="@style/TextAppearance.Zmt.BodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <TextView
                    android:id="@+id/finance_amount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Zmt.TitleLarge.Number"
                    android:textColor="?attr/colorOnSurface" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/finance_submit"
                style="@style/Widget.Zmt.Button"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:text="@string/finance_e06_submit" />
        </LinearLayout>
    </LinearLayout>
</layout>
