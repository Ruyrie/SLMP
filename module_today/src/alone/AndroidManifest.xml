<?xml version="1.0" encoding="utf-8"?>
<!-- 单独运行（gradle.properties 中 runAlone.module_today=true）时合并到 debug 清单 -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:name="com.zhimu.slmp.today.alone.TodayAloneApp"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@android:mipmap/sym_def_app_icon"
        android:label="今日（单独运行）"
        android:networkSecurityConfig="@xml/common_core_network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Zmt">

        <activity
            android:name="com.zhimu.slmp.common.app.AloneLauncherActivity"
            android:exported="true"
            tools:replace="android:exported">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 单独运行时承载 T01 今日首页（壳工程中为 MainActivity 的“今日”标签） -->
        <activity
            android:name="com.zhimu.slmp.today.alone.TodayHostActivity"
            android:exported="false">
            <intent-filter>
                <action android:name="com.zhimu.slmp.page.T01" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>

</manifest>
