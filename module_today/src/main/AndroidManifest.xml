<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Android 13 起首次进入今日首页后先说明再申请（03 号 8.8 节） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 极光 SDK 自带的非必要权限：不申请存储、电话、后台定位与应用列表（03 号 13 节最小权限） -->
    <uses-permission
        android:name="android.permission.READ_PHONE_STATE"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.ACCESS_BACKGROUND_LOCATION"
        tools:node="remove" />

    <application>

        <!-- T02 通过透明宿主复用快捷登记面板，供生产等其他模块打开 -->
        <activity
            android:name=".ui.home.QuickRegisterActivity"
            android:exported="false"
            android:theme="@style/today_theme_transparent">
            <intent-filter>
                <action android:name="com.zhimu.slmp.page.T02" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- T03 养殖日历 -->
        <activity
            android:name=".ui.calendar.CalendarActivity"
            android:exported="false">
            <intent-filter>
                <action android:name="com.zhimu.slmp.page.T03" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity android:name=".ui.collection.TodoCollectionActivity" android:exported="false">
            <intent-filter>
                <action android:name="com.zhimu.slmp.page.T09" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- T04 待办详情 -->
        <activity
            android:name=".ui.detail.TodoDetailActivity"
            android:exported="false">
            <intent-filter>
                <action android:name="com.zhimu.slmp.page.T04" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- T05 提醒设置 -->
        <activity
            android:name=".ui.setting.ReminderSettingActivity"
            android:exported="false">
            <intent-filter>
                <action android:name="com.zhimu.slmp.page.T05" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- T06 消息中心 -->
        <activity
            android:name=".ui.message.MessageCenterActivity"
            android:exported="false"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="com.zhimu.slmp.page.T06" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- T07 通知详情 -->
        <activity
            android:name=".ui.notice.NoticeDetailActivity"
            android:exported="false">
            <intent-filter>
                <action android:name="com.zhimu.slmp.page.T07" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- T08 关联记录已失效 -->
        <activity
            android:name=".ui.invalid.RecordInvalidActivity"
            android:exported="false">
            <intent-filter>
                <action android:name="com.zhimu.slmp.page.T08" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- 推送中转页：透明、不进最近任务；除启动页外唯一导出的页面，只处理约定的 action -->
        <activity
            android:name=".ui.push.PushRouterActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:theme="@style/today_theme_transparent">
            <intent-filter>
                <action android:name="com.zhimu.slmp.action.PUSH_OPEN" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- 极光要求的自定义 Service：保持推送通道（:pushcore 进程，enabled 不能为 false） -->
        <service
            android:name=".push.ZhimuPushService"
            android:enabled="true"
            android:exported="false"
            android:process=":pushcore">
            <intent-filter>
                <action android:name="cn.jiguang.user.service.action" />
            </intent-filter>
        </service>

        <!-- 极光消息接收器（不导出）：到达刷新未读数、点击打开中转页、注册与开关变化时上报设备 -->
        <receiver
            android:name=".push.ZhimuPushReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="cn.jpush.android.intent.RECEIVE_MESSAGE" />
                <category android:name="${applicationId}" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
