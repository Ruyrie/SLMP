<?xml version="1.0" encoding="utf-8"?>
<!-- T01 首次加载骨架：问候区两条文字、三张指标卡占位、AI 横幅占位、待办 5 行；不显示转圈 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:importantForAccessibility="noHideDescendants"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/base_page_margin"
        android:paddingEnd="@dimen/base_page_margin">

        <com.zhimu.slmp.base.widget.SkeletonView
            android:layout_width="220dp"
            android:layout_height="36dp"
            android:layout_marginTop="@dimen/base_space_3" />

        <com.zhimu.slmp.base.widget.SkeletonView
            android:layout_width="200dp"
            android:layout_height="16dp"
            android:layout_marginTop="@dimen/base_space_2" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/base_stat_card_compact_height"
            android:layout_marginTop="@dimen/base_space_4"
            android:orientation="horizontal">

            <com.zhimu.slmp.base.widget.SkeletonView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="143"
                app:skeletonCornerRadius="@dimen/base_radius_lg_plus" />

            <com.zhimu.slmp.base.widget.SkeletonView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/base_space_2"
                android:layout_weight="111"
                app:skeletonCornerRadius="@dimen/base_radius_lg_plus" />

            <com.zhimu.slmp.base.widget.SkeletonView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/base_space_2"
                android:layout_weight="110"
                app:skeletonCornerRadius="@dimen/base_radius_lg_plus" />
        </LinearLayout>

        <com.zhimu.slmp.base.widget.SkeletonView
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="@dimen/base_space_3"
            app:skeletonCornerRadius="24dp" />

        <com.zhimu.slmp.base.widget.SkeletonView
            android:layout_width="140dp"
            android:layout_height="16dp"
            android:layout_marginTop="@dimen/base_space_6"
            android:layout_marginBottom="@dimen/base_space_2" />

        <include layout="@layout/today_skeleton_row" />

        <include layout="@layout/today_skeleton_row" />

        <include layout="@layout/today_skeleton_row" />

        <include layout="@layout/today_skeleton_row" />

        <include layout="@layout/today_skeleton_row" />
    </LinearLayout>
</ScrollView>
