<?xml version="1.0" encoding="utf-8"?>
<!-- T06 消息中心：顶部栏（done_all、settings）、筛选行（类型 / 全部养殖场 / 未读 N）照常显示，下方为可下拉刷新的分组列表 -->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

        <variable
            name="vm"
            type="com.zhimu.slmp.today.ui.message.MessageCenterViewModel" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/colorSurface"
        android:orientation="vertical">

        <include
            android:id="@+id/top_bar"
            layout="@layout/base_include_top_app_bar"
            app:title="@{@string/today_message_title}" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/base_page_margin"
                android:paddingTop="@dimen/base_space_2"
                android:paddingEnd="@dimen/base_page_margin"
                android:paddingBottom="@dimen/base_space_1"
                app:singleLine="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_type"
                    style="@style/Widget.Zmt.Chip.Dropdown"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/today_message_type" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_farm"
                    style="@style/Widget.Zmt.Chip.Dropdown"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/today_message_all_farms"
                    app:visibleIf="@{safeUnbox(vm.showFarmFilter)}" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_unread"
                    style="@style/Widget.Zmt.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="@{safeUnbox(vm.unreadOnly)}"
                    android:text="@{@string/today_message_unread_count(safeUnbox(vm.filteredUnread))}" />
            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/refresh"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="@dimen/base_space_6" />
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
    </LinearLayout>
</layout>
