<?xml version="1.0" encoding="utf-8"?>
<!-- T02 快捷登记面板内容：“作业”组 8 项、“养殖户”组 4 项（员工不显示）；“物资入库”在面板内切换为选择入库类型 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:animateLayoutChanges="true">

    <LinearLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/base_space_2"
        android:paddingEnd="@dimen/base_space_2"
        android:paddingBottom="@dimen/base_space_4">

        <TextView
            android:id="@+id/group_work"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/base_space_4"
            android:layout_marginTop="@dimen/base_space_2"
            android:text="@string/today_quick_group_work"
            android:textAppearance="@style/TextAppearance.Zmt.TitleSmall"
            android:textColor="?attr/colorPrimary" />

        <GridLayout
            android:id="@+id/grid_work"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/base_space_2"
            android:columnCount="4" />

        <TextView
            android:id="@+id/group_owner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/base_space_4"
            android:layout_marginTop="@dimen/base_space_3"
            android:text="@string/today_quick_group_owner"
            android:textAppearance="@style/TextAppearance.Zmt.TitleSmall"
            android:textColor="?attr/colorPrimary" />

        <GridLayout
            android:id="@+id/grid_owner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/base_space_2"
            android:columnCount="4" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/stock_in"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/base_space_4"
        android:paddingEnd="@dimen/base_space_4"
        android:paddingBottom="@dimen/base_space_6"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/stock_back"
                style="@style/Widget.Zmt.Button.Icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/base_cd_back"
                app:icon="@drawable/ic_arrow_back" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/base_space_2"
                android:text="@string/today_quick_stock_in_title"
                android:textAppearance="@style/TextAppearance.Zmt.TitleMedium"
                android:textColor="?attr/colorOnSurface" />
        </LinearLayout>

        <com.zhimu.slmp.base.widget.GroupedListLayout
            android:id="@+id/stock_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/base_space_2" />
    </LinearLayout>
</FrameLayout>
