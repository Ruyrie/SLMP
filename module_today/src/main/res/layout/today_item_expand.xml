<?xml version="1.0" encoding="utf-8"?>
<!-- 周视图“展开其余 N 项”/“收起”文字按钮（expand_more / expand_less 20 dp + 14 sp primary，点击区高 48 dp） -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/base_space_2"
    android:paddingEnd="@dimen/base_page_margin">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button"
        style="@style/Widget.Zmt.Button.Text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/base_touch_target"
        app:iconSize="20dp" />
</FrameLayout>
