<?xml version="1.0" encoding="utf-8"?>
<!--
    分组列表项（流水、批号、药品档案、选择面板）：40 dp 物资图标底块 → 主文字 + 副文字（最多 3 行）→
    右侧数量、状态标签与文字按钮（“去报废”）；选择面板中选中项右侧显示对勾。形状按组内位置由代码设置。
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/stock_row_card"
    style="@style/Widget.Zmt.Card.ListItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="72dp"
        android:orientation="horizontal"
        android:paddingStart="@dimen/base_space_4"
        android:paddingTop="@dimen/base_space_3"
        android:paddingEnd="@dimen/base_space_4"
        android:paddingBottom="@dimen/base_space_3">

        <FrameLayout
            android:id="@+id/stock_row_leading"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="@dimen/base_space_4"
            android:background="@drawable/stock_bg_leading">

            <ImageView
                android:id="@+id/stock_row_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/stock_row_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:textAppearance="@style/TextAppearance.Zmt.TitleMedium"
                android:textColor="?attr/colorOnSurface" />

            <TextView
                android:id="@+id/stock_row_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="3"
                android:textAppearance="@style/TextAppearance.Zmt.BodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/stock_row_trailing"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/base_space_3"
            android:gravity="end|center_vertical"
            android:orientation="vertical">

            <TextView
                android:id="@+id/stock_row_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Zmt.BodyLarge.Number"
                android:textColor="?attr/colorOnSurface" />

            <com.zhimu.slmp.base.widget.StatusTagView
                android:id="@+id/stock_row_tag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/base_space_1"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/stock_row_action"
                style="@style/Widget.Zmt.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/base_touch_target"
                android:visibility="gone" />
        </LinearLayout>

        <ImageView
            android:id="@+id/stock_row_check"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="@dimen/base_space_3"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_check"
            android:visibility="gone"
            app:tint="?attr/colorPrimary" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
