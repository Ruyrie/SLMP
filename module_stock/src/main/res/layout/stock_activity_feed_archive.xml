<?xml version="1.0" encoding="utf-8"?>
<!--
    M02 饲料档案（新增 / 编辑）：名称 → 类型（字典面板）→ 规格 / 单位 → 适用品类 → 库存下限 / 预警天数 →
    规则说明 → 上次修改与“查看修改记录”；底部“保存”。
-->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

        <variable
            name="vm"
            type="com.zhimu.slmp.stock.ui.feedarchive.FeedArchiveViewModel" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/colorSurface"
        android:orientation="vertical">

        <include
            android:id="@+id/stock_top_bar"
            layout="@layout/base_include_top_app_bar" />

        <com.zhimu.slmp.base.widget.StateLayout
            android:id="@+id/stock_state"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            app:stateErrorTitle="@string/stock_error_title"
            app:stateNoPermissionTitle="@string/stock_no_permission_title"
            app:stateSkeletonLayout="@layout/base_skeleton_detail">

            <androidx.core.widget.NestedScrollView
                android:id="@+id/stock_scroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/base_page_margin"
                    android:paddingTop="@dimen/base_space_5"
                    android:paddingEnd="@dimen/base_page_margin"
                    android:paddingBottom="@dimen/base_space_4">

                    <com.zhimu.slmp.base.widget.ZmtTextInputLayout
                        android:id="@+id/stock_name_layout"
                        style="@style/Widget.Zmt.TextInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/stock_field_name"
                        app:stockError="@{vm.fieldErrors[`name`]}">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/stock_name_input"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text"
                            android:maxLength="20"
                            android:text="@={vm.name}" />
                    </com.zhimu.slmp.base.widget.ZmtTextInputLayout>

                    <com.zhimu.slmp.base.widget.ZmtTextInputLayout
                        android:id="@+id/stock_type_layout"
                        style="@style/Widget.Zmt.TextInputLayout.Picker"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/base_space_5"
                        android:hint="@string/stock_field_feed_type"
                        app:endIconDrawable="@drawable/ic_arrow_drop_down"
                        app:helperText="@string/stock_feed_type_helper"
                        app:helperTextEnabled="true"
                        app:stockError="@{vm.fieldErrors[`feed_type_code`]}">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/stock_type_input"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@{vm.feedTypeText}" />
                    </com.zhimu.slmp.base.widget.ZmtTextInputLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/base_space_4"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <com.zhimu.slmp.base.widget.ZmtTextInputLayout
                            android:id="@+id/stock_spec_layout"
                            style="@style/Widget.Zmt.TextInputLayout"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="@string/stock_field_spec_optional"
                            app:stockError="@{vm.fieldErrors[`spec`]}">

                            <com.google.android.material.textfield.TextInputEditText
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="text"
                                android:maxLength="20"
                                android:text="@={vm.spec}" />
                        </com.zhimu.slmp.base.widget.ZmtTextInputLayout>

                        <com.zhimu.slmp.base.widget.ZmtTextInputLayout
                            style="@style/Widget.Zmt.TextInputLayout.ReadOnly"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/base_space_3"
                            android:layout_weight="1"
                            android:hint="@string/stock_field_unit"
                            app:helperTextEnabled="true"
                            app:stockHelper="@{vm.unitHelper}">

                            <com.google.android.material.textfield.TextInputEditText
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:enabled="false"
                                android:text="@string/stock_unit_kg" />
                        </com.zhimu.slmp.base.widget.ZmtTextInputLayout>
                    </LinearLayout>

                    <com.zhimu.slmp.base.widget.ZmtTextInputLayout
                        android:id="@+id/stock_category_layout"
                        style="@style/Widget.Zmt.TextInputLayout.Picker"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/base_space_4"
                        android:hint="@string/stock_field_category"
                        app:endIconDrawable="@drawable/ic_arrow_drop_down">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/stock_category_input"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@{vm.categoryText}" />
                    </com.zhimu.slmp.base.widget.ZmtTextInputLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/base_space_5"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <com.zhimu.slmp.base.widget.ZmtTextInputLayout
                            android:id="@+id/stock_min_layout"
                            style="@style/Widget.Zmt.TextInputLayout"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="@string/stock_field_min_stock"
                            app:helperText="@string/stock_min_helper"
                            app:helperTextEnabled="true"
                            app:stockError="@{vm.fieldErrors[`min_stock`]}"
                            app:suffixText="@string/stock_unit_kg">

                            <com.google.android.material.textfield.TextInputEditText
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:digits="0123456789."
                                android:inputType="numberDecimal"
                                android:maxLength="11"
                                android:text="@={vm.minStock}"
                                android:textAppearance="@style/TextAppearance.Zmt.BodyLarge.Number" />
                        </com.zhimu.slmp.base.widget.ZmtTextInputLayout>

                        <com.zhimu.slmp.base.widget.ZmtTextInputLayout
                            android:id="@+id/stock_warn_layout"
                            style="@style/Widget.Zmt.TextInputLayout"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/base_space_3"
                            android:layout_weight="1"
                            android:hint="@string/stock_field_warn_days"
                            app:helperText="@string/stock_warn_helper"
                            app:helperTextEnabled="true"
                            app:stockError="@{vm.fieldErrors[`warn_days`]}"
                            app:suffixText="@string/stock_unit_day">

                            <com.google.android.material.textfield.TextInputEditText
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="number"
                                android:maxLength="3"
                                android:text="@={vm.warnDays}"
                                android:textAppearance="@style/TextAppearance.Zmt.BodyLarge.Number" />
                        </com.zhimu.slmp.base.widget.ZmtTextInputLayout>
                    </LinearLayout>

                    <com.zhimu.slmp.base.widget.NoticeView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/base_space_5"
                        app:noticeIcon="@drawable/ic_history"
                        app:noticeLevel="normal"
                        app:noticeText="@string/stock_feed_archive_rule" />

                    <LinearLayout
                        android:id="@+id/stock_last_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/base_space_4"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        app:goneIfNull="@{vm.lastModified}">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/base_space_1"
                            android:layout_weight="1"
                            android:text="@{vm.lastModified}"
                            android:textAppearance="@style/TextAppearance.Zmt.BodySmall"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/stock_change_log"
                            style="@style/Widget.Zmt.Button.Text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/stock_menu_change_log" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>
        </com.zhimu.slmp.base.widget.StateLayout>

        <com.zhimu.slmp.base.widget.BottomActionBar
            android:id="@+id/stock_action_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:barPrimaryIcon="@drawable/ic_check"
            app:barPrimaryText="@string/stock_action_save" />
    </LinearLayout>
</layout>
