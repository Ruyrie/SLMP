<?xml version="1.0" encoding="utf-8"?>
<!-- 单据只读页（报损、报废、盘点）：只读分组列表 → 盘点明细（盘点单）→ 规则说明；右上角菜单按 actions -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:orientation="vertical">

    <include
        android:id="@+id/stock_top_bar"
        layout="@layout/base_include_top_app_bar" />

    <com.zhimu.slmp.base.widget.StateLayout
        android:id="@+id/stock_state"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        app:stateErrorTitle="@string/stock_error_title"
        app:stateNoPermissionTitle="@string/stock_no_permission_title"
        app:stateSkeletonLayout="@layout/base_skeleton_detail">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/base_page_margin"
                android:paddingTop="@dimen/base_space_4"
                android:paddingEnd="@dimen/base_page_margin"
                android:paddingBottom="@dimen/base_space_6">

                <com.zhimu.slmp.base.widget.GroupedListLayout
                    android:id="@+id/stock_record_rows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <include android:id="@+id/stock_refund" layout="@layout/stock_view_refund" />

                <include
                    android:id="@+id/stock_record_items_title"
                    layout="@layout/stock_item_section"
                    android:visibility="gone" />

                <com.zhimu.slmp.base.widget.GroupedListLayout
                    android:id="@+id/stock_record_items"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <com.zhimu.slmp.base.widget.NoticeView
                    android:id="@+id/stock_record_notice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/base_space_5"
                    app:noticeIcon="@drawable/ic_info"
                    app:noticeLevel="normal" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </com.zhimu.slmp.base.widget.StateLayout>
</LinearLayout>
