<?xml version="1.0" encoding="utf-8"?>
<!-- 临期天数设置面板内容（M05、M09 共用）：兽药 / 疫苗 / 消毒剂三个数字框（单位天，默认 30）→ 右对齐“取消”“保存” -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/base_sheet_padding_horizontal"
    android:paddingTop="@dimen/base_space_3"
    android:paddingEnd="@dimen/base_sheet_padding_horizontal"
    android:paddingBottom="@dimen/base_space_4">

    <com.zhimu.slmp.base.widget.ZmtTextInputLayout
        android:id="@+id/stock_near_vet_layout"
        style="@style/Widget.Zmt.TextInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/stock_cat_vet"
        app:suffixText="@string/stock_unit_day">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/stock_near_vet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:maxLength="3"
            android:textAppearance="@style/TextAppearance.Zmt.BodyLarge.Number" />
    </com.zhimu.slmp.base.widget.ZmtTextInputLayout>

    <com.zhimu.slmp.base.widget.ZmtTextInputLayout
        android:id="@+id/stock_near_vaccine_layout"
        style="@style/Widget.Zmt.TextInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/base_space_4"
        android:hint="@string/stock_cat_vaccine"
        app:suffixText="@string/stock_unit_day">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/stock_near_vaccine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:maxLength="3"
            android:textAppearance="@style/TextAppearance.Zmt.BodyLarge.Number" />
    </com.zhimu.slmp.base.widget.ZmtTextInputLayout>

    <com.zhimu.slmp.base.widget.ZmtTextInputLayout
        android:id="@+id/stock_near_dis_layout"
        style="@style/Widget.Zmt.TextInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/base_space_4"
        android:hint="@string/stock_cat_disinfectant"
        app:suffixText="@string/stock_unit_day">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/stock_near_dis"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:maxLength="3"
            android:textAppearance="@style/TextAppearance.Zmt.BodyLarge.Number" />
    </com.zhimu.slmp.base.widget.ZmtTextInputLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/base_space_5"
        android:gravity="end"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/stock_near_cancel"
            style="@style/Widget.Zmt.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/stock_action_cancel" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/stock_near_save"
            style="@style/Widget.Zmt.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/base_space_2"
            android:text="@string/stock_action_save" />
    </LinearLayout>
</LinearLayout>
