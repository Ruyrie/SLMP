<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <data><variable name="vm" type="com.zhimu.slmp.stock.ui.refund.ReturnRefundViewModel" /></data>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingStart="@dimen/base_sheet_padding_horizontal"
        android:paddingEnd="@dimen/base_sheet_padding_horizontal" android:paddingBottom="@dimen/base_space_4">
        <TextView android:id="@+id/stock_refund_summary" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Zmt.BodyMedium" android:textColor="?attr/colorOnSurfaceVariant" />
        <com.zhimu.slmp.base.widget.ZmtTextInputLayout android:id="@+id/stock_refund_amount_layout"
            style="@style/Widget.Zmt.TextInputLayout" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/base_space_4" android:hint="@string/stock_refund_amount" app:suffixText="元">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/stock_refund_amount"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="numberDecimal"
                android:maxLength="13" android:text="@={vm.amountText}" />
        </com.zhimu.slmp.base.widget.ZmtTextInputLayout>
        <com.zhimu.slmp.base.widget.ZmtTextInputLayout android:id="@+id/stock_refund_date_layout"
            style="@style/Widget.Zmt.TextInputLayout.Picker" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/base_space_3" android:hint="@string/stock_refund_date">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/stock_refund_date"
                style="@style/Widget.Zmt.TextInputEditText.Picker" android:layout_width="match_parent" android:layout_height="wrap_content" />
        </com.zhimu.slmp.base.widget.ZmtTextInputLayout>
        <com.zhimu.slmp.base.widget.ZmtTextInputLayout android:id="@+id/stock_refund_remark_layout"
            style="@style/Widget.Zmt.TextInputLayout" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/base_space_3" android:hint="@string/stock_field_remark_optional">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/stock_refund_remark"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textMultiLine"
                android:maxLength="200" android:maxLines="3" android:text="@={vm.remark}" />
        </com.zhimu.slmp.base.widget.ZmtTextInputLayout>
        <TextView android:id="@+id/stock_refund_confirm_notice" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/base_space_3"
            android:text="@string/stock_refund_confirm_notice" android:textAppearance="@style/TextAppearance.Zmt.BodySmall"
            android:textColor="?attr/colorOnSurfaceVariant" />
        <TextView android:id="@+id/stock_refund_error" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/base_space_3" android:accessibilityLiveRegion="polite" android:visibility="gone"
            android:textAppearance="@style/TextAppearance.Zmt.BodySmall" android:textColor="?attr/colorError" />
    </LinearLayout>
</layout>
