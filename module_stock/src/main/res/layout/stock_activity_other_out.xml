<?xml version="1.0" encoding="utf-8"?>
<!--
    M10 饲料其他出库：饲料（结存与均价）→ 出库数量 → 出库去向 Chip（提示行随去向变化）→ 说明 → 出库日期 → 按均价折合 → 规则说明；
    底部“确认出库”。只读状态为分组列表，菜单按 actions；修改状态饲料只读、主按钮“保存修改”。
-->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

        <import type="com.zhimu.slmp.stock.ui.common.FormMode" />

        <variable
            name="vm"
            type="com.zhimu.slmp.stock.ui.otherout.FeedOtherOutViewModel" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/colorSurface"
        android:orientation="vertical">

        <include
            android:id="@+id/stock_top_bar"
            layout="@layout/base_include_top_app_bar" />

        <com.zhimu.slmp.base.widget.StateLayout
            android:id="@+id/stock_state"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            app:stateErrorTitle="@string/stock_error_title"
            app:stateNoPermissionTitle="@string/stock_no_permission_title"
            app:stateSkeletonLayout="@layout/base_skeleton_detail">

            <androidx.core.widget.NestedScrollView
                android:id="@+id/stock_scroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/base_page_margin"
                    android:paddingTop="@dimen/base_space_5"
                    android:paddingEnd="@dimen/base_page_margin"
                    android:paddingBottom="@dimen/base_space_4">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        app:visibleIf="@{!FormMode.VIEW.equals(vm.mode)}">

                        <com.zhimu.slmp.base.widget.ZmtTextInputLayout
                            android:id="@+id/stock_feed_layout"
                            style="@style/Widget.Zmt.TextInputLayout.Picker"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:enabled="@{FormMode.NEW.equals(vm.mode)}"
                            android:hint="@string/stock_field_feed"
                            app:endIconDrawable="@drawable/ic_arrow_drop_down"
                            app:stockError="@{vm.fieldErrors[`feed_id`]}"
                            app:stockHelper="@{vm.feedHint}">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/stock_feed_input"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="@string/stock_pick_feed"
                                android:text="@{vm.feedName}" />
                        </com.zhimu.slmp.base.widget.ZmtTextInputLayout>

                        <com.zhimu.slmp.base.widget.ZmtTextInputLayout
                            android:id="@+id/stock_qty_layout"
                            style="@style/Widget.Zmt.TextInputLayout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/base_space_4"
                            android:hint="@string/stock_field_out_qty"
                            app:stockError="@{vm.fieldErrors[`input_qty`]}"
                            app:stockHelper="@{vm.maxText}"
                            app:suffixText="@{vm.unitText}">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/stock_qty_input"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:digits="0123456789.,"
                                android:inputType="numberDecimal"
                                android:maxLength="14"
                                android:text="@={vm.inputQty}"
                                android:textAppearance="@style/TextAppearance.Zmt.BodyLarge.Number" />
                        </com.zhimu.slmp.base.widget.ZmtTextInputLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/base_space_4"
                            android:text="@string/stock_field_destination"
                            android:textAppearance="@style/TextAppearance.Zmt.TitleSmall"
                            android:textColor="?attr/colorOnSurface" />

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/stock_dest_chips"
                            style="@style/Widget.Zmt.ChipGroup"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/base_space_2"
                            app:singleSelection="true" />

                        <TextView
                            android:id="@+id/stock_dest_hint"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/base_space_2"
                            android:paddingStart="@dimen/base_space_1"
                            android:text="@{vm.fieldErrors[`destination`] != null ? vm.fieldErrors[`destination`] : vm.destHint}"
                            android:textAppearance="@style/TextAppearance.Zmt.BodySmall"
                            android:textColor="@{vm.fieldErrors[`destination`] != null ? @color/zm_error : @color/zm_on_surface_variant}" />

                        <com.zhimu.slmp.base.widget.ZmtTextInputLayout
                            android:id="@+id/stock_remark_layout"
                            style="@style/Widget.Zmt.TextInputLayout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/base_space_4"
                            android:hint="@{safeUnbox(vm.remarkRequired) ? @string/stock_field_remark : @string/stock_field_remark_optional}"
                            app:stockError="@{vm.fieldErrors[`remark`]}">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/stock_remark_input"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="textMultiLine"
                                android:maxLength="100"
                                android:maxLines="3"
                                android:text="@={vm.remark}" />
                        </com.zhimu.slmp.base.widget.ZmtTextInputLayout>

                        <com.zhimu.slmp.base.widget.ZmtTextInputLayout
                            android:id="@+id/stock_date_layout"
                            style="@style/Widget.Zmt.TextInputLayout.Picker"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/base_space_5"
                            android:hint="@string/stock_field_out_date"
                            app:stockError="@{vm.fieldErrors[`out_date`]}">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/stock_date_input"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                app:dateText="@{vm.outDate}"
                                app:dateWithWeek="@{true}" />
                        </com.zhimu.slmp.base.widget.ZmtTextInputLayout>

                        <include
                            layout="@layout/stock_view_amount_bar"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/base_space_5"
                            app:amount="@{vm.amountText}"
                            app:label="@{@string/stock_amount_avg}" />

                        <com.zhimu.slmp.base.widget.NoticeView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/base_space_5"
                            app:noticeIcon="@drawable/ic_info"
                            app:noticeLevel="normal"
                            app:noticeText="@string/stock_other_out_rule" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        app:visibleIf="@{FormMode.VIEW.equals(vm.mode)}">

                        <com.zhimu.slmp.base.widget.StatusTagView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="end"
                            android:layout_marginBottom="@dimen/base_space_2"
                            android:text="@string/stock_tag_pending"
                            app:tagType="warning"
                            app:visibleIf="@{vm.pending}" />

                        <com.zhimu.slmp.base.widget.GroupedListLayout
                            android:id="@+id/stock_readonly_rows"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>
        </com.zhimu.slmp.base.widget.StateLayout>

        <com.zhimu.slmp.base.widget.BottomActionBar
            android:id="@+id/stock_action_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>
</layout>
