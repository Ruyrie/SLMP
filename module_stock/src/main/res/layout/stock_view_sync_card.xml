<?xml version="1.0" encoding="utf-8"?>
<!-- 同步记账卡（M03、M08 共用，380 × 122 dp，圆角 20，surface-container-low）：复选框 + 标题 + 三行说明，整张卡都是点击区 -->
<layout xmlns:android="http://schemas.android.com/apk/res/android">

    <data>

        <variable
            name="text"
            type="String" />

        <variable
            name="checked"
            type="Boolean" />
    </data>

    <LinearLayout
        android:id="@+id/stock_sync_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/stock_bg_summary_bar"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:orientation="horizontal"
        android:padding="@dimen/base_space_4">

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/stock_sync_check"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="@{safeUnbox(checked)}"
            android:clickable="false"
            android:focusable="false"
            android:minWidth="0dp"
            android:minHeight="0dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/base_space_3"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/stock_sync_title"
                android:textAppearance="@style/TextAppearance.Zmt.TitleMedium"
                android:textColor="?attr/colorOnSurface" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/base_space_1"
                android:text="@{text}"
                android:textAppearance="@style/TextAppearance.Zmt.BodyMedium.Number"
                android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>
    </LinearLayout>
</layout>
