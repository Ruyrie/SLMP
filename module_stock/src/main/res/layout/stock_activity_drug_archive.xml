<?xml version="1.0" encoding="utf-8"?>
<!--
    M09 药品档案：禁用药横幅 → 类别连接按钮组 + 名称（新增或未有流水）/ 只读药品卡（已有出入库记录）→ 规格 / 库存单位 →
    库存下限 → 临期天数行（“修改”打开临期天数面板）→ 规则说明 → 上次修改；底部“保存”（禁用药不显示）。
-->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

        <variable
            name="vm"
            type="com.zhimu.slmp.stock.ui.drugarchive.DrugArchiveViewModel" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/colorSurface"
        android:orientation="vertical">

        <include
            android:id="@+id/stock_top_bar"
            layout="@layout/base_include_top_app_bar" />

        <com.zhimu.slmp.base.widget.StateLayout
            android:id="@+id/stock_state"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            app:stateErrorTitle="@string/stock_error_title"
            app:stateNoPermissionTitle="@string/stock_no_permission_title"
            app:stateSkeletonLayout="@layout/base_skeleton_detail">

            <androidx.core.widget.NestedScrollView
                android:id="@+id/stock_scroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/base_page_margin"
                    android:paddingTop="@dimen/base_space_3"
                    android:paddingEnd="@dimen/base_page_margin"
                    android:paddingBottom="@dimen/base_space_4">

                    <com.zhimu.slmp.base.widget.NoticeView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/base_space_3"
                        app:noticeIcon="@drawable/ic_block"
                        app:noticeLevel="error"
                        app:noticeText="@string/stock_drug_banned_notice"
                        app:visibleIf="@{vm.banned}" />

                    <!-- 新增 / 未有出入库记录：类别与名称 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        app:visibleIf="@{!safeUnbox(vm.locked)}">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/stock_field_drug_category"
                            android:textAppearance="@style/TextAppearance.Zmt.TitleSmall"
                            android:textColor="?attr/colorOnSurface" />

                        <com.zhimu.slmp.base.widget.ConnectedButtonGroup
                            android:id="@+id/stock_category_group"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/base_space_2"
                            app:selectionRequired="true"
                            app:singleSelection="true">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/stock_cat_vet_btn"
                                style="@style/Widget.Zmt.Button.Connected"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/stock_cat_vet" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/stock_cat_vaccine_btn"
                                style="@style/Widget.Zmt.Button.Connected"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/stock_cat_vaccine" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/stock_cat_dis_btn"
                                style="@style/Widget.Zmt.Button.Connected"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/stock_cat_disinfectant" />
                        </com.zhimu.slmp.base.widget.ConnectedButtonGroup>

                        <com.zhimu.slmp.base.widget.ZmtTextInputLayout
                            android:id="@+id/stock_name_layout"
                            style="@style/Widget.Zmt.TextInputLayout.Picker"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/base_space_5"
                            android:hint="@string/stock_field_name"
                            app:endIconDrawable="@drawable/ic_arrow_drop_down"
                            app:endIconContentDescription="@string/base_cd_pick_option"
                            app:stockError="@{vm.fieldErrors[`catalog_id`]}"
                            app:stockHelper="@{vm.nameHelper}">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/stock_name_input"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="@string/stock_name_placeholder"
                                android:text="@{vm.name}" />
                        </com.zhimu.slmp.base.widget.ZmtTextInputLayout>
                    </LinearLayout>

                    <!-- 已有出入库记录：只读药品卡 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/base_space_2"
                        android:orientation="vertical"
                        app:visibleIf="@{vm.locked}">

                        <com.google.android.material.card.MaterialCardView
                            style="@style/Widget.Zmt.Card.Summary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <FrameLayout
                                    android:id="@+id/stock_drug_leading"
                                    android:layout_width="40dp"
                                    android:layout_height="40dp"
                                    android:layout_marginEnd="@dimen/base_space_3"
                                    android:background="@drawable/stock_bg_leading">

                                    <ImageView
                                        android:id="@+id/stock_drug_icon"
                                        android:layout_width="24dp"
                                        android:layout_height="24dp"
                                        android:layout_gravity="center"
                                        android:importantForAccessibility="no" />
                                </FrameLayout>

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@{vm.name}"
                                        android:textAppearance="@style/TextAppearance.Zmt.TitleMedium"
                                        android:textColor="?attr/colorOnSurface" />

                                    <TextView
                                        android:id="@+id/stock_drug_source"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:textAppearance="@style/TextAppearance.Zmt.BodyMedium"
                                        android:textColor="?attr/colorOnSurfaceVariant" />
                                </LinearLayout>
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/base_space_4"
                            android:layout_marginTop="@dimen/base_space_1"
                            android:text="@string/stock_drug_locked_helper"
                            android:textAppearance="@style/TextAppearance.Zmt.BodySmall"
                            android:textColor="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/base_space_5"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <com.zhimu.slmp.base.widget.ZmtTextInputLayout
                            android:id="@+id/stock_spec_layout"
                            style="@style/Widget.Zmt.TextInputLayout"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:enabled="@{!safeUnbox(vm.banned)}"
                            android:hint="@string/stock_field_spec_optional"
                            app:stockError="@{vm.fieldErrors[`spec`]}"
                            app:stockHelper="@{vm.specHelper}">

                            <com.google.android.material.textfield.TextInputEditText
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="text"
                                android:maxLength="20"
                                android:text="@={vm.spec}" />
                        </com.zhimu.slmp.base.widget.ZmtTextInputLayout>

                        <com.zhimu.slmp.base.widget.ZmtTextInputLayout
                            android:id="@+id/stock_unit_layout"
                            style="@style/Widget.Zmt.TextInputLayout.Picker"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/base_space_3"
                            android:layout_weight="1"
                            android:enabled="@{!safeUnbox(vm.locked) &amp;&amp; !safeUnbox(vm.banned)}"
                            android:hint="@string/stock_field_stock_unit"
                            app:endIconDrawable="@drawable/ic_arrow_drop_down"
                            app:endIconContentDescription="@string/base_cd_pick_option"
                            app:stockError="@{vm.fieldErrors[`pack_unit`]}"
                            app:stockHelper="@{vm.unitHelper}">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/stock_unit_input"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@{vm.packUnit}" />
                        </com.zhimu.slmp.base.widget.ZmtTextInputLayout>
                    </LinearLayout>

                    <com.zhimu.slmp.base.widget.ZmtTextInputLayout
                        android:id="@+id/stock_min_layout"
                        style="@style/Widget.Zmt.TextInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/base_space_4"
                        android:enabled="@{!safeUnbox(vm.banned)}"
                        android:hint="@string/stock_field_min_stock"
                        app:helperText="@string/stock_drug_min_helper"
                        app:helperTextEnabled="true"
                        app:stockError="@{vm.fieldErrors[`min_stock`]}"
                        app:suffixText="@{vm.packUnit}">

                        <com.google.android.material.textfield.TextInputEditText
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:digits="0123456789."
                            android:inputType="numberDecimal"
                            android:maxLength="11"
                            android:text="@={vm.minStock}"
                            android:textAppearance="@style/TextAppearance.Zmt.BodyLarge.Number" />
                    </com.zhimu.slmp.base.widget.ZmtTextInputLayout>

                    <com.google.android.material.card.MaterialCardView
                        style="@style/Widget.Zmt.Card.Summary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/base_space_4">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_schedule"
                                app:tint="?attr/colorOnSurfaceVariant" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/base_space_4"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@{vm.nearDaysText}"
                                    android:textAppearance="@style/TextAppearance.Zmt.TitleMedium"
                                    android:textColor="?attr/colorOnSurface" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@{vm.nearDaysSub}"
                                    android:textAppearance="@style/TextAppearance.Zmt.BodyMedium"
                                    android:textColor="?attr/colorOnSurfaceVariant" />
                            </LinearLayout>

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/stock_near_edit"
                                style="@style/Widget.Zmt.Button.Text"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:minHeight="@dimen/base_touch_target"
                                android:text="@string/stock_menu_edit"
                                app:visibleIf="@{!safeUnbox(vm.banned)}" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.zhimu.slmp.base.widget.NoticeView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/base_space_5"
                        app:noticeIcon="@drawable/ic_history"
                        app:noticeLevel="normal"
                        app:noticeText="@string/stock_drug_archive_rule" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/base_space_4"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        app:goneIfNull="@{vm.lastModified}">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/base_space_1"
                            android:layout_weight="1"
                            android:text="@{vm.lastModified}"
                            android:textAppearance="@style/TextAppearance.Zmt.BodySmall"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/stock_change_log"
                            style="@style/Widget.Zmt.Button.Text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/stock_menu_change_log" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>
        </com.zhimu.slmp.base.widget.StateLayout>

        <com.zhimu.slmp.base.widget.BottomActionBar
            android:id="@+id/stock_action_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:barPrimaryIcon="@drawable/ic_check"
            app:barPrimaryText="@string/stock_action_save" />
    </LinearLayout>
</layout>
