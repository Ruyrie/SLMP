<?xml version="1.0" encoding="utf-8"?>
<!-- “登记妊检”底部面板内容（图 5-3）：说明、妊检日期、妊检结果两行单选（阳性 / 阴性）；按钮“确认结果”由面板基类提供 -->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

        <import type="com.zhimu.slmp.breed.model.BreedCodes" />

        <variable
            name="host"
            type="com.zhimu.slmp.breed.ui.common.PregCheckHost" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/base_sheet_padding_horizontal"
        android:paddingEnd="@dimen/base_sheet_padding_horizontal">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@{host.checkSubtitle}"
            android:textAppearance="@style/TextAppearance.Zmt.BodyMedium.Number"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <com.zhimu.slmp.base.widget.ZmtTextInputLayout
            android:id="@+id/breed_check_date_layout"
            style="@style/Widget.Zmt.TextInputLayout.Picker"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/base_space_5"
            android:hint="@string/breed_field_check_date"
            app:breedError="@{host.checkErrors[`check_date`]}">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/breed_check_date_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:dateText="@{host.checkDate}"
                app:dateWithWeek="@{true}" />
        </com.zhimu.slmp.base.widget.ZmtTextInputLayout>

        <TextView
            style="@style/Widget.Zmt.TextView.FieldLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/base_space_5"
            android:text="@string/breed_field_check_result" />

        <LinearLayout
            android:id="@+id/breed_check_positive"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/breed_check_positive_radio"
                style="@style/Widget.Zmt.RadioButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="@{BreedCodes.POSITIVE.equals(host.checkResult)}"
                android:clickable="false"
                android:focusable="false"
                android:minWidth="0dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/base_space_2"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/breed_check_positive"
                    android:textAppearance="@style/TextAppearance.Zmt.BodyLarge"
                    android:textColor="?attr/colorOnSurface" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@{host.positiveHint}"
                    android:textAppearance="@style/TextAppearance.Zmt.BodyMedium.Number"
                    android:textColor="?attr/colorOnSurfaceVariant" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/breed_check_negative"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/breed_check_negative_radio"
                style="@style/Widget.Zmt.RadioButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="@{BreedCodes.NEGATIVE.equals(host.checkResult)}"
                android:clickable="false"
                android:focusable="false"
                android:minWidth="0dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/base_space_2"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/breed_check_negative"
                    android:textAppearance="@style/TextAppearance.Zmt.BodyLarge"
                    android:textColor="?attr/colorOnSurface" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/breed_check_negative_desc"
                    android:textAppearance="@style/TextAppearance.Zmt.BodyMedium"
                    android:textColor="?attr/colorOnSurfaceVariant" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/base_space_4"
            android:text="@{host.checkErrors[`result`]}"
            android:textAppearance="@style/TextAppearance.Zmt.BodySmall"
            android:textColor="?attr/colorError"
            app:goneIfNull="@{host.checkErrors[`result`]}" />
    </LinearLayout>
</layout>
