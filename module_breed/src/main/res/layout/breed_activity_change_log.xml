<?xml version="1.0" encoding="utf-8"?>
<!-- 修改记录整页列表：每项“{修改时间} · {修改人}”，说明“{字段}：{原值} → {新值}”，按时间倒序 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:orientation="vertical">

    <include
        android:id="@+id/breed_top_bar"
        layout="@layout/base_include_top_app_bar" />

    <com.zhimu.slmp.base.widget.StateLayout
        android:id="@+id/breed_state"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        app:stateEmptyIcon="@drawable/ic_history"
        app:stateEmptyTitle="@string/breed_log_empty"
        app:stateErrorTitle="@string/breed_error_title"
        app:stateNoPermissionTitle="@string/breed_no_permission_title">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/breed_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="@dimen/base_page_margin"
            android:paddingTop="@dimen/base_space_2"
            android:paddingEnd="@dimen/base_page_margin"
            android:paddingBottom="@dimen/base_space_6" />
    </com.zhimu.slmp.base.widget.StateLayout>
</LinearLayout>
