<?xml version="1.0" encoding="utf-8"?>
<!--
    B03 登记配种 / 妊检（图 5-3）：母猪下拉（状态标签）、配种日期、配种方式 Chip、系统推算预产期卡、与配公猪（选填）；
    下方“待妊检 · n 头”列表；底部“登记配种”（只提交上半部分）。修改模式母猪只读，不显示推算卡与待妊检。
-->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

        <import type="com.zhimu.slmp.breed.model.BreedCodes" />

        <import type="com.zhimu.slmp.breed.util.BreedTextFormatter" />

        <variable
            name="vm"
            type="com.zhimu.slmp.breed.ui.mating.MatingRegisterViewModel" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/colorSurface"
        android:orientation="vertical">

        <include
            android:id="@+id/breed_top_bar"
            layout="@layout/base_include_top_app_bar"
            app:title="@{vm.editMode ? @string/breed_mating_edit_title : @string/breed_mating_title}" />

        <com.zhimu.slmp.base.widget.StateLayout
            android:id="@+id/breed_state"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            app:stateErrorTitle="@string/breed_error_title"
            app:stateNoPermissionTitle="@string/breed_no_permission_title"
            app:stateSkeletonLayout="@layout/base_skeleton_detail">

            <androidx.core.widget.NestedScrollView
                android:id="@+id/breed_scroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/base_page_margin"
                    android:paddingTop="@dimen/base_space_5"
                    android:paddingEnd="@dimen/base_page_margin"
                    android:paddingBottom="@dimen/base_space_6">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <com.zhimu.slmp.base.widget.ZmtTextInputLayout
                            android:id="@+id/breed_animal_layout"
                            style="@style/Widget.Zmt.TextInputLayout.Dropdown"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:enabled="@{!vm.editMode}"
                            android:hint="@string/breed_field_animal"
                            app:breedError="@{vm.fieldErrors[`animal_id`]}"
                            app:helperText="@{vm.editMode ? null : @string/breed_mating_animal_helper}"
                            app:helperTextEnabled="true">

                            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                                android:id="@+id/breed_animal_input"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="none"
                                android:paddingEnd="96dp"
                                android:textAppearance="@style/TextAppearance.Zmt.BodyLarge.Number" />
                        </com.zhimu.slmp.base.widget.ZmtTextInputLayout>

                        <com.zhimu.slmp.base.widget.StatusTagView
                            android:id="@+id/breed_animal_tag"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="end|top"
                            android:layout_marginTop="21dp"
                            android:layout_marginEnd="52dp"
                            app:breedStatus="@{vm.selectedAnimal.status}"
                            app:breedStatusText="@{vm.editMode ? null : vm.selectedAnimal.statusText}" />
                    </FrameLayout>

                    <com.zhimu.slmp.base.widget.ZmtTextInputLayout
                        android:id="@+id/breed_date_layout"
                        style="@style/Widget.Zmt.TextInputLayout.Picker"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/base_form_field_gap"
                        android:hint="@string/breed_field_mating_date"
                        app:breedError="@{vm.fieldErrors[`mating_date`]}">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/breed_date_input"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:dateText="@{vm.matingDate}"
                            app:dateWithWeek="@{true}" />
                    </com.zhimu.slmp.base.widget.ZmtTextInputLayout>

                    <TextView
                        style="@style/Widget.Zmt.TextView.FieldLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/base_space_5"
                        android:text="@string/breed_field_mating_method" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/breed_method_chips"
                        style="@style/Widget.Zmt.ChipGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/base_space_1"
                        app:selectionRequired="true"
                        app:singleSelection="true">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/breed_method_artificial"
                            style="@style/Widget.Zmt.Chip.Choice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="@{BreedCodes.METHOD_ARTIFICIAL.equals(vm.matingMethod)}"
                            android:text="@string/breed_method_artificial" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/breed_method_natural"
                            style="@style/Widget.Zmt.Chip.Choice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="@{BreedCodes.METHOD_NATURAL.equals(vm.matingMethod)}"
                            android:text="@string/breed_method_natural" />
                    </com.google.android.material.chip.ChipGroup>

                    <com.google.android.material.card.MaterialCardView
                        style="@style/Widget.Zmt.Card.Summary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/base_space_4"
                        app:visibleIf="@{!vm.editMode}">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <FrameLayout
                                android:id="@+id/breed_due_icon_box"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:background="@drawable/breed_bg_leading">

                                <ImageView
                                    android:id="@+id/breed_due_icon"
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:layout_gravity="center"
                                    android:importantForAccessibility="no"
                                    android:src="@drawable/breed_ic_event" />
                            </FrameLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/base_space_4"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/breed_due_card_label"
                                    android:textAppearance="@style/TextAppearance.Zmt.BodyMedium"
                                    android:textColor="?attr/colorOnSurfaceVariant" />

                                <TextView
                                    android:id="@+id/breed_due_date"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="@{vm.expectedDueDate == null ? @string/breed_due_card_pending : BreedTextFormatter.fullDate(vm.expectedDueDate)}"
                                    android:textAppearance="@style/TextAppearance.Zmt.TitleLarge.Number"
                                    android:textColor="?attr/colorOnSurface" />

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="@{vm.dueNote}"
                                    android:textAppearance="@style/TextAppearance.Zmt.BodyMedium"
                                    android:textColor="?attr/colorOnSurfaceVariant"
                                    app:goneIfNull="@{vm.dueNote}" />
                            </LinearLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.zhimu.slmp.base.widget.ZmtTextInputLayout
                        style="@style/Widget.Zmt.TextInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/base_space_4"
                        android:hint="@string/breed_field_boar"
                        app:breedError="@{vm.fieldErrors[`boar_info`]}"
                        app:counterEnabled="true"
                        app:counterMaxLength="20"
                        app:placeholderText="@string/breed_boar_hint">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/breed_boar_input"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text"
                            android:maxLength="20"
                            android:text="@={vm.boarInfo}" />
                    </com.zhimu.slmp.base.widget.ZmtTextInputLayout>

                    <TextView
                        android:id="@+id/breed_pending_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/base_space_1"
                        android:layout_marginTop="@dimen/base_space_6"
                        android:layout_marginBottom="@dimen/base_space_2"
                        android:textAppearance="@style/TextAppearance.Zmt.TitleSmall"
                        android:textColor="?attr/colorPrimary" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/breed_pending_list"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false" />
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>
        </com.zhimu.slmp.base.widget.StateLayout>

        <com.zhimu.slmp.base.widget.BottomActionBar
            android:id="@+id/breed_action_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:tag="snackbar_anchor"
            app:barPrimaryText="@string/breed_action_register_mating" />
    </LinearLayout>
</layout>
