<?xml version="1.0" encoding="utf-8"?>
<!-- B02 待产与待出雏（图 5-2）：顶部栏 search；连接按钮组“待产 11 / 待出雏”；下方为各分段的列表（Fragment） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:orientation="vertical">

    <include
        android:id="@+id/breed_top_bar"
        layout="@layout/base_include_top_app_bar" />

    <include
        android:id="@+id/breed_search"
        layout="@layout/breed_include_search_bar" />

    <com.zhimu.slmp.base.widget.StateLayout
        android:id="@+id/breed_state"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        app:stateErrorTitle="@string/breed_error_title"
        app:stateNoPermissionTitle="@string/breed_no_permission_title"
        app:stateSkeletonLayout="@layout/base_skeleton_list">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <com.zhimu.slmp.base.widget.ConnectedButtonGroup
                android:id="@+id/breed_tabs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/base_page_margin"
                android:layout_marginTop="@dimen/base_space_1"
                android:layout_marginEnd="@dimen/base_page_margin"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/breed_tab_farrow"
                    style="@style/Widget.Zmt.Button.Connected"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/breed_tab_farrow" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/breed_tab_hatch"
                    style="@style/Widget.Zmt.Button.Connected"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/breed_tab_hatch" />
            </com.zhimu.slmp.base.widget.ConnectedButtonGroup>

            <FrameLayout
                android:id="@+id/breed_due_container"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />
        </LinearLayout>
    </com.zhimu.slmp.base.widget.StateLayout>
</LinearLayout>
