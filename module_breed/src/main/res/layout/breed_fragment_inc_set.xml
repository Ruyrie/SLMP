<?xml version="1.0" encoding="utf-8"?>
<!-- B07 第 1 步“入孵登记”：入孵日期、种禽群（栏舍名 · 批次号）、入孵蛋数、预计出雏日推算卡 -->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

        <import type="com.zhimu.slmp.breed.util.BreedTextFormatter" />

        <variable
            name="vm"
            type="com.zhimu.slmp.breed.ui.incubation.IncubationViewModel" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            style="@style/breed_section_title"
            android:text="@string/breed_section_set" />

        <com.zhimu.slmp.base.widget.ZmtTextInputLayout
            android:id="@+id/breed_set_date_layout"
            style="@style/Widget.Zmt.TextInputLayout.Picker"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/breed_field_set_date"
            app:breedError="@{vm.fieldErrors[`set_date`]}">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/breed_set_date_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:dateText="@{vm.setDate}"
                app:dateWithWeek="@{true}" />
        </com.zhimu.slmp.base.widget.ZmtTextInputLayout>

        <com.zhimu.slmp.base.widget.ZmtTextInputLayout
            android:id="@+id/breed_flock_layout"
            style="@style/Widget.Zmt.TextInputLayout.Dropdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/base_space_3"
            android:hint="@string/breed_field_flock"
            app:breedError="@{vm.fieldErrors[`breeding_batch_id`]}"
            app:helperText="@string/breed_flock_helper"
            app:helperTextEnabled="true">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/breed_flock_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none" />
        </com.zhimu.slmp.base.widget.ZmtTextInputLayout>

        <com.zhimu.slmp.base.widget.ZmtTextInputLayout
            android:id="@+id/breed_set_count_layout"
            style="@style/Widget.Zmt.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/base_space_3"
            android:hint="@string/breed_field_set_count"
            app:breedError="@{vm.fieldErrors[`set_count`]}"
            app:suffixText="@string/breed_unit_egg">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/breed_set_count_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:maxLength="6"
                android:text="@={vm.setCount}"
                android:textAppearance="@style/TextAppearance.Zmt.BodyLarge.Number" />
        </com.zhimu.slmp.base.widget.ZmtTextInputLayout>

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Zmt.Card.Summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/base_space_4">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/breed_hatch_icon_box"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/breed_bg_leading">

                    <ImageView
                        android:id="@+id/breed_hatch_icon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/breed_ic_event" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/base_space_4"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/breed_hatch_card_label"
                        android:textAppearance="@style/TextAppearance.Zmt.BodyMedium"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@{vm.expectedHatchPreview == null ? (vm.selectedFlockId == null ? @string/breed_hatch_card_pending : @string/breed_hatch_card_unknown) : BreedTextFormatter.fullDate(vm.expectedHatchPreview)}"
                        android:textAppearance="@style/TextAppearance.Zmt.TitleLarge.Number"
                        android:textColor="?attr/colorOnSurface" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@{vm.hatchCardNote}"
                        android:textAppearance="@style/TextAppearance.Zmt.BodyMedium"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        app:goneIfNull="@{vm.expectedHatchPreview == null ? null : vm.hatchCardNote}" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</layout>
