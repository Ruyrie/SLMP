<?xml version="1.0" encoding="utf-8"?>
<!-- 搜索态顶部栏（UI 2.4“点顶部栏 search”）：surface-container-high 底、圆角 28 dp；返回退出搜索，清空按钮 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/breed_search_bar"
    android:layout_width="match_parent"
    android:layout_height="@dimen/base_top_bar_height"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/base_space_2"
    android:paddingEnd="@dimen/base_space_2"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/breed_bg_search"
        android:backgroundTint="?attr/colorSurfaceContainerHigh"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/breed_search_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="@dimen/base_space_1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/breed_cd_close_search"
            android:src="@drawable/ic_arrow_back"
            app:tint="?attr/colorOnSurfaceVariant" />

        <EditText
            android:id="@+id/breed_search_input"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@null"
            android:imeOptions="actionSearch"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLength="20"
            android:singleLine="true"
            android:textAppearance="@style/TextAppearance.Zmt.BodyLarge"
            android:textColor="?attr/colorOnSurface"
            android:textColorHint="?attr/colorOnSurfaceVariant" />

        <ImageButton
            android:id="@+id/breed_search_clear"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="@dimen/base_space_1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/breed_cd_clear"
            android:src="@drawable/ic_close"
            app:tint="?attr/colorOnSurfaceVariant" />
    </LinearLayout>
</LinearLayout>
