<?xml version="1.0" encoding="utf-8"?>
<!-- “登记死亡 / 淘汰”底部面板内容：连接按钮组“淘汰 / 死亡”、日期（默认今天）、原因（必填，最多 50 字）；按钮“确认登记” -->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

        <variable
            name="vm"
            type="com.zhimu.slmp.breed.ui.archive.AnimalArchiveViewModel" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/base_sheet_padding_horizontal"
        android:paddingEnd="@dimen/base_sheet_padding_horizontal">

        <com.zhimu.slmp.base.widget.ConnectedButtonGroup
            android:id="@+id/breed_exit_type"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/breed_exit_cull"
                style="@style/Widget.Zmt.Button.Connected"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/breed_exit_cull" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/breed_exit_death"
                style="@style/Widget.Zmt.Button.Connected"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/breed_exit_death" />
        </com.zhimu.slmp.base.widget.ConnectedButtonGroup>

        <com.zhimu.slmp.base.widget.ZmtTextInputLayout
            android:id="@+id/breed_exit_date_layout"
            style="@style/Widget.Zmt.TextInputLayout.Picker"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/base_space_4"
            android:hint="@string/breed_field_exit_date"
            app:breedError="@{vm.fieldErrors[`exit_date`]}">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/breed_exit_date_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:dateText="@{vm.exitDate}"
                app:dateWithWeek="@{true}" />
        </com.zhimu.slmp.base.widget.ZmtTextInputLayout>

        <com.zhimu.slmp.base.widget.ZmtTextInputLayout
            style="@style/Widget.Zmt.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/base_space_3"
            android:hint="@string/breed_field_reason"
            app:breedError="@{vm.fieldErrors[`reason`]}"
            app:counterEnabled="true"
            app:counterMaxLength="50">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/breed_exit_reason_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textMultiLine"
                android:maxLength="50"
                android:text="@={vm.exitReason}" />
        </com.zhimu.slmp.base.widget.ZmtTextInputLayout>
    </LinearLayout>
</layout>
