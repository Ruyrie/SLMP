<?xml version="1.0" encoding="utf-8"?>
<!-- B06 种畜档案：顶部栏 more_vert；头部（档案信息、繁育表现）与繁育记录在同一列表中整体滚动，支持下拉刷新 -->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

        <variable
            name="vm"
            type="com.zhimu.slmp.breed.ui.archive.AnimalArchiveViewModel" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/colorSurface"
        android:orientation="vertical">

        <include
            android:id="@+id/breed_top_bar"
            layout="@layout/base_include_top_app_bar"
            app:title="@{@string/breed_archive_title}" />

        <com.zhimu.slmp.base.widget.StateLayout
            android:id="@+id/breed_state"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            app:stateErrorTitle="@string/breed_error_title"
            app:stateNoPermissionTitle="@string/breed_no_permission_title"
            app:stateSkeletonLayout="@layout/base_skeleton_detail">

            <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
                android:id="@+id/breed_refresh"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/breed_list"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingStart="@dimen/base_page_margin"
                    android:paddingTop="@dimen/base_space_2"
                    android:paddingEnd="@dimen/base_page_margin"
                    android:paddingBottom="@dimen/base_space_6" />
            </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
        </com.zhimu.slmp.base.widget.StateLayout>
    </LinearLayout>
</layout>
