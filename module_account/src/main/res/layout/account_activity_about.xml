<?xml version="1.0" encoding="utf-8"?>
<!-- 关于页：二级页顶部栏“关于智牧通”；居中“智牧通”28 sp primary 加粗、“版本 1.0.0”；分组列表“用户协议”“隐私政策” -->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

        <variable
            name="vm"
            type="com.zhimu.slmp.account.ui.about.AboutViewModel" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/colorSurface"
        android:orientation="vertical">

        <include
            android:id="@+id/account_about_top_bar"
            layout="@layout/base_include_top_app_bar"
            app:title="@{@string/account_about_title}" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="48dp"
            android:text="@string/account_app_name"
            android:textAppearance="@style/TextAppearance.Zmt.HeadlineMedium"
            android:textColor="?attr/colorPrimary"
            android:textStyle="bold" />

        <TextView
            style="@style/account_style_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/base_space_1"
            android:text="@{vm.versionName}" />

        <com.zhimu.slmp.base.widget.GroupedListLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/base_page_margin"
            android:layout_marginTop="40dp"
            android:layout_marginEnd="@dimen/base_page_margin">

            <com.zhimu.slmp.base.widget.ListRowView
                android:id="@+id/account_about_user_agreement"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:rowShowChevron="true"
                app:rowTitle="@string/account_about_user_agreement" />

            <com.zhimu.slmp.base.widget.ListRowView
                android:id="@+id/account_about_privacy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:rowShowChevron="true"
                app:rowTitle="@string/account_about_privacy_policy" />
        </com.zhimu.slmp.base.widget.GroupedListLayout>
    </LinearLayout>
</layout>
