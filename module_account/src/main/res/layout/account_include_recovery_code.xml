<?xml version="1.0" encoding="utf-8"?>
<!-- 恢复码内容区（A04、A06 第 2 步共用）：说明行、恢复码卡片（复制 / 保存为图片）、警示横幅、用途说明列表、确认勾选 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/base_page_margin"
    android:paddingEnd="@dimen/base_page_margin"
    android:paddingBottom="@dimen/base_space_6">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/base_space_2"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/account_code_desc_icon"
            android:layout_width="@dimen/base_list_leading_size"
            android:layout_height="@dimen/base_list_leading_size"
            android:background="@drawable/account_bg_leading_secondary"
            android:contentDescription="@null"
            android:padding="8dp"
            android:src="@drawable/account_ic_key"
            app:tint="?attr/colorOnSecondaryContainer" />

        <TextView
            android:id="@+id/account_code_desc"
            style="@style/account_style_desc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/base_space_4"
            android:layout_weight="1" />
    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/base_space_4"
        app:cardBackgroundColor="?attr/colorSurfaceContainerLowest"
        app:cardCornerRadius="@dimen/base_radius_xl"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="@dimen/base_space_4">

            <TextView
                style="@style/account_style_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/base_space_1"
                android:text="@string/account_code_card_label" />

            <com.zhimu.slmp.account.widget.RecoveryCodeView
                android:id="@+id/account_code_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/base_space_3" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/base_space_4"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/account_code_copy"
                    style="@style/Widget.Zmt.Button.Tonal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/base_space_1"
                    android:layout_weight="1"
                    android:text="@string/account_code_copy"
                    app:icon="@drawable/ic_content_copy"
                    app:iconSize="20dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/account_code_save"
                    style="@style/Widget.Zmt.Button.Tonal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/base_space_1"
                    android:layout_weight="1"
                    android:text="@string/account_code_save_image"
                    app:icon="@drawable/ic_download"
                    app:iconSize="20dp" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.zhimu.slmp.base.widget.NoticeView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/base_space_4"
        app:noticeLevel="warning"
        app:noticeText="@string/account_code_warning_text"
        app:noticeTitle="@string/account_code_warning_title" />

    <com.zhimu.slmp.base.widget.GroupedListLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/base_space_4">

        <com.zhimu.slmp.base.widget.ListRowView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:leadingTone="neutral"
            app:rowLeadingIcon="@drawable/account_ic_phonelink_erase"
            app:rowSubtitle="@string/account_code_use_recover_desc"
            app:rowTitle="@string/account_code_use_recover" />

        <com.zhimu.slmp.base.widget.ListRowView
            android:id="@+id/account_code_use_regenerate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:leadingTone="neutral"
            app:rowLeadingIcon="@drawable/account_ic_autorenew"
            app:rowSubtitle="@string/account_code_use_regenerate_desc"
            app:rowTitle="@string/account_code_use_regenerate" />
    </com.zhimu.slmp.base.widget.GroupedListLayout>

    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/account_code_saved"
        style="@style/account_style_check"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="-6dp"
        android:layout_marginTop="@dimen/base_space_4"
        android:text="@string/account_code_saved_check" />
</LinearLayout>
