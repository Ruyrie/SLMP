<?xml version="1.0" encoding="utf-8"?>
<!-- A03 重置密码：说明、手机号、短信验证码、新密码、失效提示横幅、“申请找回账号”入口；底部固定“重置密码” -->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

        <variable
            name="vm"
            type="com.zhimu.slmp.account.ui.reset.ResetPasswordViewModel" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/colorSurface"
        android:orientation="vertical">

        <include
            android:id="@+id/account_reset_top_bar"
            layout="@layout/base_include_top_app_bar"
            app:title="@{@string/account_reset_title}" />

        <androidx.core.widget.NestedScrollView
            android:id="@+id/account_reset_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/base_page_margin"
                android:paddingEnd="@dimen/base_page_margin"
                android:paddingBottom="@dimen/base_space_6">

                <TextView
                    style="@style/account_style_desc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/base_space_5"
                    android:text="@string/account_reset_desc" />

                <com.zhimu.slmp.base.widget.ZmtTextInputLayout
                    android:id="@+id/account_reset_phone"
                    style="@style/account_style_field"
                    android:hint="@string/account_field_phone"
                    app:prefixText="@string/account_phone_prefix">

                    <com.google.android.material.textfield.TextInputEditText
                        style="@style/account_style_edit"
                        android:autofillHints="phone"
                        android:imeOptions="actionNext"
                        android:inputType="phone"
                        android:text="@={vm.phone}" />
                </com.zhimu.slmp.base.widget.ZmtTextInputLayout>

                <com.zhimu.slmp.base.widget.ZmtTextInputLayout
                    android:id="@+id/account_reset_sms"
                    style="@style/account_style_field"
                    android:hint="@string/account_field_sms_code">

                    <com.google.android.material.textfield.TextInputEditText
                        style="@style/account_style_edit"
                        android:autofillHints="smsOTPCode"
                        android:imeOptions="actionNext"
                        android:inputType="number"
                        android:text="@={vm.smsCode}" />
                </com.zhimu.slmp.base.widget.ZmtTextInputLayout>

                <com.zhimu.slmp.base.widget.ZmtTextInputLayout
                    android:id="@+id/account_reset_password"
                    style="@style/account_style_field"
                    android:hint="@string/account_field_new_password"
                    app:endIconMode="password_toggle"
                    app:helperText="@string/account_password_rule">

                    <com.google.android.material.textfield.TextInputEditText
                        style="@style/account_style_edit"
                        android:autofillHints="newPassword"
                        android:imeOptions="actionDone"
                        android:inputType="textPassword"
                        android:text="@={vm.newPassword}" />
                </com.zhimu.slmp.base.widget.ZmtTextInputLayout>

                <com.zhimu.slmp.base.widget.NoticeView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/base_space_6"
                    app:noticeIcon="@drawable/account_ic_devices"
                    app:noticeLevel="normal"
                    app:noticeText="@string/account_reset_notice" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="@dimen/base_space_5"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/account_style_desc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/account_reset_lost_phone" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/account_reset_apply_recovery"
                        style="@style/Widget.Zmt.Button.Text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/account_reset_apply_recovery" />
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <com.zhimu.slmp.base.widget.BottomActionBar
            android:id="@+id/account_reset_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:barLoading="@{vm.submitting}"
            app:barPrimaryEnabled="@{vm.canSubmit}"
            app:barPrimaryText="@string/account_reset_submit" />
    </LinearLayout>
</layout>
