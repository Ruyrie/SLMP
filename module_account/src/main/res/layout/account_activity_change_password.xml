<?xml version="1.0" encoding="utf-8"?>
<!-- 修改密码页：说明；当前密码、新密码、再次输入新密码；底部固定“修改密码” -->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

        <variable
            name="vm"
            type="com.zhimu.slmp.account.ui.password.ChangePasswordViewModel" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/colorSurface"
        android:orientation="vertical">

        <include
            android:id="@+id/account_password_top_bar"
            layout="@layout/base_include_top_app_bar"
            app:title="@{@string/account_password_title}" />

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/base_page_margin"
                android:paddingEnd="@dimen/base_page_margin"
                android:paddingBottom="@dimen/base_space_6">

                <TextView
                    style="@style/account_style_desc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/base_space_5"
                    android:text="@string/account_password_desc" />

                <com.zhimu.slmp.base.widget.ZmtTextInputLayout
                    android:id="@+id/account_password_current"
                    style="@style/account_style_field"
                    android:hint="@string/account_password_current"
                    app:endIconMode="password_toggle">

                    <com.google.android.material.textfield.TextInputEditText
                        style="@style/account_style_edit"
                        android:autofillHints="password"
                        android:imeOptions="actionNext"
                        android:inputType="textPassword"
                        android:text="@={vm.currentPassword}" />
                </com.zhimu.slmp.base.widget.ZmtTextInputLayout>

                <com.zhimu.slmp.base.widget.ZmtTextInputLayout
                    android:id="@+id/account_password_new"
                    style="@style/account_style_field"
                    android:hint="@string/account_field_new_password"
                    app:endIconMode="password_toggle"
                    app:helperText="@string/account_password_rule">

                    <com.google.android.material.textfield.TextInputEditText
                        style="@style/account_style_edit"
                        android:autofillHints="newPassword"
                        android:imeOptions="actionNext"
                        android:inputType="textPassword"
                        android:text="@={vm.newPassword}" />
                </com.zhimu.slmp.base.widget.ZmtTextInputLayout>

                <com.zhimu.slmp.base.widget.ZmtTextInputLayout
                    android:id="@+id/account_password_confirm"
                    style="@style/account_style_field"
                    android:hint="@string/account_field_confirm_password"
                    app:endIconMode="password_toggle"
                    app:placeholderText="@string/account_field_confirm_placeholder">

                    <com.google.android.material.textfield.TextInputEditText
                        style="@style/account_style_edit"
                        android:imeOptions="actionDone"
                        android:inputType="textPassword"
                        android:text="@={vm.confirmPassword}" />
                </com.zhimu.slmp.base.widget.ZmtTextInputLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <com.zhimu.slmp.base.widget.BottomActionBar
            android:id="@+id/account_password_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:barLoading="@{vm.submitting}"
            app:barPrimaryEnabled="@{vm.canSubmit}"
            app:barPrimaryText="@string/account_password_submit" />
    </LinearLayout>
</layout>
