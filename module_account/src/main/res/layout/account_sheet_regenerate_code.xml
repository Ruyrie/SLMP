<?xml version="1.0" encoding="utf-8"?>
<!-- A08 重新生成恢复码面板内容：短信验证码输入框（尾部“获取验证码”/倒计时，辅助文字“验证码已发送至 138****6620”） -->
<layout xmlns:android="http://schemas.android.com/apk/res/android">

    <data>

        <variable
            name="vm"
            type="com.zhimu.slmp.account.ui.security.AccountSecurityViewModel" />
    </data>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/base_sheet_padding_horizontal"
        android:paddingEnd="@dimen/base_sheet_padding_horizontal"
        android:paddingBottom="@dimen/base_space_2">

        <com.zhimu.slmp.base.widget.ZmtTextInputLayout
            android:id="@+id/account_regenerate_sms"
            style="@style/account_style_field"
            android:layout_marginTop="@dimen/base_space_4"
            android:hint="@string/account_field_sms_code">

            <com.google.android.material.textfield.TextInputEditText
                style="@style/account_style_edit"
                android:autofillHints="smsOTPCode"
                android:imeOptions="actionDone"
                android:inputType="number"
                android:text="@={vm.smsCode}" />
        </com.zhimu.slmp.base.widget.ZmtTextInputLayout>
    </FrameLayout>
</layout>
