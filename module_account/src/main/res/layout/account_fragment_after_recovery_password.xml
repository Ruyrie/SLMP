<?xml version="1.0" encoding="utf-8"?>
<!-- A06 第 1 步：账号已找回横幅、新密码、再次输入新密码、下一步说明卡、注销限制横幅 -->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

        <variable
            name="vm"
            type="com.zhimu.slmp.account.ui.afterrecovery.AfterRecoveryViewModel" />
    </data>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/base_page_margin"
            android:paddingEnd="@dimen/base_page_margin"
            android:paddingBottom="@dimen/base_space_6">

            <com.zhimu.slmp.base.widget.NoticeView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/base_space_5"
                android:visibility="gone"
                app:accountNotice="@{vm.accountBanner}"
                app:noticeIcon="@drawable/account_ic_verified_user"
                app:noticeLevel="normal" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/account_after_new_password"
                style="@style/account_style_field"
                android:hint="@string/account_field_new_password"
                app:endIconMode="password_toggle"
                app:helperText="@string/account_after_password_rule">

                <com.google.android.material.textfield.TextInputEditText
                    style="@style/account_style_edit"
                    android:autofillHints="newPassword"
                    android:imeOptions="actionNext"
                    android:inputType="textPassword"
                    android:text="@={vm.newPassword}" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/account_after_confirm_password"
                style="@style/account_style_field"
                android:hint="@string/account_field_confirm_password"
                app:endIconMode="password_toggle"
                app:placeholderText="@string/account_field_confirm_placeholder">

                <com.google.android.material.textfield.TextInputEditText
                    style="@style/account_style_edit"
                    android:imeOptions="actionDone"
                    android:inputType="textPassword"
                    android:text="@={vm.confirmPassword}" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.zhimu.slmp.base.widget.ListRowView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/base_space_6"
                app:leadingTone="neutral"
                app:rowLeadingIcon="@drawable/account_ic_key"
                app:rowSubtitle="@string/account_after_next_desc"
                app:rowTitle="@string/account_after_next_title" />

            <com.zhimu.slmp.base.widget.NoticeView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/base_space_5"
                android:visibility="gone"
                app:accountNotice="@{vm.cancelBanner}"
                app:noticeIcon="@drawable/account_ic_event_busy"
                app:noticeLevel="warning" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</layout>
