<?xml version="1.0" encoding="utf-8"?>
<!-- A02 注册账号：二级页顶部栏；说明、手机号、短信验证码、设置密码、协议勾选；底部固定“注册” -->
<!-- 相邻输入框上边距 18 dp、手机号框 drawablePadding 的原因见 account_activity_login.xml 顶部注释 -->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

        <variable
            name="vm"
            type="com.zhimu.slmp.account.ui.register.RegisterViewModel" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/colorSurface"
        android:orientation="vertical">

        <include
            android:id="@+id/account_register_top_bar"
            layout="@layout/base_include_top_app_bar"
            app:title="@{@string/account_register_title}" />

        <androidx.core.widget.NestedScrollView
            android:id="@+id/account_register_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/base_page_margin"
                android:paddingEnd="@dimen/base_page_margin"
                android:paddingBottom="@dimen/base_space_6">

                <TextView
                    style="@style/account_style_desc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/base_space_5"
                    android:text="@string/account_register_desc" />

                <com.zhimu.slmp.base.widget.ZmtTextInputLayout
                    android:id="@+id/account_register_phone"
                    style="@style/account_style_field"
                    android:layout_marginTop="18dp"
                    android:hint="@string/account_field_phone"
                    app:helperText="@string/account_register_phone_helper"
                    app:prefixText="@string/account_phone_prefix">

                    <com.google.android.material.textfield.TextInputEditText
                        style="@style/account_style_edit"
                        android:autofillHints="phone"
                        android:drawablePadding="@dimen/base_space_2"
                        android:imeOptions="actionNext"
                        android:inputType="phone"
                        android:text="@={vm.phone}" />
                </com.zhimu.slmp.base.widget.ZmtTextInputLayout>

                <com.zhimu.slmp.base.widget.ZmtTextInputLayout
                    android:id="@+id/account_register_sms"
                    style="@style/account_style_field"
                    android:layout_marginTop="18dp"
                    android:hint="@string/account_field_sms_code">

                    <com.google.android.material.textfield.TextInputEditText
                        style="@style/account_style_edit"
                        android:autofillHints="smsOTPCode"
                        android:imeOptions="actionNext"
                        android:inputType="number"
                        android:text="@={vm.smsCode}" />
                </com.zhimu.slmp.base.widget.ZmtTextInputLayout>

                <com.zhimu.slmp.base.widget.ZmtTextInputLayout
                    android:id="@+id/account_register_password"
                    style="@style/account_style_field"
                    android:layout_marginTop="18dp"
                    android:hint="@string/account_register_set_password"
                    app:endIconMode="password_toggle"
                    app:helperText="@string/account_password_rule">

                    <com.google.android.material.textfield.TextInputEditText
                        style="@style/account_style_edit"
                        android:autofillHints="newPassword"
                        android:imeOptions="actionDone"
                        android:inputType="textPassword"
                        android:text="@={vm.password}" />
                </com.zhimu.slmp.base.widget.ZmtTextInputLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="-6dp"
                    android:layout_marginTop="@dimen/base_space_3"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.checkbox.MaterialCheckBox
                        android:id="@+id/account_register_agree"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="@={vm.agreeTerms}" />

                    <TextView
                        android:id="@+id/account_register_agree_text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textAppearance="@style/TextAppearance.Zmt.BodyMedium"
                        android:textColor="?attr/colorOnSurface" />
                </LinearLayout>

                <TextView
                    android:id="@+id/account_register_agree_error"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="42dp"
                    android:textAppearance="@style/TextAppearance.Zmt.BodySmall"
                    android:textColor="?attr/colorError"
                    android:visibility="gone" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <com.zhimu.slmp.base.widget.BottomActionBar
            android:id="@+id/account_register_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:barLoading="@{vm.submitting}"
            app:barPrimaryEnabled="@{vm.canSubmit}"
            app:barPrimaryText="@string/account_register_submit" />
    </LinearLayout>
</layout>
