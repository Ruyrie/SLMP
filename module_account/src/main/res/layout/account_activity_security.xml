<?xml version="1.0" encoding="utf-8"?>
<!-- A08 账号与安全：登录（手机号、修改密码）、恢复码（重新生成 + 说明横幅）、注销（注销账号） -->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

        <variable
            name="vm"
            type="com.zhimu.slmp.account.ui.security.AccountSecurityViewModel" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/colorSurface"
        android:orientation="vertical">

        <include
            android:id="@+id/account_security_top_bar"
            layout="@layout/base_include_top_app_bar"
            app:title="@{@string/account_security_title}" />

        <com.zhimu.slmp.base.widget.StateLayout
            android:id="@+id/account_security_state"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            app:stateErrorTitle="@string/account_security_error_title"
            app:uiState="@{vm.uiState}">

            <androidx.core.widget.NestedScrollView
                android:id="@+id/account_security_scroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/base_page_margin"
                    android:paddingEnd="@dimen/base_page_margin"
                    android:paddingBottom="@dimen/base_space_6">

                    <TextView
                        style="@style/account_style_section_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/base_space_2"
                        android:text="@string/account_security_section_login" />

                    <com.zhimu.slmp.base.widget.GroupedListLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <com.zhimu.slmp.base.widget.ListRowView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:rowLeadingIcon="@drawable/ic_smartphone"
                            app:rowSubtitle="@string/account_security_phone_desc"
                            app:rowTitle="@{vm.security.phoneMasked}" />

                        <com.zhimu.slmp.base.widget.ListRowView
                            android:id="@+id/account_security_password"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:rowLeadingIcon="@drawable/ic_lock"
                            app:rowShowChevron="true"
                            app:rowSubtitle="@string/account_security_change_password_desc"
                            app:rowTitle="@string/account_security_change_password" />
                    </com.zhimu.slmp.base.widget.GroupedListLayout>

                    <TextView
                        style="@style/account_style_section_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/account_security_section_code" />

                    <com.zhimu.slmp.base.widget.ListRowView
                        android:id="@+id/account_security_regenerate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:rowLeadingIcon="@drawable/account_ic_key"
                        app:rowShowChevron="true"
                        app:rowSubtitle="@string/account_security_regenerate_desc"
                        app:rowTitle="@string/account_security_regenerate" />

                    <com.zhimu.slmp.base.widget.NoticeView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/base_space_4"
                        app:noticeLevel="normal"
                        app:noticeText="@string/account_security_code_notice" />

                    <TextView
                        style="@style/account_style_section_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/account_security_section_cancel" />

                    <com.zhimu.slmp.base.widget.ListRowView
                        android:id="@+id/account_security_cancel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:leadingTone="error"
                        app:rowLeadingIcon="@drawable/account_ic_no_accounts"
                        app:rowShowChevron="true"
                        app:rowSubtitle="@string/account_security_cancel_desc"
                        app:rowTitle="@string/account_security_cancel" />
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>
        </com.zhimu.slmp.base.widget.StateLayout>
    </LinearLayout>
</layout>
