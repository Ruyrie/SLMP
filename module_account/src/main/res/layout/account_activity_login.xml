<?xml version="1.0" encoding="utf-8"?>
<!-- A01 登录（UI 设计文档 A01）：无顶部栏，左右 24 dp；品牌区、标题、登录失效横幅、方式切换、手机号、密码 / 验证码、登录、手机号无法使用；底部注册入口 -->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

        <import type="com.zhimu.slmp.account.ui.login.LoginViewModel" />

        <variable
            name="vm"
            type="com.zhimu.slmp.account.ui.login.LoginViewModel" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/colorSurface"
        android:orientation="vertical">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/base_space_6"
                android:paddingEnd="@dimen/base_space_6"
                android:paddingBottom="@dimen/base_space_6">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="50dp"
                    android:text="@string/account_app_name"
                    android:textAppearance="@style/TextAppearance.Zmt.HeadlineMedium"
                    android:textColor="?attr/colorPrimary"
                    android:textStyle="bold" />

                <TextView
                    style="@style/account_style_desc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/base_space_1"
                    android:text="@string/account_app_slogan" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="40dp"
                    android:text="@string/account_login_title"
                    android:textAppearance="@style/TextAppearance.Zmt.HeadlineMedium"
                    android:textColor="?attr/colorOnSurface" />

                <TextView
                    style="@style/account_style_desc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/base_space_1"
                    android:text="@string/account_login_desc" />

                <com.zhimu.slmp.base.widget.NoticeView
                    android:id="@+id/account_login_banner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/base_space_6"
                    android:visibility="gone"
                    app:accountNotice="@{vm.banner}"
                    app:noticeLevel="normal" />

                <com.zhimu.slmp.base.widget.ConnectedButtonGroup
                    android:id="@+id/account_login_mode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/base_space_6"
                    app:checkedButton="@id/account_login_mode_password"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/account_login_mode_password"
                        style="@style/Widget.Zmt.Button.Connected"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/account_login_mode_password" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/account_login_mode_sms"
                        style="@style/Widget.Zmt.Button.Connected"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/account_login_mode_sms" />
                </com.zhimu.slmp.base.widget.ConnectedButtonGroup>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/account_login_phone"
                    style="@style/account_style_field"
                    android:hint="@string/account_field_phone"
                    app:prefixText="@string/account_phone_prefix">

                    <com.google.android.material.textfield.TextInputEditText
                        style="@style/account_style_edit"
                        android:autofillHints="phone"
                        android:imeOptions="actionNext"
                        android:inputType="phone"
                        android:text="@={vm.phone}" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/account_login_password"
                    style="@style/account_style_field"
                    android:hint="@string/account_field_password"
                    app:endIconMode="password_toggle"
                    app:visibleIf="@{!LoginViewModel.MODE_SMS.equals(vm.loginMode)}">

                    <com.google.android.material.textfield.TextInputEditText
                        style="@style/account_style_edit"
                        android:autofillHints="password"
                        android:imeOptions="actionDone"
                        android:inputType="textPassword"
                        android:text="@={vm.password}" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/account_login_sms"
                    style="@style/account_style_field"
                    android:hint="@string/account_field_sms_code"
                    android:visibility="gone"
                    app:visibleIf="@{LoginViewModel.MODE_SMS.equals(vm.loginMode)}">

                    <com.google.android.material.textfield.TextInputEditText
                        style="@style/account_style_edit"
                        android:autofillHints="smsOTPCode"
                        android:imeOptions="actionDone"
                        android:inputType="number"
                        android:text="@={vm.smsCode}" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/account_login_forgot"
                    style="@style/Widget.Zmt.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginEnd="-12dp"
                    android:text="@string/account_login_forgot"
                    app:visibleIf="@{!LoginViewModel.MODE_SMS.equals(vm.loginMode)}" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/account_login_submit"
                    style="@style/Widget.Zmt.Button.Large"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/base_space_4"
                    android:enabled="@{vm.canSubmit}"
                    android:text="@string/account_login_submit"
                    app:loading="@{vm.submitting}" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/account_login_unusable"
                    style="@style/Widget.Zmt.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="18dp"
                    android:text="@string/account_login_phone_unusable"
                    app:icon="@drawable/account_ic_phonelink_erase"
                    app:iconSize="20dp" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="@dimen/base_space_2"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/account_style_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/account_login_no_account" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/account_login_register"
                style="@style/Widget.Zmt.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/account_login_register" />
        </LinearLayout>
    </LinearLayout>
</layout>
