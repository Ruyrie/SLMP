# 复制为 .env.local（不进 git）后填写。KEY=VALUE 形式，应用启动时自动读取；生产环境改用真实环境变量。
SPRING_PROFILES_ACTIVE=dev

# 保留样例和用户记录的真实历史日期，不在启动时平移日期。
ZMT_DEMO_SHIFT=false
# 业务日期使用真实北京时间，留空即可。
ZMT_FIXED_DATE=

# 数据库（本机 MySQL）
DB_URL=jdbc:mysql://127.0.0.1:3306/zhimu?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true&rewriteBatchedStatements=true
DB_USER=root
DB_PASSWORD=

# Redis / MinIO（server/tools/start-dev.ps1 启动的免安装版）
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
MINIO_ENDPOINT=http://127.0.0.1:9000
# 真机调试时改为电脑的局域网 IP，例如 http://192.168.1.10:9000
MINIO_PUBLIC_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
HLS_BASE_URL=http://127.0.0.1:9000/zmt-course/hls
# 批次二维码指向用户 Web。上云时设为 http://8.208.12.217（启用 HTTPS 后改为正式域名）。
USER_WEB_BASE_URL=http://127.0.0.1:5173

# 令牌签名密钥（至少 32 字节随机串）
JWT_USER_SECRET=
JWT_ADMIN_SECRET=

# AI：阿里云百炼（主）、DeepSeek（备用）
DASHSCOPE_API_KEY=
DEEPSEEK_API_KEY=

# 短信：mock 为不发送（验证码固定 123456），aliyun 为阿里云号码认证
SMS_MODE=mock
SMS_ACCESS_KEY=
SMS_SECRET=
SMS_SIGN_NAME=

# 极光推送（未配置 Master Secret 时只写日志）
JPUSH_APP_KEY=
JPUSH_MASTER_SECRET=

# 高德 Web 服务 Key（逆地理编码、行政区划）
AMAP_WEB_KEY=

# FFmpeg 与 IP 属地库（本机为 server/tools 下的绝对路径）
FFMPEG_PATH=
FFPROBE_PATH=
IP2REGION_DB=
