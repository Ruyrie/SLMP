<?xml version="1.0" encoding="utf-8"?>
<!-- StatCardView 内容：标签（可带 20 dp 图标）→ 大数字 + 单位 → 环比行；大型卡下方分隔线 + 三列分项。02 号 7.8 节 -->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:parentTag="com.google.android.material.card.MaterialCardView">

    <LinearLayout
        android:id="@+id/base_stat_root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="@dimen/base_space_4"
        android:paddingTop="@dimen/base_space_3"
        android:paddingEnd="@dimen/base_space_4"
        android:paddingBottom="@dimen/base_space_3">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/base_stat_icon"
                android:layout_width="@dimen/base_icon_size_small"
                android:layout_height="@dimen/base_icon_size_small"
                android:layout_marginEnd="@dimen/base_space_1"
                android:importantForAccessibility="no"
                android:visibility="gone" />

            <TextView
                android:id="@+id/base_stat_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:singleLine="true"
                android:textAppearance="@style/TextAppearance.Zmt.BodyMedium" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="true"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/base_stat_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:textAppearance="@style/TextAppearance.Zmt.HeadlineMedium.Number" />

            <TextView
                android:id="@+id/base_stat_unit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/base_space_1"
                android:singleLine="true"
                android:textAppearance="@style/TextAppearance.Zmt.BodyMedium" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/base_stat_trend"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <ImageView
                android:id="@+id/base_stat_trend_icon"
                android:layout_width="@dimen/base_icon_size_tag"
                android:layout_height="@dimen/base_icon_size_tag"
                android:layout_marginEnd="@dimen/base_space_1"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/base_stat_trend_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:singleLine="true"
                android:textAppearance="@style/TextAppearance.Zmt.BodySmall.Number" />
        </LinearLayout>

        <View
            android:id="@+id/base_stat_divider"
            android:layout_width="match_parent"
            android:layout_height="@dimen/base_stroke"
            android:layout_marginTop="@dimen/base_space_3"
            android:layout_marginBottom="@dimen/base_space_3"
            android:background="?attr/colorOutlineVariant"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/base_stat_sub_items"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone" />
    </LinearLayout>
</merge>
