<?xml version="1.0" encoding="utf-8"?>
<!-- NoticeView 内容：20 dp 图标（x 32）+ 正文（x 64，结论加粗）+ 可选文字按钮；正文下可选确认复选框。02 号 7.10 节 -->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:orientation="vertical"
    tools:parentTag="android.widget.LinearLayout">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/base_notice_icon"
            android:layout_width="@dimen/base_icon_size_small"
            android:layout_height="@dimen/base_icon_size_small"
            android:layout_marginEnd="@dimen/base_space_3"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/base_notice_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textAppearance="@style/TextAppearance.Zmt.BodyMedium" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/base_notice_action"
            style="@style/Widget.Zmt.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="@dimen/base_space_2"
            android:layout_marginTop="-14dp"
            android:layout_marginEnd="-12dp"
            android:layout_marginBottom="-14dp"
            android:visibility="gone" />
    </LinearLayout>

    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/base_notice_check"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="17dp"
        android:layout_marginBottom="-8dp"
        android:visibility="gone" />
</merge>
