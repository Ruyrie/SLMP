<?xml version="1.0" encoding="utf-8"?>
<!-- 带说明的对话框输入区（02 号 7.11 节）：只放一个输入框（宽 264 dp），辅助文字“必填”，右下角字数 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/base_dialog_padding"
    android:paddingTop="@dimen/base_space_4"
    android:paddingEnd="@dimen/base_dialog_padding">

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/base_reason_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:counterEnabled="true">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/base_reason_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top|start"
            android:imeOptions="actionDone|flagNoExtractUi"
            android:inputType="textMultiLine"
            android:maxLines="5" />
    </com.google.android.material.textfield.TextInputLayout>
</FrameLayout>
