<?xml version="1.0" encoding="utf-8"?>
<!-- 详情页骨架屏：摘要大卡片（标题条 + 三列键值）+ 分组列表 4 项。02 号 7.19 节 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:importantForAccessibility="noHideDescendants"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/base_page_margin"
        android:paddingTop="@dimen/base_space_3"
        android:paddingEnd="@dimen/base_page_margin">

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Zmt.Card.Summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.zhimu.slmp.base.widget.SkeletonView
                    android:layout_width="200dp"
                    android:layout_height="24dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/base_space_4"
                    android:orientation="horizontal">

                    <com.zhimu.slmp.base.widget.SkeletonView
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_marginEnd="@dimen/base_space_4"
                        android:layout_weight="1" />

                    <com.zhimu.slmp.base.widget.SkeletonView
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_marginEnd="@dimen/base_space_4"
                        android:layout_weight="1" />

                    <com.zhimu.slmp.base.widget.SkeletonView
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.zhimu.slmp.base.widget.SkeletonView
            android:layout_width="96dp"
            android:layout_height="16dp"
            android:layout_marginTop="@dimen/base_space_6"
            android:layout_marginBottom="@dimen/base_space_3" />

        <com.zhimu.slmp.base.widget.GroupedListLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Zmt.Card.ListItem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/base_list_item_two_line_min_height"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/base_space_4"
                    android:paddingEnd="@dimen/base_space_4">

                    <com.zhimu.slmp.base.widget.SkeletonView
                        android:layout_width="@dimen/base_list_leading_size"
                        android:layout_height="@dimen/base_list_leading_size"
                        android:layout_marginEnd="@dimen/base_space_4"
                        app:skeletonCornerRadius="@dimen/base_radius_md" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <com.zhimu.slmp.base.widget.SkeletonView
                            android:layout_width="180dp"
                            android:layout_height="20dp" />

                        <com.zhimu.slmp.base.widget.SkeletonView
                            android:layout_width="120dp"
                            android:layout_height="16dp"
                            android:layout_marginTop="@dimen/base_space_2" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Zmt.Card.ListItem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/base_list_item_two_line_min_height"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/base_space_4"
                    android:paddingEnd="@dimen/base_space_4">

                    <com.zhimu.slmp.base.widget.SkeletonView
                        android:layout_width="@dimen/base_list_leading_size"
                        android:layout_height="@dimen/base_list_leading_size"
                        android:layout_marginEnd="@dimen/base_space_4"
                        app:skeletonCornerRadius="@dimen/base_radius_md" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <com.zhimu.slmp.base.widget.SkeletonView
                            android:layout_width="150dp"
                            android:layout_height="20dp" />

                        <com.zhimu.slmp.base.widget.SkeletonView
                            android:layout_width="200dp"
                            android:layout_height="16dp"
                            android:layout_marginTop="@dimen/base_space_2" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Zmt.Card.ListItem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/base_list_item_two_line_min_height"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/base_space_4"
                    android:paddingEnd="@dimen/base_space_4">

                    <com.zhimu.slmp.base.widget.SkeletonView
                        android:layout_width="@dimen/base_list_leading_size"
                        android:layout_height="@dimen/base_list_leading_size"
                        android:layout_marginEnd="@dimen/base_space_4"
                        app:skeletonCornerRadius="@dimen/base_radius_md" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <com.zhimu.slmp.base.widget.SkeletonView
                            android:layout_width="200dp"
                            android:layout_height="20dp" />

                        <com.zhimu.slmp.base.widget.SkeletonView
                            android:layout_width="140dp"
                            android:layout_height="16dp"
                            android:layout_marginTop="@dimen/base_space_2" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Zmt.Card.ListItem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/base_list_item_two_line_min_height"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/base_space_4"
                    android:paddingEnd="@dimen/base_space_4">

                    <com.zhimu.slmp.base.widget.SkeletonView
                        android:layout_width="@dimen/base_list_leading_size"
                        android:layout_height="@dimen/base_list_leading_size"
                        android:layout_marginEnd="@dimen/base_space_4"
                        app:skeletonCornerRadius="@dimen/base_radius_md" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <com.zhimu.slmp.base.widget.SkeletonView
                            android:layout_width="160dp"
                            android:layout_height="20dp" />

                        <com.zhimu.slmp.base.widget.SkeletonView
                            android:layout_width="180dp"
                            android:layout_height="16dp"
                            android:layout_marginTop="@dimen/base_space_2" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </com.zhimu.slmp.base.widget.GroupedListLayout>
    </LinearLayout>
</ScrollView>
