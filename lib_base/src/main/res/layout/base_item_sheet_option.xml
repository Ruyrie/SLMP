<?xml version="1.0" encoding="utf-8"?>
<!-- 选择面板选项行（02 号 7.12 节）：行高 64 dp，单选按钮 20 dp（x 24），文字从 x 60 起，右侧语义标签距右缘 24 dp -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="@dimen/base_sheet_option_height"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingTop="@dimen/base_space_2"
    android:paddingEnd="@dimen/base_sheet_padding_horizontal"
    android:paddingBottom="@dimen/base_space_2">

    <com.google.android.material.radiobutton.MaterialRadioButton
        android:id="@+id/base_option_radio"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="2dp"
        android:clickable="false"
        android:focusable="false"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/base_option_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Zmt.BodyLarge"
            android:textColor="@color/base_color_text_on_surface" />

        <TextView
            android:id="@+id/base_option_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Zmt.BodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:visibility="gone" />
    </LinearLayout>

    <com.zhimu.slmp.base.widget.StatusTagView
        android:id="@+id/base_option_tag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/base_space_3"
        android:visibility="gone" />
</LinearLayout>
