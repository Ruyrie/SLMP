<?xml version="1.0" encoding="utf-8"?>
<!-- 富提示气泡：标题 title-s + 说明 body-m + 最多一个文字按钮；最宽 312 dp（02 号 7.11 节；底色由 TipPopup 设置） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/base_space_4"
    android:paddingTop="@dimen/base_space_3"
    android:paddingEnd="@dimen/base_space_4"
    android:paddingBottom="@dimen/base_space_3">

    <TextView
        android:id="@+id/base_tip_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.Zmt.TitleSmall"
        android:textColor="?attr/colorOnSurface" />

    <TextView
        android:id="@+id/base_tip_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/base_space_1"
        android:textAppearance="@style/TextAppearance.Zmt.BodyMedium"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/base_tip_action"
        style="@style/Widget.Zmt.Button.Text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="-12dp"
        android:layout_marginTop="@dimen/base_space_1"
        android:layout_marginBottom="-8dp"
        android:visibility="gone" />
</LinearLayout>
