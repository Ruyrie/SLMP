<?xml version="1.0" encoding="utf-8"?>
<!-- “更多”菜单项：前置图标 24 dp（间距 12 dp）+ 文字 body-m（可带一行说明）+ 右侧附注 body-s（如“需审核”）；
     每项高 48 dp，左右内边距 12 dp；危险项前有 1 dp outline-variant 分隔线（02 号 7.11 节） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <View
        android:id="@+id/base_menu_divider"
        android:layout_width="match_parent"
        android:layout_height="@dimen/base_stroke"
        android:layout_marginTop="@dimen/base_space_2"
        android:layout_marginBottom="@dimen/base_space_2"
        android:background="?attr/colorOutlineVariant"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/base_menu_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="@dimen/base_menu_item_height"
        android:orientation="horizontal"
        android:paddingStart="@dimen/base_space_3"
        android:paddingTop="@dimen/base_space_2"
        android:paddingEnd="@dimen/base_space_3"
        android:paddingBottom="@dimen/base_space_2">

        <ImageView
            android:id="@+id/base_menu_icon"
            android:layout_width="@dimen/base_icon_size"
            android:layout_height="@dimen/base_icon_size"
            android:layout_marginEnd="@dimen/base_space_3"
            android:importantForAccessibility="no"
            app:tint="?attr/colorOnSurfaceVariant" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/base_menu_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Zmt.BodyMedium"
                android:textColor="?attr/colorOnSurface" />

            <TextView
                android:id="@+id/base_menu_description"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Zmt.BodySmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/base_menu_note"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/base_space_3"
            android:textAppearance="@style/TextAppearance.Zmt.BodySmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
