<?xml version="1.0" encoding="utf-8"?>
<!-- D07 新建消毒计划（图 8-11）：栏舍（可多选 Chip）与选择说明、周期天数、开始 / 结束日期、消毒剂（库存提醒）+ 浓度、
     消毒方式、任务汇总卡；底部“保存并启用”（修改状态“保存修改”） -->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

        <variable
            name="vm"
            type="com.zhimu.slmp.health.ui.disinfectplanedit.DisinfectPlanEditViewModel" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/colorSurface"
        android:orientation="vertical">

        <include
            android:id="@+id/health_top_bar"
            layout="@layout/base_include_top_app_bar"
            app:title="@{vm.editMode ? @string/health_d07_title_edit : @string/health_d07_title}" />

        <com.zhimu.slmp.base.widget.StateLayout
            android:id="@+id/health_state"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            app:stateErrorTitle="@string/health_d07_error"
            app:stateNoPermissionTitle="@string/health_d06_no_permission"
            app:stateSkeletonLayout="@layout/base_skeleton_detail">

            <androidx.core.widget.NestedScrollView
                android:id="@+id/health_scroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/base_page_margin"
                    android:paddingTop="@dimen/base_space_4"
                    android:paddingEnd="@dimen/base_page_margin"
                    android:paddingBottom="@dimen/base_space_6">

                    <TextView
                        android:id="@+id/health_pen_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/health_pens_multi"
                        android:textAppearance="@style/TextAppearance.Zmt.BodyMedium"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/health_pen_chips"
                        style="@style/Widget.Zmt.ChipGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/base_space_2"
                        app:chipSpacingVertical="@dimen/base_space_2" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/base_space_4"
                        android:text="@{vm.fieldErrors[`pen_ids`]}"
                        android:textAppearance="@style/TextAppearance.Zmt.BodySmall"
                        android:textColor="?attr/colorError"
                        app:goneIfNull="@{vm.fieldErrors[`pen_ids`]}" />

                    <TextView
                        android:id="@+id/health_pen_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/base_space_2"
                        android:textAppearance="@style/TextAppearance.Zmt.BodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <com.zhimu.slmp.base.widget.ZmtTextInputLayout
                        android:id="@+id/health_cycle_layout"
                        style="@style/Widget.Zmt.TextInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/base_space_4"
                        android:hint="@string/health_cycle_days"
                        app:healthError="@{vm.fieldErrors[`cycle_days`]}"
                        app:healthHelper="@{vm.cycleHelper}"
                        app:suffixText="@string/health_unit_day">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/health_cycle_input"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:maxLength="3"
                            android:text="@={vm.cycleDays}"
                            android:textAppearance="@style/TextAppearance.Zmt.BodyLarge.Number" />
                    </com.zhimu.slmp.base.widget.ZmtTextInputLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/base_space_3"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <com.zhimu.slmp.base.widget.ZmtTextInputLayout
                            android:id="@+id/health_start_layout"
                            style="@style/Widget.Zmt.TextInputLayout.Picker"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="@string/health_start_date"
                            app:healthError="@{vm.fieldErrors[`start_date`]}">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/health_start_input"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                app:dateText="@{vm.startDate}"
                                app:dateWithWeek="@{true}" />
                        </com.zhimu.slmp.base.widget.ZmtTextInputLayout>

                        <com.zhimu.slmp.base.widget.ZmtTextInputLayout
                            android:id="@+id/health_end_layout"
                            style="@style/Widget.Zmt.TextInputLayout.Picker"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/base_space_3"
                            android:layout_weight="1"
                            android:hint="@string/health_end_date"
                            app:healthError="@{vm.fieldErrors[`end_date`]}">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/health_end_input"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                app:dateText="@{vm.endDate}"
                                app:dateWithWeek="@{true}" />
                        </com.zhimu.slmp.base.widget.ZmtTextInputLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/base_space_3"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <com.zhimu.slmp.base.widget.ZmtTextInputLayout
                            android:id="@+id/health_disinfectant_layout"
                            style="@style/Widget.Zmt.TextInputLayout.Dropdown"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="3"
                            android:hint="@string/health_disinfectant_dict"
                            app:helperTextEnabled="true">

                            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                                android:id="@+id/health_disinfectant_input"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="none" />
                        </com.zhimu.slmp.base.widget.ZmtTextInputLayout>

                        <com.zhimu.slmp.base.widget.ZmtTextInputLayout
                            android:id="@+id/health_concentration_layout"
                            style="@style/Widget.Zmt.TextInputLayout"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/base_space_3"
                            android:layout_weight="2"
                            android:hint="@string/health_concentration"
                            app:healthError="@{vm.fieldErrors[`concentration`]}">

                            <com.google.android.material.textfield.TextInputEditText
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:digits="0123456789:："
                                android:inputType="text"
                                android:maxLength="20"
                                android:text="@={vm.concentration}"
                                android:textAppearance="@style/TextAppearance.Zmt.BodyLarge.Number" />
                        </com.zhimu.slmp.base.widget.ZmtTextInputLayout>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/health_method_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/base_space_4"
                        android:text="@string/health_disinfect_method_dict"
                        android:textAppearance="@style/TextAppearance.Zmt.BodyMedium"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/health_method_chips"
                        style="@style/Widget.Zmt.ChipGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/base_space_1"
                        app:chipSpacingVertical="@dimen/base_space_2"
                        app:singleSelection="true" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/base_space_4"
                        android:text="@{vm.fieldErrors[`method_code`]}"
                        android:textAppearance="@style/TextAppearance.Zmt.BodySmall"
                        android:textColor="?attr/colorError"
                        app:goneIfNull="@{vm.fieldErrors[`method_code`]}" />

                    <com.google.android.material.card.MaterialCardView
                        style="@style/Widget.Zmt.Card.Summary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/base_space_4"
                        app:cardBackgroundColor="?attr/colorSurfaceContainerHighest">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:importantForAccessibility="no"
                                android:src="@drawable/health_ic_event_repeat"
                                app:tint="?attr/colorOnSurfaceVariant" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/base_space_3"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/health_summary_title"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:textAppearance="@style/TextAppearance.Zmt.TitleSmall"
                                    android:textColor="?attr/colorOnSurface" />

                                <TextView
                                    android:id="@+id/health_summary_text"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:textAppearance="@style/TextAppearance.Zmt.BodyMedium"
                                    android:textColor="?attr/colorOnSurfaceVariant" />
                            </LinearLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>
        </com.zhimu.slmp.base.widget.StateLayout>

        <com.zhimu.slmp.base.widget.BottomActionBar
            android:id="@+id/health_action_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>
</layout>
