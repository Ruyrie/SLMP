<?xml version="1.0" encoding="utf-8"?>
<!-- D09 任务卡：sanitizer 图标底（已逾期 error / 待执行 secondary / 已执行中性）+ 栏舍、副文字、执行人行；右上状态标签与“补录” -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/base_page_margin"
    android:paddingEnd="@dimen/base_page_margin">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/health_card"
        style="@style/Widget.Zmt.Card.ListItem"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="@dimen/base_list_item_two_line_min_height"
            android:orientation="horizontal"
            android:paddingStart="@dimen/base_space_4"
            android:paddingTop="@dimen/base_space_3"
            android:paddingEnd="@dimen/base_space_4"
            android:paddingBottom="@dimen/base_space_3">

            <ImageView
                android:id="@+id/health_icon"
                android:layout_width="@dimen/base_list_leading_size"
                android:layout_height="@dimen/base_list_leading_size"
                android:importantForAccessibility="no"
                android:scaleType="center"
                android:src="@drawable/ic_sanitizer" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/base_space_4"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/health_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:textAppearance="@style/TextAppearance.Zmt.TitleMedium"
                    android:textColor="?attr/colorOnSurface" />

                <TextView
                    android:id="@+id/health_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textAppearance="@style/TextAppearance.Zmt.BodyMedium"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <TextView
                    android:id="@+id/health_extra"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textAppearance="@style/TextAppearance.Zmt.BodyMedium"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/base_space_3"
                android:gravity="end"
                android:orientation="vertical">

                <com.zhimu.slmp.base.widget.StatusTagView
                    android:id="@+id/health_tag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/health_backfill"
                    style="@style/Widget.Zmt.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="48dp"
                    android:text="@string/health_backfill"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>
