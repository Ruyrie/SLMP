<?xml version="1.0" encoding="utf-8"?>
<!-- 暂停计划底部面板内容：暂停原因（选填，最多 30 字）+ 说明 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/base_sheet_padding_horizontal"
    android:paddingTop="@dimen/base_space_2"
    android:paddingEnd="@dimen/base_sheet_padding_horizontal"
    android:paddingBottom="@dimen/base_space_2">

    <com.zhimu.slmp.base.widget.ZmtTextInputLayout
        style="@style/Widget.Zmt.TextInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/health_pause_reason"
        app:counterEnabled="true"
        app:counterMaxLength="30"
        app:helperText="@string/health_pause_reason_helper"
        app:helperTextEnabled="true">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/health_pause_reason"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:maxLength="30"
            android:maxLines="1" />
    </com.zhimu.slmp.base.widget.ZmtTextInputLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/base_space_3"
        android:text="@string/health_pause_note"
        android:textAppearance="@style/TextAppearance.Zmt.BodySmall"
        android:textColor="?attr/colorOnSurfaceVariant" />
</LinearLayout>
