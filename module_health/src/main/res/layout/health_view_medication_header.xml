<?xml version="1.0" encoding="utf-8"?>
<!-- D05 列表头：批次概况行、休药状态卡（休药中 warning / 已到期 success / 无记录中性）、按药品计算、计算说明、用药记录分组标题与空状态 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/base_page_margin"
    android:paddingTop="@dimen/base_space_1"
    android:paddingEnd="@dimen/base_page_margin"
    android:paddingBottom="@dimen/base_space_2">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/health_batch_no"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Zmt.TitleMedium.Number"
            android:textColor="?attr/colorOnSurface" />

        <TextView
            android:id="@+id/health_batch_summary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/base_space_2"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:textAppearance="@style/TextAppearance.Zmt.BodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant" />
    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/health_withdrawal_card"
        style="@style/Widget.Zmt.Card.Summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/base_space_3">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/health_withdrawal_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:drawablePadding="@dimen/base_space_2"
                android:gravity="center_vertical"
                android:textAppearance="@style/TextAppearance.Zmt.TitleSmall" />

            <TextView
                android:id="@+id/health_release_date"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/base_space_1"
                android:textAppearance="@style/TextAppearance.Zmt.HeadlineSmall" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/health_progress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/base_space_3"
                android:max="100"
                app:trackCornerRadius="2dp"
                app:trackThickness="4dp" />

            <LinearLayout
                android:id="@+id/health_progress_labels"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/base_space_1"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/health_last_med"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textAppearance="@style/TextAppearance.Zmt.BodySmall" />

                <TextView
                    android:id="@+id/health_withdrawal_days"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Zmt.BodySmall" />
            </LinearLayout>

            <TextView
                android:id="@+id/health_withdrawal_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/base_space_2"
                android:textAppearance="@style/TextAppearance.Zmt.BodySmall" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:id="@+id/health_drug_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/base_space_5"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.zhimu.slmp.base.widget.SectionHeaderView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:sectionTitle="@string/health_by_drug" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/health_take_latest"
                android:textAppearance="@style/TextAppearance.Zmt.BodySmall"
                android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/health_drug_rows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/base_space_2"
            android:orientation="vertical" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/base_space_3"
            android:text="@string/health_release_rule"
            android:textAppearance="@style/TextAppearance.Zmt.BodySmall"
            android:textColor="?attr/colorOnSurfaceVariant" />
    </LinearLayout>

    <com.zhimu.slmp.base.widget.SectionHeaderView
        android:id="@+id/health_record_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/base_space_5" />

    <TextView
        android:id="@+id/health_record_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="@dimen/base_space_6"
        android:paddingBottom="@dimen/base_space_6"
        android:text="@string/health_record_empty"
        android:textAppearance="@style/TextAppearance.Zmt.BodyMedium"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:visibility="gone" />
</LinearLayout>
