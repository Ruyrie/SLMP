<?xml version="1.0" encoding="utf-8"?>
<!-- D01 列表头：批次概况行、状态筛选 Chip（横向滚动）、批次结束横幅、入栏前项目卡、“免疫计划 · 5 项”与空状态 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="@dimen/base_space_1"
    android:paddingBottom="@dimen/base_space_2">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/base_page_margin"
        android:paddingEnd="@dimen/base_page_margin">

        <TextView
            android:id="@+id/health_batch_no"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Zmt.TitleMedium.Number"
            android:textColor="?attr/colorOnSurface" />

        <TextView
            android:id="@+id/health_batch_summary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/base_space_2"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:textAppearance="@style/TextAppearance.Zmt.BodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant" />
    </LinearLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/base_space_3"
        android:clipToPadding="false"
        android:paddingStart="@dimen/base_page_margin"
        android:paddingEnd="@dimen/base_page_margin"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/health_filter_chips"
            style="@style/Widget.Zmt.ChipGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:selectionRequired="true"
            app:singleLine="true"
            app:singleSelection="true" />
    </HorizontalScrollView>

    <com.zhimu.slmp.base.widget.NoticeView
        android:id="@+id/health_ended_notice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/base_page_margin"
        android:layout_marginTop="@dimen/base_space_3"
        android:layout_marginEnd="@dimen/base_page_margin"
        android:visibility="gone"
        app:noticeText="@string/health_batch_ended" />

    <LinearLayout
        android:id="@+id/health_pre_entry_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/base_space_4"
        android:orientation="vertical"
        android:paddingStart="@dimen/base_page_margin"
        android:paddingEnd="@dimen/base_page_margin"
        android:visibility="gone">

        <com.zhimu.slmp.base.widget.SectionHeaderView
            android:id="@+id/health_pre_entry_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Zmt.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/base_space_2"
            app:cardCornerRadius="@dimen/base_radius_lg_plus"
            app:strokeColor="?attr/colorOutlineVariant"
            app:strokeWidth="@dimen/base_stroke">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/base_space_4"
                android:paddingTop="@dimen/base_space_3"
                android:paddingEnd="@dimen/base_space_4"
                android:paddingBottom="@dimen/base_space_1">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingBottom="@dimen/base_space_3"
                    android:text="@string/health_pre_entry_hint"
                    android:textAppearance="@style/TextAppearance.Zmt.BodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <LinearLayout
                    android:id="@+id/health_pre_entry_rows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <com.zhimu.slmp.base.widget.SectionHeaderView
        android:id="@+id/health_plan_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/base_page_margin"
        android:layout_marginTop="@dimen/base_space_5"
        android:layout_marginEnd="@dimen/base_page_margin" />

    <LinearLayout
        android:id="@+id/health_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="@dimen/base_page_margin"
        android:paddingTop="@dimen/base_space_8"
        android:paddingEnd="@dimen/base_page_margin"
        android:visibility="gone">

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_vaccines"
            app:tint="?attr/colorOnSurfaceVariant" />

        <TextView
            android:id="@+id/health_empty_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/base_space_3"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.Zmt.BodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/health_empty_action"
            style="@style/Widget.Zmt.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/base_space_4"
            android:text="@string/health_add_item"
            android:visibility="gone"
            app:icon="@drawable/ic_add" />
    </LinearLayout>
</LinearLayout>
