<?xml version="1.0" encoding="utf-8"?>
<!-- 列表下方说明与空状态（D06、D09）：空状态（图标 + 文案 + 文字按钮）、页面说明 12 sp -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/base_page_margin"
    android:paddingEnd="@dimen/base_page_margin">

    <LinearLayout
        android:id="@+id/health_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="@dimen/base_space_8"
        android:visibility="gone">

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_sanitizer"
            app:tint="?attr/colorOnSurfaceVariant" />

        <TextView
            android:id="@+id/health_empty_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/base_space_3"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.Zmt.BodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/health_empty_action"
            style="@style/Widget.Zmt.Button.Tonal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/base_space_4"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/health_note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/base_space_3"
        android:textAppearance="@style/TextAppearance.Zmt.BodySmall"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:visibility="gone" />
</LinearLayout>
