<?xml version="1.0" encoding="utf-8"?>
<!-- 分页底部：加载中 24dp 圆形进度；失败“加载失败”+ 重试 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="56dp">

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/ai_footer_progress"
        style="@style/Widget.Zmt.CircularProgressIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:indeterminate="true"
        app:indicatorSize="24dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/ai_footer_retry"
        style="@style/Widget.Zmt.Button.Text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="@string/ai_link_reload"
        android:visibility="gone" />
</FrameLayout>
