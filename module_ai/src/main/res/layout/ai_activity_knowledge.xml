<?xml version="1.0" encoding="utf-8"?>
<!-- K03 知识原文：顶部栏（share）；条目标题 24sp、分类标签 + “平台知识库 · 版本 3 · 10月12日更新”；回答后已更新 Notice；
     内嵌教学视频（16:9、圆角 16dp，封面 + 播放按钮 + 时长徽标，原位播放）与说明；正文段落（被引用段落为引用块）；相关条目 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:orientation="vertical">

    <include
        android:id="@+id/ai_knowledge_top_bar"
        layout="@layout/base_include_top_app_bar" />

    <com.zhimu.slmp.base.widget.StateLayout
        android:id="@+id/ai_knowledge_state"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:stateEmptyIcon="@drawable/ic_menu_book"
        app:stateEmptyTitle="@string/ai_knowledge_offline"
        app:stateErrorTitle="@string/ai_knowledge_error_title"
        app:stateSkeletonLayout="@layout/base_skeleton_detail">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/ai_knowledge_scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/base_page_margin"
                android:paddingTop="8dp"
                android:paddingEnd="@dimen/base_page_margin"
                android:paddingBottom="24dp">

                <TextView
                    android:id="@+id/ai_knowledge_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="2"
                    android:textAppearance="@style/TextAppearance.Zmt.HeadlineSmall"
                    android:textColor="?attr/colorOnSurface" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.zhimu.slmp.base.widget.StatusTagView
                        android:id="@+id/ai_knowledge_category"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:tagType="neutral" />

                    <TextView
                        android:id="@+id/ai_knowledge_meta"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:textAppearance="@style/TextAppearance.Zmt.BodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant" />
                </LinearLayout>

                <com.zhimu.slmp.base.widget.NoticeView
                    android:id="@+id/ai_knowledge_notice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/ai_knowledge_video_block"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <FrameLayout
                        android:id="@+id/ai_knowledge_video"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:background="@color/zm_media_backdrop">

                        <androidx.media3.ui.PlayerView
                            android:id="@+id/ai_knowledge_player"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:visibility="gone"
                            app:resize_mode="fit"
                            app:shutter_background_color="@color/zm_media_backdrop"
                            app:surface_type="texture_view"
                            app:use_controller="false" />

                        <include
                            android:id="@+id/ai_knowledge_controls"
                            layout="@layout/ai_view_player_controls"
                            android:visibility="gone" />

                        <FrameLayout
                            android:id="@+id/ai_knowledge_cover_block"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <ImageView
                                android:id="@+id/ai_knowledge_cover"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:importantForAccessibility="no"
                                android:scaleType="centerCrop" />

                            <ImageButton
                                android:id="@+id/ai_knowledge_play"
                                android:layout_width="56dp"
                                android:layout_height="56dp"
                                android:layout_gravity="center"
                                android:background="@drawable/ai_bg_round_scrim"
                                android:contentDescription="@string/ai_course_play"
                                android:padding="12dp"
                                android:scaleType="fitCenter"
                                android:src="@drawable/ic_play_arrow_filled"
                                app:tint="@color/zm_on_media" />

                            <TextView
                                android:id="@+id/ai_knowledge_duration"
                                android:layout_width="wrap_content"
                                android:layout_height="20dp"
                                android:layout_gravity="bottom|end"
                                android:layout_margin="8dp"
                                android:background="@drawable/ai_bg_badge"
                                android:drawablePadding="4dp"
                                android:fontFeatureSettings="tnum"
                                android:gravity="center_vertical"
                                android:paddingStart="6dp"
                                android:paddingEnd="8dp"
                                android:textAppearance="@style/TextAppearance.Zmt.LabelSmall"
                                android:textColor="@color/zm_on_media"
                                app:drawableStartCompat="@drawable/ic_smart_display"
                                app:drawableTint="@color/zm_on_media" />
                        </FrameLayout>
                    </FrameLayout>

                    <TextView
                        android:id="@+id/ai_knowledge_video_caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textAppearance="@style/TextAppearance.Zmt.BodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/ai_knowledge_blocks"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:nestedScrollingEnabled="false" />

                <TextView
                    android:id="@+id/ai_knowledge_related_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="16dp"
                    android:paddingBottom="8dp"
                    android:text="@string/ai_knowledge_related"
                    android:textAppearance="@style/TextAppearance.Zmt.TitleSmall"
                    android:textColor="?attr/colorPrimary"
                    android:visibility="gone" />

                <com.zhimu.slmp.base.widget.GroupedListLayout
                    android:id="@+id/ai_knowledge_related"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </com.zhimu.slmp.base.widget.StateLayout>
</LinearLayout>
