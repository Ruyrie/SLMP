<?xml version="1.0" encoding="utf-8"?>
<!-- 视频控制层（K05 竖屏、K06 横屏、K03 内嵌共用）：32% 遮罩；顶部返回 / 标题（横屏）/ 画中画 / 更多；左侧锁屏（横屏）；
     中部 replay_10 · 播放暂停 64dp · forward_10（±10 秒提示）；缓冲转圈；底部时间、进度条（已播放 / 已缓冲 / 未缓冲）、
     全屏；横屏底部行（暂停、下一节、时间、倍速 / 清晰度 / 选集胶囊、退出全屏）；中央提示（失败、断网、仅 Wi-Fi、结束遮罩）；右侧 200dp 面板 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ai_ctrl_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:id="@+id/ai_ctrl_layer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/ai_bg_scrim_32">

        <LinearLayout
            android:id="@+id/ai_ctrl_top"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_gravity="top"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <ImageButton
                android:id="@+id/ai_ctrl_back"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/ai_back"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/zm_on_media" />

            <TextView
                android:id="@+id/ai_ctrl_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.Zmt.TitleMedium"
                android:textColor="@color/zm_on_media" />

            <ImageButton
                android:id="@+id/ai_ctrl_pip"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/ai_play_pip"
                android:src="@drawable/ic_picture_in_picture_alt"
                app:tint="@color/zm_on_media" />

            <ImageButton
                android:id="@+id/ai_ctrl_more"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/ai_play_more"
                android:src="@drawable/ic_more_vert"
                app:tint="@color/zm_on_media" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/ai_ctrl_lock"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="24dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/ai_play_lock"
            android:src="@drawable/ic_lock_open"
            android:visibility="gone"
            app:tint="@color/zm_on_media" />

        <LinearLayout
            android:id="@+id/ai_ctrl_center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="64dp"
                android:layout_height="64dp">

                <ImageButton
                    android:id="@+id/ai_ctrl_rewind"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/ai_play_rewind"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_replay_10"
                    app:tint="@color/zm_on_media" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp">

                <ImageButton
                    android:id="@+id/ai_ctrl_play"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@drawable/ai_bg_round_scrim"
                    android:contentDescription="@string/ai_play_play_pause"
                    android:padding="12dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_pause_filled"
                    app:tint="@color/zm_on_media" />

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/ai_ctrl_buffering"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:indeterminate="true"
                    android:visibility="gone"
                    app:indicatorColor="@color/zm_on_media"
                    app:indicatorSize="48dp"
                    app:trackThickness="3dp" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="64dp"
                android:layout_height="64dp">

                <ImageButton
                    android:id="@+id/ai_ctrl_forward"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/ai_play_forward"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_forward_10"
                    app:tint="@color/zm_on_media" />
            </FrameLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/ai_ctrl_seek_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="-56dp"
            android:textAppearance="@style/TextAppearance.Zmt.BodySmall"
            android:textColor="@color/zm_on_media"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/ai_ctrl_bottom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="4dp">

            <LinearLayout
                android:id="@+id/ai_ctrl_portrait_row"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/ai_ctrl_time"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFeatureSettings="tnum"
                    android:textAppearance="@style/TextAppearance.Zmt.BodySmall"
                    android:textColor="@color/zm_on_media" />

                <ImageButton
                    android:id="@+id/ai_ctrl_fullscreen"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/ai_play_fullscreen"
                    android:src="@drawable/ic_fullscreen"
                    app:tint="@color/zm_on_media" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/ai_ctrl_seek"
                android:layout_width="match_parent"
                android:layout_height="20dp"
                android:maxHeight="4dp"
                android:minHeight="4dp"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:progressDrawable="@drawable/ai_seek_progress"
                android:splitTrack="false"
                android:thumb="@drawable/ai_seek_thumb"
                android:thumbOffset="0dp" />

            <LinearLayout
                android:id="@+id/ai_ctrl_land_row"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <ImageButton
                    android:id="@+id/ai_ctrl_play_small"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/ai_play_play_pause"
                    android:src="@drawable/ic_pause"
                    app:tint="@color/zm_on_media" />

                <ImageButton
                    android:id="@+id/ai_ctrl_next"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/ai_play_next"
                    android:src="@drawable/ai_ic_skip_next"
                    app:tint="@color/zm_on_media" />

                <TextView
                    android:id="@+id/ai_ctrl_time_land"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:fontFeatureSettings="tnum"
                    android:textAppearance="@style/TextAppearance.Zmt.BodySmall"
                    android:textColor="@color/zm_on_media" />

                <TextView
                    android:id="@+id/ai_ctrl_speed_pill"
                    style="@style/ai_MediaPill"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:minWidth="48dp" />

                <TextView
                    android:id="@+id/ai_ctrl_quality_pill"
                    style="@style/ai_MediaPill"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:layout_marginStart="4dp"
                    android:minWidth="52dp" />

                <TextView
                    android:id="@+id/ai_ctrl_episodes_pill"
                    style="@style/ai_MediaPill"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:layout_marginStart="4dp"
                    android:minWidth="48dp"
                    android:text="@string/ai_play_episodes" />

                <ImageButton
                    android:id="@+id/ai_ctrl_exit_fullscreen"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/ai_play_exit_fullscreen"
                    android:src="@drawable/ai_ic_fullscreen_exit"
                    app:tint="@color/zm_on_media" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- 中央提示：播放失败 / 断网 / 仅 Wi-Fi 拦截 / 播放结束 / 已下架（不随控制层隐藏） -->
    <LinearLayout
        android:id="@+id/ai_ctrl_message"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/ai_bg_scrim_32"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/ai_ctrl_message_icon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_refresh"
            app:tint="@color/zm_on_media" />

        <TextView
            android:id="@+id/ai_ctrl_message_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.Zmt.BodyMedium"
            android:textColor="@color/zm_on_media" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/ai_ctrl_message_action1"
                style="@style/ai_MediaPill"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/ai_ctrl_message_action2"
                style="@style/ai_MediaPill"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="12dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <!-- K06 右侧面板（倍速与清晰度 / 选集） -->
    <ScrollView
        android:id="@+id/ai_ctrl_panel"
        android:layout_width="200dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@drawable/ai_bg_media_panel"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/ai_ctrl_panel_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="16dp"
            android:paddingBottom="16dp" />
    </ScrollView>
</FrameLayout>
