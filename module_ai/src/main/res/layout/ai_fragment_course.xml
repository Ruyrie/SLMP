<?xml version="1.0" encoding="utf-8"?>
<!-- K04 养殖课堂（宿主 AssistantFragment）：搜索栏（点 search 后出现）；下拉刷新；页头（继续观看卡、专题、分类 Chip）+ 两列视频卡网格 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/ai_course_search_bar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginStart="@dimen/base_page_margin"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="@dimen/base_page_margin"
        android:layout_marginBottom="4dp"
        android:background="@drawable/ai_bg_composer_tall"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="8dp"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/ai_course_search_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/ai_back"
            android:src="@drawable/ic_arrow_back"
            app:tint="?attr/colorOnSurfaceVariant" />

        <EditText
            android:id="@+id/ai_course_search_input"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@null"
            android:hint="@string/ai_course_search_hint"
            android:imeOptions="actionSearch"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Zmt.BodyLarge"
            android:textColor="?attr/colorOnSurface"
            android:textColorHint="?attr/colorOnSurfaceVariant" />
    </LinearLayout>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/ai_course_refresh"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <com.zhimu.slmp.base.widget.StateLayout
            android:id="@+id/ai_course_state"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:stateErrorTitle="@string/ai_course_error_title">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/ai_course_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingStart="@dimen/base_page_margin"
                android:paddingEnd="@dimen/base_page_margin"
                android:paddingBottom="24dp" />
        </com.zhimu.slmp.base.widget.StateLayout>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</LinearLayout>
