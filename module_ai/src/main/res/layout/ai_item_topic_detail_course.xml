<?xml version="1.0" encoding="utf-8"?>
<!-- K07 课程行（74dp，分组列表）：80 × 45 缩略图（看过的底部 4dp 进度条）+ 标题 16sp + 状态标签（已学完 / 学到一半 / 未观看）+ 时间 -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.Zmt.Card.ListItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="74dp"
        android:orientation="horizontal"
        android:padding="16dp">

        <FrameLayout
            android:layout_width="80dp"
            android:layout_height="45dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ai_tdc_thumb"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/ai_bg_cover"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Zmt.Corner.Medium" />

            <ProgressBar
                android:id="@+id/ai_tdc_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_gravity="bottom"
                android:max="100"
                android:progressDrawable="@drawable/ai_bg_progress_track"
                android:visibility="gone" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/ai_tdc_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.Zmt.TitleMedium"
                android:textColor="?attr/colorOnSurface" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.zhimu.slmp.base.widget.StatusTagView
                    android:id="@+id/ai_tdc_tag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:tagType="neutral" />

                <TextView
                    android:id="@+id/ai_tdc_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFeatureSettings="tnum"
                    android:textAppearance="@style/TextAppearance.Zmt.BodyMedium"
                    android:textColor="?attr/colorOnSurfaceVariant" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
