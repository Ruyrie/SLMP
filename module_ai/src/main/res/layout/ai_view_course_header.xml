<?xml version="1.0" encoding="utf-8"?>
<!-- K04 页头：继续观看卡（没有在看的视频时隐藏）；“专题”+“全部专题 / 收起”；专题卡（横向滑动 / 展开为纵向）；分类筛选 Chip；网格空状态文字 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/ai_head_continue"
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/ai_bg_card_20"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp"
        android:visibility="gone">

        <FrameLayout
            android:layout_width="128dp"
            android:layout_height="72dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ai_head_continue_cover"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/ai_bg_cover"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Zmt.Corner.Medium" />

            <ProgressBar
                android:id="@+id/ai_head_continue_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_gravity="bottom"
                android:max="100"
                android:progressDrawable="@drawable/ai_bg_progress_track" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ai_course_continue"
                android:textAppearance="@style/TextAppearance.Zmt.BodySmall"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <TextView
                android:id="@+id/ai_head_continue_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.Zmt.TitleSmall"
                android:textColor="?attr/colorOnSurface" />

            <TextView
                android:id="@+id/ai_head_continue_sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFeatureSettings="tnum"
                android:textAppearance="@style/TextAppearance.Zmt.BodySmall"
                android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/ai_head_continue_play"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/base_bg_state_icon_circle"
            android:backgroundTint="?attr/colorSecondaryContainer"
            android:contentDescription="@string/ai_course_play"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_play_arrow_filled"
            app:tint="?attr/colorOnSecondaryContainer" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ai_head_topics_row"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/ai_course_topics"
            android:textAppearance="@style/TextAppearance.Zmt.TitleSmall"
            android:textColor="?attr/colorPrimary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/ai_head_all_topics"
            style="@style/Widget.Zmt.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="@string/ai_course_all_topics" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/ai_head_topics"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:nestedScrollingEnabled="false"
        android:overScrollMode="never" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/ai_head_categories"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:chipSpacingHorizontal="8dp"
            app:selectionRequired="true"
            app:singleLine="true"
            app:singleSelection="true" />
    </HorizontalScrollView>

    <TextView
        android:id="@+id/ai_head_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="48dp"
        android:paddingBottom="48dp"
        android:textAppearance="@style/TextAppearance.Zmt.BodyMedium"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:visibility="gone" />
</LinearLayout>
