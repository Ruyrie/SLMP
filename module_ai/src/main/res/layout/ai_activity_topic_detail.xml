<?xml version="1.0" encoding="utf-8"?>
<!-- K07 专题详情：顶部栏（share）；专题名 28sp、分类标签 + “共 6 节 · 约 22 分钟 · 平台知识库”、简介、学习进度卡、课程列表（分组列表）；
     底部固定操作栏 80dp：填充按钮“继续学习 / 开始学习 / 开始复习” -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:orientation="vertical">

    <include
        android:id="@+id/ai_topic_top_bar"
        layout="@layout/base_include_top_app_bar" />

    <com.zhimu.slmp.base.widget.StateLayout
        android:id="@+id/ai_topic_state"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        app:stateEmptyIcon="@drawable/ic_smart_display"
        app:stateEmptyTitle="@string/ai_topic_offline"
        app:stateErrorTitle="@string/ai_topic_error_title"
        app:stateSkeletonLayout="@layout/base_skeleton_detail">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/ai_topic_scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/base_page_margin"
                android:paddingTop="8dp"
                android:paddingEnd="@dimen/base_page_margin"
                android:paddingBottom="24dp">

                <TextView
                    android:id="@+id/ai_topic_name_big"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Zmt.HeadlineMedium"
                    android:textColor="?attr/colorOnSurface" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.zhimu.slmp.base.widget.StatusTagView
                        android:id="@+id/ai_topic_category"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:tagType="neutral" />

                    <TextView
                        android:id="@+id/ai_topic_meta_text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:textAppearance="@style/TextAppearance.Zmt.BodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant" />
                </LinearLayout>

                <TextView
                    android:id="@+id/ai_topic_intro"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:lineSpacingExtra="4sp"
                    android:textAppearance="@style/TextAppearance.Zmt.BodyMedium"
                    android:textColor="?attr/colorOnSurface" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/ai_bg_card_20"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/ai_topic_progress"
                            android:textAppearance="@style/TextAppearance.Zmt.TitleSmall"
                            android:textColor="?attr/colorOnSurface" />

                        <TextView
                            android:id="@+id/ai_topic_progress_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.Zmt.BodyMedium"
                            android:textColor="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/ai_topic_progress_bar"
                        style="@style/Widget.Zmt.LinearProgressIndicator"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:max="100"
                        app:trackCornerRadius="2dp"
                        app:trackThickness="4dp" />

                    <TextView
                        android:id="@+id/ai_topic_resume"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textAppearance="@style/TextAppearance.Zmt.BodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant" />
                </LinearLayout>

                <TextView
                    android:id="@+id/ai_topic_list_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="17dp"
                    android:layout_marginBottom="8dp"
                    android:textAppearance="@style/TextAppearance.Zmt.TitleSmall"
                    android:textColor="?attr/colorPrimary" />

                <com.zhimu.slmp.base.widget.GroupedListLayout
                    android:id="@+id/ai_topic_courses"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </com.zhimu.slmp.base.widget.StateLayout>

    <LinearLayout
        android:id="@+id/ai_topic_bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/base_bg_bottom_action_bar"
        android:orientation="vertical"
        android:paddingStart="@dimen/base_page_margin"
        android:paddingTop="12dp"
        android:paddingEnd="@dimen/base_page_margin"
        android:paddingBottom="12dp"
        android:tag="snackbar_anchor">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/ai_topic_action"
            style="@style/Widget.Zmt.Button.Large"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:icon="@drawable/ic_play_arrow_filled" />
    </LinearLayout>
</LinearLayout>
