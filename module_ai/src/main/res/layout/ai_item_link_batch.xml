<?xml version="1.0" encoding="utf-8"?>
<!-- 关联批次面板单选项：64dp，左右内边距 24dp；单选按钮 20dp + 主文字“ZM2610-031 · 杜长大育肥猪”+ 副文字“3 号育肥舍 · 96 日龄 · 存栏 200 头”；
     当前已关联项右侧“当前”标签 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="64dp"
    android:orientation="horizontal"
    android:paddingStart="@dimen/base_sheet_padding_horizontal"
    android:paddingEnd="@dimen/base_sheet_padding_horizontal">

    <com.google.android.material.radiobutton.MaterialRadioButton
        android:id="@+id/ai_link_radio"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:clickable="false"
        android:focusable="false"
        android:minWidth="0dp"
        android:minHeight="0dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/ai_link_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Zmt.TitleMedium"
            android:textColor="?attr/colorOnSurface" />

        <TextView
            android:id="@+id/ai_link_sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Zmt.BodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant" />
    </LinearLayout>

    <com.zhimu.slmp.base.widget.StatusTagView
        android:id="@+id/ai_link_current"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ai_link_current"
        android:visibility="gone"
        app:tagType="primary" />
</LinearLayout>
