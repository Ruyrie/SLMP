<?xml version="1.0" encoding="utf-8"?>
<!-- K01 提问：右对齐，附图 64dp 缩略图排在气泡上方（间距 8dp），气泡最大宽 312dp、左侧至少留 84dp -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="end"
    android:orientation="vertical"
    android:paddingStart="84dp"
    android:paddingTop="8dp"
    android:paddingEnd="@dimen/base_page_margin">

    <com.zhimu.slmp.ai.ui.chat.ThumbFlowLayout
        android:id="@+id/ai_question_images"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/ai_question_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/ai_bg_question"
        android:lineSpacingExtra="4sp"
        android:maxWidth="312dp"
        android:minHeight="48dp"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp"
        android:textAppearance="@style/TextAppearance.Zmt.BodyLarge"
        android:textColor="?attr/colorOnSurface"
        android:textIsSelectable="true"
        tools:text="氟苯尼考粉用于猪，多久可以出栏？" />
</LinearLayout>
