<?xml version="1.0" encoding="utf-8"?>
<!-- 关联批次 Chip、来源 Chip：1dp outline、圆角 8dp、透明底，按下水波纹 -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="?attr/colorControlHighlight">
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="?attr/colorOutline" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</ripple>
