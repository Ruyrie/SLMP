<?xml version="1.0" encoding="utf-8"?>
<!-- 播放进度条：已播放 on-media、已缓冲白 60%、未缓冲白 30%，高 4dp -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background" android:gravity="center_vertical" android:height="4dp">
        <shape android:shape="rectangle">
            <solid android:color="#4DFFFFFF" />
            <corners android:radius="2dp" />
        </shape>
    </item>
    <item android:id="@android:id/secondaryProgress" android:gravity="center_vertical" android:height="4dp">
        <clip>
            <shape android:shape="rectangle">
                <solid android:color="#99FFFFFF" />
                <corners android:radius="2dp" />
            </shape>
        </clip>
    </item>
    <item android:id="@android:id/progress" android:gravity="center_vertical" android:height="4dp">
        <clip>
            <shape android:shape="rectangle">
                <solid android:color="@color/zm_on_media" />
                <corners android:radius="2dp" />
            </shape>
        </clip>
    </item>
</layer-list>
