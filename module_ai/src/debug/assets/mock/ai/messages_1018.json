        "asked_at": "2026-10-18 08:40:00",
        "question_text": "怎么判断是不是饲料霉变？",
        "images": null,
        "batch_id": 3001,
        "batch_no": "ZM2610-031",
        "context_course_title": null,
        "status": "ANSWERED",
        "answer_type": "NORMAL",
        "answer_text": "看颜色是否发暗结块、闻是否有霉味，抓一把看有没有发热。可疑时停用该批饲料并留样。",
        "citations": [],
        "rating": null,
        "rated_at": null,
        "can_rate": true,
        "can_copy": true,
        "in_context": false,
        "correction": null,
        "error_code": null,
